---
interface Card {
  title: string;
  body: string;
}

interface Props {
  sectionLabel: string;
  heading: string;
  subhead: string;
  cards: Card[];
}

const { sectionLabel, heading, subhead, cards } = Astro.props;
const cardCount = cards.length;
---

<section class="section">
  <div class="section-inner">
    <div class="problem-header fade-up">
      <p class="section-label">{sectionLabel}</p>
      <h2 set:html={heading} />
      <p class="problem-subhead">{subhead}</p>
    </div>
    <div class={`problem-grid fade-up cols-${cardCount}`}>
      {cards.map((card, i) => (
        <div class="problem-card">
          <div class="problem-number">{i + 1}</div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .problem-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .problem-header .section-label {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--orange);
    margin-bottom: 12px;
    text-align: center;
    display: block;
  }

  .problem-header .section-label::before {
    display: none;
  }

  .problem-header h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.3;
    text-wrap: balance;
    margin-bottom: 16px;
  }

  .problem-subhead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  .problem-grid {
    display: grid;
    gap: 24px;
  }

  .problem-grid.cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .problem-grid.cols-4 {
    grid-template-columns: repeat(2, 1fr);
    max-width: 900px;
    margin: 0 auto;
  }

  .problem-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 32px 24px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .problem-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .problem-number {
    width: 40px;
    height: 40px;
    background: rgba(244, 128, 33, 0.1);
    color: var(--orange);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 16px;
  }

  .problem-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .problem-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  @media (max-width: 768px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }

    .problem-header h2 {
      font-size: 26px;
    }
  }
</style>
