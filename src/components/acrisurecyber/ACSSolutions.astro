---
const categories = [
  {
    title: 'Managed IT Services',
    desc: 'Reliable, fully-managed technology operations — from helpdesk to strategic advisory.',
    items: [
      'Co-Managed IT',
      'Fully Managed IT Support',
      'Microsoft 365 Services',
      'Staff Augmentation',
      'Strategic IT & Advisory Services',
    ],
  },
  {
    title: 'Cybersecurity Services',
    desc: 'Multi-layered defense built around your business and threat profile.',
    items: [
      'Endpoint Detection & Response',
      'Advanced AI Email Security',
      'Multi-Factor Authentication',
      'Vulnerability Management',
      'SIEM',
      'Security Awareness Training',
      'Penetration Testing',
      'Threat & Exposure Management',
      'Managed Detection & Response',
    ],
  },
  {
    title: 'Risk Advisory',
    desc: 'Translate cyber risk into business decisions your leadership can act on.',
    items: [
      'Governance, Risk & Compliance Advisory',
      'Cyber Risk Advisory for Boards',
      'GRC Platform (TruOps)',
      'Cybersecurity Awareness Workshops',
    ],
  },
  {
    title: 'Cloud & Infrastructure',
    desc: 'Modern, secure, and resilient cloud and network foundations.',
    items: [
      'Cloud Assessment',
      'Cloud Services',
      'Advanced Infrastructure Solutions',
      'Managed Network Services',
      'Hosted Infrastructure (Private Cloud)',
    ],
  },
  {
    title: 'Business Continuity & DR',
    desc: 'Be ready for the worst day — and recover from it within minutes.',
    items: [
      'Data Backup & Recovery',
      'Disaster Recovery (Hot-Site)',
      'Business Continuity Assessment & Planning',
    ],
  },
  {
    title: 'Additional Services',
    desc: 'Specialized capabilities to extend your team and accelerate transformation.',
    items: [
      'AI-Powered Services',
      'Communication Services',
      'Data Services',
      'Digital Workplace & Agile Transformation',
    ],
  },
];
---

<section class="acs-solutions" id="solutions">
  <div class="solutions-inner">
    <div class="section-head">
      <span class="eyebrow">Solutions</span>
      <h2>Everything you need across IT, security, and risk &mdash; under one roof.</h2>
      <p>One partner, one accountable team, one streamlined cost. We tailor the stack to where you are and where you're going.</p>
    </div>

    <div class="solutions-grid">
      {categories.map((cat) => (
        <article class="solution-card">
          <div class="solution-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <h3>{cat.title}</h3>
          <p>{cat.desc}</p>
          <ul>
            {cat.items.map((item) => <li>{item}</li>)}
          </ul>
          <a href="#contact" class="solution-link">
            Learn more
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .acs-solutions {
    background: #ffffff;
    padding: 100px 32px;
  }

  .solutions-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #0066cc;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .section-head h2 {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1px;
    color: #0a0a0a;
    margin: 0 0 16px;
  }

  .section-head p {
    font-size: 18px;
    color: #4a5563;
    line-height: 1.6;
    margin: 0;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .solution-card {
    background: #ffffff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 32px 28px;
    transition: all 0.25s;
  }

  .solution-card:hover {
    border-color: #0a0a0a;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
  }

  .solution-icon {
    width: 44px;
    height: 44px;
    background: #0a0a0a;
    color: #fff;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .solution-card h3 {
    font-size: 20px;
    font-weight: 700;
    color: #0a0a0a;
    margin: 0 0 8px;
  }

  .solution-card > p {
    font-size: 14px;
    color: #6b7280;
    line-height: 1.55;
    margin: 0 0 18px;
  }

  .solution-card ul {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
  }

  .solution-card ul li {
    font-size: 14px;
    color: #1f2937;
    padding: 6px 0 6px 22px;
    position: relative;
    line-height: 1.5;
  }

  .solution-card ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 13px;
    width: 14px;
    height: 2px;
    background: #0066cc;
  }

  .solution-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #0066cc;
    text-decoration: none;
    transition: gap 0.2s;
  }

  .solution-link:hover {
    gap: 10px;
  }

  @media (max-width: 960px) {
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .acs-solutions {
      padding: 72px 24px;
    }
    .section-head h2 {
      font-size: 30px;
    }
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
