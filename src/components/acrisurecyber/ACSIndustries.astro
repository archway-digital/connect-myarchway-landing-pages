---
const industries = [
  { name: 'Healthcare & Life Sciences', icon: 'M12 2l1.5 4.5h4.5l-3.75 2.75L15.75 14 12 11.25 8.25 14l1.5-4.75L6 6.5h4.5z' },
  { name: 'Manufacturing & Logistics', icon: 'M3 21h18M5 21V7l8-4 8 4v14M9 9h2v2H9zm0 4h2v2H9zm4-4h2v2h-2zm0 4h2v2h-2z' },
  { name: 'Construction & Real Estate', icon: 'M3 21h18M3 7h18M5 21V7m14 14V7M9 11h6v4H9z' },
  { name: 'Professional & Financial Services', icon: 'M21 7H3v10h18zM3 11h18M7 15h2' },
  { name: 'Retail, Hospitality & Recreation', icon: 'M3 9l1-5h16l1 5M3 9v11h18V9M3 9h18M9 13h6' },
  { name: 'Public Sector & Education', icon: 'M3 9l9-5 9 5-9 5zM5 11v6l7 3 7-3v-6' },
  { name: 'Technology & Software', icon: 'M8 18l-6-6 6-6m8 12l6-6-6-6M14 4l-4 16' },
  { name: 'Energy, Utilities & Infrastructure', icon: 'M13 2L3 14h7v8l10-12h-7z' },
  { name: 'Private Equity & Venture Capital', icon: 'M3 17l6-6 4 4 8-8M14 7h7v7' },
];
---

<section class="acs-industries" id="industries">
  <div class="ind-inner">
    <div class="section-head">
      <span class="eyebrow">Industries</span>
      <h2>Deep expertise across the industries that depend on us most.</h2>
      <p>Twenty years of regulated, complex environments &mdash; from clinical settings to manufacturing floors to PE portfolios.</p>
    </div>

    <div class="ind-grid">
      {industries.map((ind) => (
        <div class="ind-card">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d={ind.icon} />
          </svg>
          <span>{ind.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .acs-industries {
    background: #f7f8fa;
    padding: 100px 32px;
  }

  .ind-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #0066cc;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .section-head h2 {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1px;
    color: #0a0a0a;
    margin: 0 0 16px;
  }

  .section-head p {
    font-size: 18px;
    color: #4a5563;
    line-height: 1.6;
    margin: 0;
  }

  .ind-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .ind-card {
    background: #ffffff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 24px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: #0a0a0a;
    transition: all 0.2s;
  }

  .ind-card:hover {
    border-color: #0066cc;
    color: #0066cc;
    transform: translateY(-1px);
  }

  .ind-card svg {
    flex-shrink: 0;
    color: #0066cc;
  }

  .ind-card span {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .ind-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .acs-industries {
      padding: 72px 24px;
    }
    .section-head h2 {
      font-size: 30px;
    }
  }

  @media (max-width: 480px) {
    .ind-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
