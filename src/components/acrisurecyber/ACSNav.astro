<nav class="acs-nav">
  <div class="acs-nav-inner">
    <a href="/acrisurecyber" class="acs-logo">
      <span class="logo-mark">ACS</span>
      <span class="logo-text">Acrisure <em>Cyber Services</em></span>
    </a>

    <ul class="acs-menu">
      <li><a href="#">Home</a></li>
      <li class="has-submenu">
        <a href="#">About <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></a>
        <ul class="submenu">
          <li><a href="#">Our Team</a></li>
          <li><a href="#">Career</a></li>
        </ul>
      </li>
      <li><a href="#solutions">Solutions</a></li>
      <li><a href="#industries">Industries</a></li>
      <li><a href="#contact">Contact</a></li>
      <li><a href="#resources">Resources</a></li>
    </ul>

    <a href="#contact" class="acs-nav-cta">Get Started</a>

    <button class="acs-burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .acs-nav {
    background: #ffffff;
    border-bottom: 1px solid #ececec;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .acs-nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .acs-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #0a0a0a;
    font-weight: 700;
  }

  .logo-mark {
    background: #0a0a0a;
    color: #fff;
    padding: 8px 10px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 4px;
  }

  .logo-text {
    font-size: 16px;
    line-height: 1.1;
    color: #0a0a0a;
  }

  .logo-text em {
    display: block;
    font-style: normal;
    font-size: 11px;
    color: #6b7280;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .acs-menu {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .acs-menu > li {
    position: relative;
  }

  .acs-menu a {
    color: #0a0a0a;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding: 8px 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }

  .acs-menu a:hover {
    color: #0066cc;
  }

  .submenu {
    position: absolute;
    top: 100%;
    left: -16px;
    list-style: none;
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 8px;
    padding: 8px 0;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }

  .has-submenu:hover .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .submenu li a {
    display: block;
    padding: 10px 20px;
    font-size: 14px;
  }

  .acs-nav-cta {
    background: #0a0a0a;
    color: #fff;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .acs-nav-cta:hover {
    background: #0066cc;
  }

  .acs-burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .acs-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #0a0a0a;
  }

  @media (max-width: 960px) {
    .acs-menu, .acs-nav-cta {
      display: none;
    }
    .acs-burger {
      display: flex;
    }
  }
</style>
