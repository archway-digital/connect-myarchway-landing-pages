<section class="acs-stats">
  <div class="stats-inner">
    <div class="stat">
      <span class="stat-num">250+</span>
      <span class="stat-label">IT &amp; Cybersecurity Professionals</span>
    </div>
    <div class="stat">
      <span class="stat-num">20+</span>
      <span class="stat-label">Years of Award-Winning Service</span>
    </div>
    <div class="stat">
      <span class="stat-num">96%</span>
      <span class="stat-label">CSAT Score &mdash; 4.9/5 from 150+ Businesses</span>
    </div>
    <div class="stat">
      <span class="stat-num">24/7/365</span>
      <span class="stat-label">Always-On Support &amp; Monitoring</span>
    </div>
  </div>
</section>

<style>
  .acs-stats {
    background: #f7f8fa;
    padding: 64px 32px;
    border-top: 1px solid #ececec;
    border-bottom: 1px solid #ececec;
  }

  .stats-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .stat {
    text-align: center;
  }

  .stat-num {
    display: block;
    font-size: 44px;
    font-weight: 800;
    color: #0a0a0a;
    letter-spacing: -1px;
    line-height: 1;
    margin-bottom: 10px;
  }

  .stat-label {
    font-size: 14px;
    color: #4a5563;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 16px;
    }
    .stat-num {
      font-size: 34px;
    }
  }
</style>
