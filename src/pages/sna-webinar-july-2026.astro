---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';

const specialists = [
  {
    id: 'brad',
    name: 'Brad Ruben',
    focus: 'IT & Security',
    eyebrow: 'IT & Security',
    blurb:
      'Security posture, MFA enforcement, backup and recovery, incident response, and alignment with carrier cyber standards. Book time to find the gaps before they find you.',
    embed: 'https://meetings-na2.hubspot.com/brad-ruben/website-forms-discovery-call?embed=true',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  },
  {
    id: 'sam',
    name: 'Sam Ruben',
    focus: 'AI & Automation',
    eyebrow: 'AI',
    blurb:
      'Where staff time is going that could be automated, which workflows are still manual, and what a realistic AI starting point looks like for an agency your size.',
    embed: 'https://meetings-na2.hubspot.com/sam-ruben/website-forms-discovery-call?embed=true',
    icon: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 14.5l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9z"/>',
  },
  {
    id: 'hannah',
    name: 'Hannah Ruben',
    focus: 'Digital Marketing',
    eyebrow: 'Marketing',
    blurb:
      'Website performance, local search visibility, Google Business Profile, and whether your digital presence is helping or hurting when a prospect searches for an agency in your area.',
    embed: 'https://meetings-na2.hubspot.com/hannah-ruben/website-forms-discovery-call?embed=true',
    icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  },
];
---

<ArchwayLayout
  title="Talk to a Specialist | Archway"
  description="Book time directly with an Archway specialist. Brad for IT and security, Sam for AI and automation, Hannah for digital marketing. Pick the conversation your agency needs and grab a time."
  ctaText="Book a Meeting"
  ctaHref="#book"
>
  <!-- Hero -->
  <section class="hero specialist-hero">
    <div class="specialist-hero-inner">
      <div class="hero-text">
        <div class="hero-badge">Book a Conversation</div>
        <h1>Talk to the Archway Specialist Who Handles <span class="hl">Your Question.</span></h1>
        <p class="hero-sub">Three areas. Three specialists. Pick the conversation your agency needs most and grab a time that works. No pitch, no pressure, just an honest look at where you stand.</p>
      </div>

      <div class="specialist-cards" id="book">
        {specialists.map((s) => (
          <a href={`#meet-${s.id}`} class="specialist-card">
            <div class="specialist-icon">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </div>
            <p class="specialist-eyebrow">{s.eyebrow}</p>
            <p class="specialist-name">{s.name}</p>
            <p class="specialist-blurb">{s.blurb}</p>
            <span class="specialist-cta">
              Book with {s.name.split(' ')[0]}
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <StatsBar />

  <!-- Meeting embeds -->
  {specialists.map((s, i) => (
    <section class={`section meeting-section ${i % 2 === 1 ? 'section-light' : ''}`} id={`meet-${s.id}`}>
      <div class="meeting-inner">
        <div class="meeting-head fade-up">
          <p class="section-label">{s.focus}</p>
          <h2>Book Time with {s.name}</h2>
          <p class="meeting-sub">{s.blurb}</p>
        </div>
        <div class="meeting-embed-wrap fade-up">
          <div class="meetings-iframe-container" data-src={s.embed}></div>
        </div>
      </div>
    </section>
  ))}

  <!-- HubSpot Meetings embed loader (initializes every .meetings-iframe-container on the page) -->
  <script is:inline type="text/javascript" src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"></script>

  <Testimonials />

  <BottomCTA
    heading="Not Sure Which Conversation You Need?"
    subtext="Start with any of the three. Whoever you meet with can point you to the right person if your question crosses into another area."
    ctaText="Choose a Specialist"
    ctaHref="#book"
  />
</ArchwayLayout>

<style>
  .section-label {
    display: inline-flex;
    color: var(--orange);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }

  /* Hero layout — centered header + subhead, three specialist cards below */
  .specialist-hero-inner {
    max-width: 1080px;
    margin: 0 auto;
    position: relative;
    text-align: center;
  }

  .specialist-hero .hero-text {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .specialist-hero .hero-sub {
    margin-left: auto;
    margin-right: auto;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .specialist-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 44px;
    text-align: left;
  }

  .specialist-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 22px 24px;
    text-decoration: none;
    color: var(--text);
    box-shadow: 0 12px 36px -14px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    position: relative;
  }

  .specialist-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 44px -14px rgba(0, 0, 0, 0.5);
    border-color: rgba(244, 128, 33, 0.5);
  }

  .specialist-icon {
    width: 48px;
    height: 48px;
    background: rgba(244, 128, 33, 0.1);
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .specialist-eyebrow {
    font-size: 11px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 4px;
  }

  .specialist-name {
    font-size: 19px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .specialist-blurb {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .specialist-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 15px;
    font-weight: 700;
    color: var(--orange);
  }

  .specialist-card:hover .specialist-cta {
    gap: 11px;
  }

  .specialist-cta {
    transition: gap 0.2s;
  }

  /* Meeting embed sections */
  .meeting-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .meeting-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 32px;
  }

  .meeting-head h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.25;
    margin-bottom: 14px;
    letter-spacing: -0.5px;
  }

  .meeting-sub {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-light);
    margin: 0;
    text-wrap: pretty;
  }

  .meeting-embed-wrap {
    background: var(--white);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 12px;
    box-shadow: var(--card-shadow);
  }

  .meetings-iframe-container {
    min-height: 680px;
    width: 100%;
  }

  .meetings-iframe-container iframe {
    width: 100% !important;
    min-height: 680px;
  }

  @media (max-width: 860px) {
    .specialist-cards {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .meeting-head h2 {
      font-size: 26px;
    }
    .meetings-iframe-container,
    .meetings-iframe-container iframe {
      min-height: 620px;
    }
  }
</style>
