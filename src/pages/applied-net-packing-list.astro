---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';

// Gated lead magnet. The asset is the one-page field kit PDF in /public.
//
// Its own HubSpot form, supplied by Kevin on 2026-09-11, so Applied Net download
// conversions report separately from the other lead magnets.
//
// The form must REDIRECT to /applied-net-packing-list/thank-you on submit. That
// is the only thing that hands over the PDF; without it a submission collects
// the email and delivers nothing.
const FORM_ID = '73b6b1d8-3f67-469b-abb1-d0afa036682b';

const ASSET_HREF = '/applied-net-2026-field-kit.pdf';
const FALLBACK_MAILTO = 'mailto:info@myarchway.com?subject=Applied%20Net%202026%20field%20kit';
---

<ArchwayLayout
  title="The Applied Net 2026 Field Kit | Archway Computer"
  description="A one-page checklist for Applied Net 2026 at the Gaylord National. Twenty-one things ten years of going has taught us, in five sections. Free PDF."
  ctaText="Get the Field Kit"
  ctaHref="#hero-form"
>
  <section class="hero dossier-hero">
    <div class="redaction-stack" aria-hidden="true">
      <span class="bar"></span>
      <span class="bar accent"></span>
      <span class="bar"></span>
    </div>

    <div class="hero-inner">
      <div class="hero-text">
        <div class="file-tag mono">ARCHWAY // FILE DIVISION &middot; FILE NO. AWX-2026-KIT</div>
        <div class="halftone-strip" aria-hidden="true"></div>
        <div class="hero-badge">APPLIED NET 2026 &middot; FIELD KIT</div>
        <h1>Twenty-one things ten years of Applied Net has <span class="hl">taught us</span>.</h1>
        <p class="hero-sub">One page. Five sections. Print it, or keep it on your phone for the week.</p>
        <p class="hero-intro">Everything on it is there because at some point one of us did not do it and regretted it. That is a more reliable source than a conference article written by somebody who has never been.</p>
        <p class="hero-trust">Archway works exclusively with independent insurance agencies.</p>
      </div>

      <div class="hero-form-card" id="hero-form">
        <div class="form-tab mono">CASE FILE: RELEASE</div>
        <div class="form-header">
          <h2>Get the field kit</h2>
          <p>Tell us where to send it and the PDF opens on the next page.</p>
        </div>

        <div id="hs-applied-net-form"></div>

        <noscript>
          <div class="form-offline">
            <p class="form-offline-title">The form needs JavaScript.</p>
            <p>You can <a href={ASSET_HREF}>download the field kit directly</a>, or email <a href={FALLBACK_MAILTO}>info@myarchway.com</a> and we will send it over.</p>
          </div>
        </noscript>

        <div class="form-offline" id="form-offline" hidden>
          <p class="form-offline-title">The form did not load.</p>
          <p>An ad blocker or privacy extension is the usual reason. You can <a href={ASSET_HREF}>download the field kit directly</a>, or email <a href={FALLBACK_MAILTO}>info@myarchway.com</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline define:vars={{ FORM_ID }}>
    function _createAppliedNetForm() {
      if (!window.hbspt || !window.hbspt.forms) {
        setTimeout(_createAppliedNetForm, 80);
        return;
      }
      window.hbspt.forms.create({
        portalId: "6869933",
        formId: FORM_ID,
        region: "na2",
        target: "#hs-applied-net-form",
        css: "\
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\
          .hs-form { font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .hs-form fieldset { max-width: 100% !important; }\
          .hs-form fieldset.form-columns-2 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-2 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form fieldset.form-columns-3 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-3 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form-field { margin-bottom: 16px; }\
          .hs-form-field > label { display: block; font-size: 15px; font-weight: 600; color: #333333; margin-bottom: 8px; }\
          .hs-form-required { color: #b91c1c; margin-left: 2px; }\
          .hs-input { width: 100% !important; padding: 14px 16px !important; background: #ffffff !important; border: 1px solid #d1d5db !important; border-radius: 8px !important; color: #333333 !important; font-size: 16px !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s, box-shadow 0.2s; }\
          .hs-input:focus { border-color: #f48021 !important; box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.25) !important; }\
          .hs-input::placeholder { color: #9ca3af; }\
          .hs-form-field textarea.hs-input { min-height: 88px; resize: vertical; }\
          .hs-form-field select.hs-input { appearance: auto; }\
          .hs-form-booleancheckbox-display, .hs-form-radio-display { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 8px; }\
          .hs-form-radio-display input[type='radio'], .hs-form-booleancheckbox-display input[type='checkbox'] { width: auto !important; margin: 3px 0 0 !important; accent-color: #f48021; }\
          .hs-form-radio-display span, .hs-form-booleancheckbox-display span { font-size: 15px; color: #333333; font-weight: 500; }\
          .inputs-list { list-style: none; padding: 0; margin: 0; }\
          .hs-submit { margin-top: 8px; }\
          .hs-button { width: 100% !important; padding: 16px !important; background: #f48021 !important; color: #32373c !important; font-size: 16px !important; font-weight: 700 !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; border: none !important; border-radius: 8px !important; cursor: pointer; transition: all 0.2s; min-height: 44px; }\
          .hs-button:hover { background: #ff9440 !important; }\
          .hs-error-msgs { list-style: none; padding: 0; margin: 4px 0 0; }\
          .hs-error-msgs li label { font-size: 13px !important; color: #ef4444 !important; font-weight: 500 !important; }\
          .hs-input.error { border-color: #ef4444 !important; }\
          .submitted-message { text-align: center; padding: 30px 10px; font-size: 16px; line-height: 1.55; color: #333333; font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .legal-consent-container { font-size: 13px; color: #5a5f66; line-height: 1.5; margin-top: 8px; }\
          .legal-consent-container a { color: #a84e08; }\
          @media (max-width: 480px) { .hs-form fieldset.form-columns-2, .hs-form fieldset.form-columns-3 { flex-direction: column; gap: 0; } }\
        "
      });
    }
    _createAppliedNetForm();

    // If the embed target is still empty after 5s, HubSpot is blocked or down.
    // Reveal the manual booking path rather than leaving an empty card.
    setTimeout(function () {
      var target = document.getElementById("hs-applied-net-form");
      var offline = document.getElementById("form-offline");
      if (target && offline && target.children.length === 0) {
        offline.hidden = false;
      }
    }, 5000);
  </script>

  <!-- What is on it -->
  <section class="section section-light">
    <div class="section-inner inside-inner">
      <p class="section-label">Contents</p>
      <h2>What is on the page</h2>

      <div class="manifest-wrap">
        <div class="manifest-tab mono">EXHIBIT: FIELD KIT MANIFEST</div>
        <div class="manifest-panel">
          <div class="inside-row">
            <span class="inside-tag mono">8 items</span>
            <div>
              <h3>PACK AND PREP</h3>
              <p>What goes in the bag, including the two nobody packs and regrets.</p>
            </div>
          </div>
          <div class="inside-row">
            <span class="inside-tag mono">3 items</span>
            <div>
              <h3>PLAN AHEAD</h3>
              <p>What to settle before you fly, while it is still cheap to change.</p>
            </div>
          </div>
          <div class="inside-row">
            <span class="inside-tag mono">3 items</span>
            <div>
              <h3>NETWORKING PREP</h3>
              <p>The twenty seconds and the three goals that make the week count.</p>
            </div>
          </div>
          <div class="inside-row">
            <span class="inside-tag mono">4 items</span>
            <div>
              <h3>ON SITE AT THE GAYLORD</h3>
              <p>The walk, the noise, the meal lines, and the evening rush for rides.</p>
            </div>
          </div>
          <div class="inside-row">
            <span class="inside-tag mono">3 items</span>
            <div>
              <h3>LEARNING STRATEGY</h3>
              <p>How to leave with something your team can actually use.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Archway -->
  <section class="section">
    <div class="section-inner about-inner">
      <div class="about-stamp" aria-hidden="true"><span class="mono">ON<br />FILE</span></div>
      <p class="section-label">About Archway</p>
      <h2>We work with one kind of business, and only that kind.</h2>
      <p class="about-lede">Archway Computer is a technology partner for independent insurance agencies. Not general small business. Not healthcare. Insurance agencies, and nothing else, which is why we can name your AMS in the first sentence instead of the fifth.</p>

      <div class="pillar-grid">
        <div class="pillar">
          <h3>IT and cybersecurity</h3>
          <p>Carrier cyber questionnaires and NYDFS documentation, security posture reviews and penetration testing, managed IT, and hosted Applied Epic and AMS360 migrations.</p>
        </div>
        <div class="pillar">
          <h3>AI and automation</h3>
          <p>Workflow automation inside the AMS you already run. Commission reconciliation, document generation, and the manual steps that quietly consume a staff week every month.</p>
        </div>
        <div class="pillar">
          <h3>Digital marketing</h3>
          <p>Agency websites built to convert rather than to exist, local SEO, and review strategy. Marketing as a real practice area, not something bolted onto an IT contract.</p>
        </div>
      </div>

      <p class="about-close">We are at <strong>booth 131</strong> at Applied Net 2026, September 28 to October 1 at the Gaylord National. <a href="/applied-net-2026">Book twenty minutes</a> and we will send you a $100 Visa gift card for the time. First 50 meetings booked. Not booking? Stop by anyway and enter to win a Lenovo ThinkPad X1 2-in-1 Gen 11. Thirty seconds, no meeting required.</p>
    </div>
  </section>
</ArchwayLayout>

<style>
  .mono {
    font-family: 'Courier Prime', 'Courier New', monospace;
  }

  /* ── Hero ── */
  .dossier-hero {
    position: relative;
    overflow: hidden;
  }

  .redaction-stack {
    position: absolute;
    top: 56px;
    right: 64px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0.9;
  }

  .redaction-stack .bar {
    height: 14px;
    background: #1a1a1a;
    border-radius: 2px;
  }

  .redaction-stack .bar:nth-child(1) { width: 220px; }
  .redaction-stack .bar:nth-child(2) { width: 150px; }
  .redaction-stack .bar:nth-child(3) { width: 190px; }
  .redaction-stack .bar.accent { border-bottom: 2px solid var(--orange); }

  .file-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 10px;
  }

  .halftone-strip {
    height: 26px;
    max-width: 320px;
    margin-bottom: 20px;
    border-radius: 3px;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .hero-intro {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 20px;
    max-width: 56ch;
  }

  .hero-trust {
    font-size: 14px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .hero-form-card {
    position: relative;
  }

  .form-tab {
    position: absolute;
    top: -14px;
    left: 24px;
    background: #b89f70;
    color: var(--charcoal);
    font-size: 10px;
    letter-spacing: 1px;
    padding: 5px 12px 3px;
    border-radius: 3px 3px 0 0;
  }

  .form-offline {
    padding: 20px;
    background: var(--light-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .form-offline[hidden] { display: none; }
  .form-offline p { font-size: 15px; line-height: 1.6; color: var(--text-light); margin: 0; }
  .form-offline-title { font-weight: 700; color: var(--charcoal) !important; margin-bottom: 6px !important; }
  .form-offline a { color: var(--orange-text); text-decoration: underline; }

  /* ── Contents ── */
  .inside-inner {
    max-width: 860px;
  }

  .manifest-wrap {
    margin-top: 8px;
  }

  .manifest-tab {
    display: inline-block;
    background: #d9c7a0;
    border-radius: 4px 4px 0 0;
    padding: 10px 24px;
    margin-left: 24px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--charcoal);
  }

  .manifest-panel {
    background: #d9c7a0;
    border: 1px solid #b89f70;
    border-radius: 0 12px 12px 12px;
    padding: 14px 32px 22px;
  }

  .inside-row {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 18px;
    align-items: start;
    padding: 16px 0;
    border-bottom: 1px solid rgba(90, 75, 48, 0.22);
  }

  .inside-row:last-child {
    border-bottom: none;
  }

  .inside-tag {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #5a4b30;
    border: 1px solid #b89f70;
    border-radius: 3px;
    padding: 4px 8px;
    text-align: center;
    white-space: nowrap;
  }

  .inside-row h3 {
    font-size: 17px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 4px;
  }

  .inside-row p {
    font-size: 15px;
    line-height: 1.6;
    color: #5a4b30;
    margin: 0;
  }

  /* ── About ── */
  .about-inner {
    position: relative;
    max-width: 900px;
  }

  .about-stamp {
    position: absolute;
    top: -6px;
    right: 0;
    width: 84px;
    height: 84px;
    border: 3px solid var(--navy);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-7deg);
  }

  .about-stamp .mono {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1.35;
    color: var(--navy);
    text-align: center;
  }

  .about-lede {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text);
    max-width: 68ch;
    margin-bottom: 32px;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .pillar {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-top: 3px solid var(--orange);
    border-radius: 10px;
    padding: 22px 22px 24px;
  }

  .pillar h3 {
    font-size: 17px;
    font-weight: 800;
    color: var(--charcoal);
    margin: 0 0 8px;
  }

  .pillar p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-light);
    margin: 0;
  }

  .about-close {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
    margin: 0;
  }

  .about-close a {
    color: var(--orange-text);
    font-weight: 700;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .redaction-stack {
      display: none;
    }

    .about-stamp {
      position: static;
      margin-bottom: 18px;
    }

    .inside-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .inside-tag {
      justify-self: start;
    }
  }
</style>
