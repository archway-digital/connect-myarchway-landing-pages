---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroLeadMagnet from '../components/shared/HeroLeadMagnet.astro';
import ProblemCardsThree from '../components/shared/ProblemCardsThree.astro';
import NumberedCardsList from '../components/shared/NumberedCardsList.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Security Posture Mid-Year Guide for Insurance Agencies | Archway"
  description="Download the free guide and find out where your agency’s security posture stands at the halfway point of 2026, and what to fix before renewal season."
  ctaText="Get the Free Guide"
  ctaHref="#hero-form"
>
  <HeroLeadMagnet
    badge="Security Posture  ·  June 2026"
    headline="Where Does Your Security Posture Stand <em>at the Midpoint of&nbsp;2026?</em>"
    subhead="Download the free guide and find out what has changed since January, where the gaps are, and what to do about it before renewal season."
    body1="Carrier cyber requirements updated this year. Your systems changed. Your staff may have changed. The security posture you had in January is not necessarily the one you have today."
    body2="This guide covers the four areas carriers scrutinize most. For each one you will find a benchmark for where you should be at midyear and a clear action item if you are not there. Written for agency owners, not IT professionals."
    formHeading="Get the Free Security Guide"
    formSubhead="We will send it to your inbox right away."
    formId="PLACEHOLDER_FORM_ID_SECURITY_POSTURE"
    trustLine="No spam. No sales call unless you want one. Just the guide."
  />

  <ProblemCardsThree
    sectionLabel="The Midyear Security Problem"
    heading="Your January Posture Is Not <br /><span class='hl'>Your June&nbsp;Posture.</span>"
    subhead="Things change throughout the year. Most agencies do not find out what changed until a carrier asks at renewal."
    cards={[
      {
        title: "MFA that is enabled but not enforced",
        body: "Most agencies have MFA turned on for most accounts. Carriers want it enforced on all accounts. One uncovered admin account is all it takes for a claim to get complicated."
      },
      {
        title: "Backups that run but have never been tested",
        body: "Having backups is not the same as having validated backups. Most agencies cannot confirm a successful restore has ever happened. That matters when you need one."
      },
      {
        title: "Incident response documentation that does not exist",
        body: "When a carrier asks for your incident response plan, the answer cannot be ‘we call our IT person.’ It needs to be a documented, current, accessible plan."
      }
    ]}
  />

  <NumberedCardsList
    sectionLabel="What the Guide Covers"
    heading="Four Security Areas. A Benchmark for Each. <br />A Clear Action Item If You Are Not&nbsp;There."
    cards={[
      {
        title: "MFA enforcement",
        body: "What fully enforced actually means, most agencies think they have it and do not. How to check every account including admin and service accounts. What to fix if there are gaps and how to document the fix."
      },
      {
        title: "Backup and recovery",
        body: "The difference between having backups and having validated backups. What a successful restore test looks like. How to document it so a carrier can verify it. How often it needs to happen."
      },
      {
        title: "Incident response documentation",
        body: "What carriers want to see on file and why most agencies do not have it. The five things every incident response plan needs to include. How to get a plan in place without starting from scratch."
      },
      {
        title: "Carrier requirement alignment",
        body: "What changed in 2026 specifically. Which requirements are now standard across most carrier cyber endorsements. How to document your compliance so renewal conversations do not become delays."
      }
    ]}
  />

  <StatsBar />
  <AboutArchway />
  <WhyChooseUs />
  <Testimonials />

  <BottomCTA
    heading="Ready to Find Out Where You Actually Stand?"
    subtext="Download the guide and get a clear mid-year picture of your security posture, and a specific action item for anything that needs attention."
    ctaText="Get the Free Guide"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.problem-header h2 .hl) {
    color: var(--orange);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
