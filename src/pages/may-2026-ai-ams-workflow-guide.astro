---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroLeadMagnet from '../components/shared/HeroLeadMagnet.astro';
import ProblemCardsThree from '../components/shared/ProblemCardsThree.astro';
import NumberedCardsList from '../components/shared/NumberedCardsList.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="AI Workflow Automation for Insurance AMS Platforms | Archway"
  description="Download the free guide and see exactly how independent agencies are using AI to automate AMS workflows, with live examples built on Applied, Hawksoft, EZLynx, and Vertafore."
  ctaText="Get the Free Guide"
  ctaHref="#hero-form"
>
  <HeroLeadMagnet
    badge="AI and AMS Workflows  ·  May 2026"
    headline="Your AMS Is Doing Less Than It Could. <em>AI Can Fix&nbsp;That.</em>"
    subhead="Download the free guide and see exactly how independent agencies are automating the workflows that still eat staff hours every day."
    body1="Most independent insurance agencies are using about 40 percent of what their AMS is actually capable of. The rest sits unused because the setup requires time nobody has and the ROI is not obvious until someone shows you."
    body2="This guide covers the five workflow automations we build most often for independent agencies, what they cost, and what they deliver. Real examples built on Applied, Hawksoft, EZLynx, and Vertafore."
    formHeading="Get Your Free Copy of the Guide"
    formSubhead="We will send it to your inbox right away."
    formId="PLACEHOLDER_FORM_ID_AMS_WORKFLOW"
    trustLine="No spam. No sales call unless you want one. Just the guide."
  />

  <ProblemCardsThree
    sectionLabel="The AMS Problem Most Agencies Share"
    heading="You Are Paying for Capabilities <br /><span class='hl'>Your Staff Works Around Every&nbsp;Day.</span>"
    subhead="The tools are there. The time to set them up was never there. And now the workarounds feel normal."
    cards={[
      {
        title: "Manual data entry that should not be manual",
        body: "Staff entering data into the AMS by hand that came from a carrier, a client email, or a phone call. This is automatable. Most agencies just have not set it up."
      },
      {
        title: "Reporting that takes hours instead of minutes",
        body: "Pulling numbers from three different places, combining them in a spreadsheet, formatting for leadership. AI connected to your AMS does this in seconds."
      },
      {
        title: "Renewals and follow-ups falling through cracks",
        body: "Renewal reminders that depend on someone remembering to send them. Client follow-ups that live in someone’s inbox. These are workflow problems with automation solutions."
      }
    ]}
  />

  <NumberedCardsList
    sectionLabel="What the Guide Covers"
    heading="Five Automations. Real Numbers. <br />Built on the Systems You Already&nbsp;Run."
    cards={[
      {
        title: "Call recording to AMS activity creation",
        body: "When a call ends, AI grabs the recording, analyzes the conversation, determines the call type, and creates the appropriate activity in the AMS automatically. Archway built this for a live client. Staff no longer manually log calls."
      },
      {
        title: "Automatic commission statement entry",
        body: "Agency uploads a carrier commission statement. AI extracts and enters all data automatically. Eliminates hours of manual data entry per statement cycle. Another live Archway client implementation."
      },
      {
        title: "Renewal follow-up sequences",
        body: "Automated reminders triggered by policy dates in the AMS. Configured once, run without staff intervention. Never miss a renewal touchpoint again."
      },
      {
        title: "Certificate generation",
        body: "Certificates of insurance generated automatically from AMS data. No manual templating. No copy-paste from policy records. Done in seconds."
      },
      {
        title: "Reporting pulls from multiple systems",
        body: "AI aggregates data from AMS, email, and carrier platforms into formatted reports. What used to take two hours on a Friday afternoon now runs automatically."
      }
    ]}
  />

  <StatsBar />
  <AboutArchway />
  <WhyChooseUs />
  <Testimonials />

  <BottomCTA
    heading="Ready to See What This Looks Like for Your Agency?"
    subtext="Download the guide and see exactly which automations deliver the fastest results, and how to get started without a technical team."
    ctaText="Get the Free Guide"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.problem-header h2 .hl) {
    color: var(--orange);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
