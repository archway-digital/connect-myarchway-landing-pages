---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import NumberedCardsList from '../components/shared/NumberedCardsList.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import Testimonials from '../components/shared/Testimonials.astro';

const HUBSPOT_PORTAL_ID = '6869933';
const HUBSPOT_FORM_ID = '265fd6ee-818d-4b22-b5b9-22d9a5612975';
---

<ArchwayLayout
  title="AI-Powered Policy Comparison for Independent Insurance Agencies | Archway"
  description="Show clients exactly what changed between their current policy and a competing quote. Side by side. Plain language. Built by Archway exclusively for independent insurance agencies."
  ctaText="See the Demo"
  ctaHref="#hero-form"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-badge">AI Without the Hype  ·  May 2026</div>
        <h1>Your Client Got a Cheaper Quote.<br /><span class="hl">Here Is How You Keep Them.</span></h1>
        <p class="hero-sub">Show them exactly what changed between their current policy and the competing quote. Side by side. Plain language. Built on insurance coverage logic, not adapted from a generic document tool.</p>
        <a href="#hero-form" class="hero-cta-primary">
          See the Demo Now
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="hero-trust">No pitch. No platform fee conversation. Just a tool built for insurance agencies.</p>
      </div>

      <div class="hero-form-card" id="hero-form">
        <div class="form-header">
          <h2>Let&rsquo;s Talk About Your Agency</h2>
          <p>We will follow up within one business day.</p>
        </div>
        <div id="hs-policy-comp-form"></div>
      </div>
    </div>
  </section>

  <script is:inline src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline define:vars={{ HUBSPOT_PORTAL_ID, HUBSPOT_FORM_ID }}>
    function _createPolicyCompForm() {
      if (!window.hbspt || !window.hbspt.forms) {
        setTimeout(_createPolicyCompForm, 80);
        return;
      }
      window.hbspt.forms.create({
        portalId: HUBSPOT_PORTAL_ID,
        formId: HUBSPOT_FORM_ID,
        region: 'na2',
        target: '#hs-policy-comp-form',
        css: "\
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\
          .hs-form { font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .hs-form fieldset { max-width: 100% !important; }\
          .hs-form fieldset.form-columns-2 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-2 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form fieldset.form-columns-3 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-3 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form-field { margin-bottom: 16px; }\
          .hs-form-field > label { display: block; font-size: 14px; font-weight: 600; color: #333333; margin-bottom: 8px; }\
          .hs-form-required { color: #ef4444; margin-left: 2px; }\
          .hs-input { width: 100% !important; padding: 14px 16px !important; background: #ffffff !important; border: 1px solid #d1d5db !important; border-radius: 8px !important; color: #333333 !important; font-size: 16px !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s, box-shadow 0.2s; }\
          .hs-input:focus { border-color: #f48021 !important; box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.25) !important; }\
          .hs-input::placeholder { color: #9ca3af; }\
          .hs-submit { margin-top: 8px; }\
          .hs-button { width: 100% !important; padding: 16px !important; background: #f48021 !important; color: #ffffff !important; font-size: 16px !important; font-weight: 700 !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; border: none !important; border-radius: 8px !important; cursor: pointer; transition: all 0.2s; min-height: 44px; }\
          .hs-button:hover { background: #d96d10 !important; }\
          .hs-error-msgs { list-style: none; padding: 0; margin: 4px 0 0; }\
          .hs-error-msgs li label { font-size: 13px !important; color: #ef4444 !important; font-weight: 500 !important; }\
          .hs-input.error { border-color: #ef4444 !important; }\
          .submitted-message { text-align: center; padding: 30px 10px; font-size: 16px; line-height: 1.55; color: #333333; font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .legal-consent-container { font-size: 13px; color: #5a5f66; line-height: 1.5; margin-top: 8px; }\
          .legal-consent-container a { color: #f48021; }\
          @media (max-width: 480px) { .hs-form fieldset.form-columns-2, .hs-form fieldset.form-columns-3 { flex-direction: column; gap: 0; } }\
        "
      });
    }
    _createPolicyCompForm();
  </script>

  <!-- What the Tool Does -->
  <section class="section">
    <div class="section-inner centered">
      <p class="section-label centered-label">What the Tool Does</p>
      <h2 class="section-h2 centered-h">Two Documents In. <span class="hl">One Clear Answer Out.</span></h2>

      <div class="io-grid">
        <article class="io-card io-card--in">
          <p class="io-eyebrow">What Goes In</p>
          <h3>The Current Policy and the Competing Quote</h3>
          <p>An agency loads two documents: the client&rsquo;s current declarations page and the competing carrier&rsquo;s quote. The tool accepts homeowners ACORD forms, dwelling policies, commercial BOP declarations pages, and standard carrier quote documents. Personal lines, commercial lines, and rental property. The AI reads both documents and identifies every field that differs between them.</p>
        </article>
        <div class="io-arrow" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="6" y1="16" x2="26" y2="16"/>
            <polyline points="18 8 26 16 18 24"/>
          </svg>
        </div>
        <article class="io-card io-card--out">
          <p class="io-eyebrow">What Comes Out</p>
          <h3>A Side by Side Coverage Comparison</h3>
          <p>A plain-language comparison showing exactly what changed between the two documents. Premium difference. Coverage limits side by side. Deductible changes. Exclusions that appeared or disappeared. Endorsements added or removed. Written in language a client can read and understand without an agent translating it. The agency controls the conversation because they have the data.</p>
        </article>
      </div>
    </div>
  </section>

  <NumberedCardsList
    sectionLabel="How It Works"
    heading="Load Two Documents. <br />Get a Complete Coverage&nbsp;Breakdown."
    cards={[
      {
        title: "Agency loads the current policy and the competing quote",
        body: "A client's current declarations page and the competing carrier's quote document. The tool accepts PDFs and standard carrier document formats. Personal homeowners, rental property, and commercial BOP in the demo right now."
      },
      {
        title: "AI reads both documents and identifies every difference",
        body: "The tool knows the difference between an HO-3 and a DP-1. It knows what dwelling replacement cost means versus actual cash value. It knows how to read a Hartford BOP schedule and a Chubb quote side by side. That coverage context was built in, not configured after the fact by a vendor who had to be taught what insurance documents contain."
      },
      {
        title: "Ask the AI anything about the comparison",
        body: "The producer asks questions in plain language. Why is the competing quote cheaper? What coverage did they drop? Is the liability limit right for this client? The AI answers using both documents and what it knows about the client. It flags gaps proactively, if the competing carrier dropped water backup and the client had a flood claim, the AI surfaces that before the producer sends anything. It drafts endorsements, explanations, and client-ready summaries on request."
      }
    ]}
  />

  <!-- The AI Producer Assistant -->
  <section class="section">
    <div class="section-inner centered">
      <p class="section-label centered-label">More Than a Comparison</p>
      <h2 class="section-h2 centered-h">An AI Producer Assistant That <span class="hl">Thinks Through the Risk With You.</span></h2>

      <div class="producer-grid">
        <article class="producer-card producer-card--flag">
          <p class="producer-eyebrow">What It Flags</p>
          <h3>Coverage Gaps the Producer Might Miss</h3>
          <p>The AI reads both documents against what it knows about the client. If the competing quote dropped water backup coverage and the client had a basement flood claim in 2021, it flags that before the producer sends anything. If the settlement basis changed from replacement cost to ACV, it explains what that means on a partial loss in plain language. It surfaces the things that matter, not just the things that changed.</p>
        </article>
        <article class="producer-card producer-card--draft">
          <p class="producer-eyebrow">What It Drafts</p>
          <h3>Endorsements, Explanations, and Client-Ready Summaries</h3>
          <p>Ask the AI to draft an add-back endorsement for a dropped coverage. Ask it to explain why the competing quote is cheaper. Ask it whether the liability limit is appropriate for the client&rsquo;s situation. Ask it to explain replacement cost versus actual cash value in terms the client will understand. The producer asks the question. The AI does the research and drafts the response.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- What You Can Ask -->
  <section class="section section-light">
    <div class="section-inner centered">
      <p class="section-label centered-label">Ask Anything About the Comparison</p>
      <h2 class="section-h2 centered-h">The Producer Asks. <span class="hl">The AI Answers.</span></h2>

      <div class="ask-grid">
        <article class="ask-card">
          <h3>Coverage and carrier questions</h3>
          <p>Why is the competing quote cheaper? Is the liability limit appropriate for this client? What does the settlement basis change mean on a partial loss? What changed in the endorsements section that is not obvious from the premium difference?</p>
        </article>
        <article class="ask-card">
          <h3>Gap and risk identification</h3>
          <p>What coverages did the competing carrier drop? Does the client have any claims history that makes a dropped coverage a real risk? What would it cost to add back the coverage that was removed? Is there an endorsement that closes this gap?</p>
        </article>
        <article class="ask-card">
          <h3>Client-ready drafts</h3>
          <p>Draft an explanation of the coverage differences in language the client can understand. Draft an add-back endorsement recommendation. Draft a summary of why the agency recommends staying with the current carrier or moving to the new one. The AI produces the draft. The producer reviews and sends.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Three Scenarios -->
  <section class="section">
    <div class="section-inner centered">
      <p class="section-label centered-label">Try It Now</p>
      <h2 class="section-h2 centered-h">Three Real Scenarios <span class="hl">Loaded and Ready.</span></h2>

      <div class="scenarios-grid">
        <article class="scenario-featured">
          <div class="scenario-featured-meta">
            <p class="scenario-tag">Featured · Personal Lines</p>
            <span class="scenario-delta-pill scenario-delta-pill--savings">−$240 / yr</span>
          </div>
          <p class="scenario-matchup"><strong>State Farm</strong> <span class="scenario-vs">vs</span> <strong>Travelers</strong></p>
          <p class="scenario-profile">Sarah Chen · Austin, TX · HO-3 dwelling</p>
          <dl class="scenario-stats">
            <div>
              <dt>Current</dt>
              <dd>$1,720 / yr</dd>
            </div>
            <div>
              <dt>Competing</dt>
              <dd>$1,480 / yr</dd>
            </div>
            <div>
              <dt>Premium delta</dt>
              <dd class="scenario-stats-delta">−$240</dd>
            </div>
          </dl>
          <p class="scenario-blurb">The competing quote drops water backup, doubles the deductible, and switches the settlement basis to ACV. The $240 saving carries about $2,500 of out-of-pocket exposure.</p>
          <a href="#comp-summary" class="scenario-link">See the full comparison below
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="5 12 12 19 19 12"/></svg>
          </a>
        </article>

        <div class="scenarios-side">
          <article class="scenario-compact">
            <div class="scenario-compact-head">
              <p class="scenario-tag">Personal Lines</p>
              <span class="scenario-delta-pill scenario-delta-pill--cost">+$160 / yr</span>
            </div>
            <p class="scenario-matchup scenario-matchup--small"><strong>Liberty Mutual</strong> <span class="scenario-vs">vs</span> <strong>Foremost</strong></p>
            <p class="scenario-profile">Mike Johnson · Phoenix, AZ · DP-1 to DP-3</p>
            <p class="scenario-compact-blurb">The DP-1 to DP-3 coverage shift matters more than the premium difference. The tool surfaces what the extra $160 actually buys.</p>
          </article>
          <article class="scenario-compact">
            <div class="scenario-compact-head">
              <p class="scenario-tag">Commercial Lines</p>
              <span class="scenario-delta-pill scenario-delta-pill--savings">−$260 / yr</span>
            </div>
            <p class="scenario-matchup scenario-matchup--small"><strong>Hartford</strong> <span class="scenario-vs">vs</span> <strong>Chubb</strong></p>
            <p class="scenario-profile">Acme LLC · 8-person contractor · Denver, CO</p>
            <p class="scenario-compact-blurb">A BOP renewal saving $260 per year. The tool surfaces how that $260 maps to liability limits, property coverage, and endorsements.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- See Sarah's Comparison: product mockup section -->
  <section class="section section-light">
    <div class="section-inner centered">
      <p class="section-label centered-label">What the Output Looks Like</p>
      <h2 class="section-h2 centered-h">See Sarah&rsquo;s Comparison. <span class="hl">Side by Side. Plain Language.</span></h2>
      <p class="comp-intro">The first scenario above, rendered as the tool actually produces it. No interpretation needed. The numbers and the coverage shifts speak for themselves.</p>

      <article class="comp-doc" aria-label="Side-by-side policy comparison for Sarah Chen">
        <header class="comp-head">
          <div class="comp-head-meta">
            <p class="comp-head-eyebrow">Renewal Comparison · Personal Lines</p>
            <p class="comp-head-applicant">Sarah Chen <span class="comp-head-divider">·</span> Austin, TX <span class="comp-head-divider">·</span> HO-3 Dwelling</p>
          </div>
          <div class="comp-head-carriers">
            <div class="comp-carrier">
              <p class="comp-carrier-label">Current</p>
              <p class="comp-carrier-name">State Farm</p>
            </div>
            <span class="comp-vs" aria-hidden="true">vs</span>
            <div class="comp-carrier">
              <p class="comp-carrier-label">Competing Quote</p>
              <p class="comp-carrier-name">Travelers</p>
            </div>
          </div>
        </header>

        <table class="comp-table" aria-describedby="comp-summary">
          <thead>
            <tr>
              <th scope="col" class="comp-th-coverage">Coverage</th>
              <th scope="col" class="comp-th-carrier">State Farm</th>
              <th scope="col" class="comp-th-carrier">Travelers</th>
              <th scope="col" class="comp-th-delta">Change</th>
            </tr>
          </thead>
          <tbody>
            <tr class="comp-row comp-row--premium">
              <th scope="row" class="comp-rowlabel">Annual premium</th>
              <td class="comp-val" data-label="State Farm">$1,720</td>
              <td class="comp-val" data-label="Travelers">$1,480</td>
              <td class="comp-delta"><span class="comp-delta-pill comp-delta-pill--savings">−$240 / yr</span></td>
            </tr>
            <tr class="comp-row">
              <th scope="row" class="comp-rowlabel">Dwelling (replacement cost)</th>
              <td class="comp-val" data-label="State Farm">$310,000</td>
              <td class="comp-val" data-label="Travelers">$310,000</td>
              <td class="comp-delta comp-delta--same">Same</td>
            </tr>
            <tr class="comp-row comp-row--alert">
              <th scope="row" class="comp-rowlabel">Deductible</th>
              <td class="comp-val" data-label="State Farm">$1,000</td>
              <td class="comp-val" data-label="Travelers">$2,500</td>
              <td class="comp-delta comp-delta--alert">Doubled</td>
            </tr>
            <tr class="comp-row comp-row--alert">
              <th scope="row" class="comp-rowlabel">Water backup</th>
              <td class="comp-val" data-label="State Farm">$5,000 included</td>
              <td class="comp-val" data-label="Travelers">Not included</td>
              <td class="comp-delta comp-delta--alert">Dropped</td>
            </tr>
            <tr class="comp-row comp-row--alert">
              <th scope="row" class="comp-rowlabel">Settlement basis</th>
              <td class="comp-val" data-label="State Farm">Replacement cost</td>
              <td class="comp-val" data-label="Travelers">Actual cash value</td>
              <td class="comp-delta comp-delta--alert">Changed</td>
            </tr>
            <tr class="comp-row">
              <th scope="row" class="comp-rowlabel">Liability</th>
              <td class="comp-val" data-label="State Farm">$300,000</td>
              <td class="comp-val" data-label="Travelers">$300,000</td>
              <td class="comp-delta comp-delta--same">Same</td>
            </tr>
            <tr class="comp-row comp-row--alert">
              <th scope="row" class="comp-rowlabel">Medical payments</th>
              <td class="comp-val" data-label="State Farm">$5,000</td>
              <td class="comp-val" data-label="Travelers">$1,000</td>
              <td class="comp-delta comp-delta--alert">Reduced</td>
            </tr>
          </tbody>
        </table>

        <footer class="comp-summary" id="comp-summary">
          <p class="comp-summary-label">Plain-Language Summary</p>
          <p class="comp-summary-body">Travelers saves <strong>$240 a year</strong>, but it doubles the deductible, drops water backup (Sarah filed a basement flood claim in 2022), and switches the settlement basis to actual cash value on partial losses. The $240 in annual savings carries roughly <strong>$2,500 in out-of-pocket exposure</strong> the first time a covered event happens.</p>
          <p class="comp-summary-recommend">Recommended add-back: water backup endorsement, settlement-basis rider, deductible buy-down. Net cost to keep Travelers and match the original coverage profile: <strong>about $190 a year</strong>, not $240 in savings.</p>
        </footer>
      </article>

      <p class="comp-aside">This is the actual output for one of the three scenarios. The other two render the same way: BOP coverage rows for Acme&rsquo;s Hartford vs Chubb comparison, rental-property DP-1 vs DP-3 fields for Mike&rsquo;s Liberty Mutual vs Foremost.</p>
    </div>
  </section>

  <!-- Why This Is Not Another Platform Fee -->
  <section class="section section-light">
    <div class="section-inner centered">
      <p class="section-label centered-label">Why This Is Not Another Platform Fee</p>
      <h2 class="section-h2 centered-h">Built on Insurance Coverage Logic. <br /><span class="hl">Not Adapted From a Generic Document Tool.</span></h2>

      <div class="reasons-grid">
        <article class="reason-card">
          <h3>It knows insurance document formats</h3>
          <p>HO-3, DP-1, DP-3, BOP schedules, ACORD forms, carrier quote documents. The tool was built to read the specific document types that independent agencies handle every day. A generic document comparison tool does not know what dwelling replacement cost means. This one does.</p>
        </article>
        <article class="reason-card">
          <h3>It reads coverage terms, not just fields</h3>
          <p>The comparison surfaces what actually matters: coverage limit changes, deductible differences, exclusions that appeared or disappeared, endorsements added or removed. Not just a field-by-field data extract. A coverage-aware comparison written in language a client can understand.</p>
        </article>
        <article class="reason-card">
          <h3>Your agency owns the workflow</h3>
          <p>No recurring per-comparison fee. No platform subscription attached to every renewal conversation. Archway builds the workflow custom for your agency. You own it. The tool connects to the coverage types and document formats your clients actually bring in.</p>
        </article>
        <article class="reason-card">
          <h3>Exclusively for independent agencies</h3>
          <p>Archway works exclusively with independent insurance agencies on IT, cybersecurity, marketing, and AI. This tool was not built for a general business and adapted for insurance. It was built for the renewal conversations, retention challenges, and coverage complexity that independent agencies deal with every day.</p>
        </article>
      </div>
    </div>
  </section>

  <StatsBar />
  <Testimonials />

  <!-- Bottom CTA Band -->
  <section class="cta-section bottom-cta-two">
    <div class="bottom-cta-inner">
      <h2>Ready to See It Working on <span class="hl">Real Policy Documents?</span></h2>
      <p>Try the demo in two minutes. Or book 30 minutes with Sam and talk through what a custom build looks like for your agency&rsquo;s renewal workflow.</p>
      <div class="cta-buttons">
        <a href="#hero-form" class="cta-button">
          See the Demo Now
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="https://meetings-na2.hubspot.com/sam-ruben/website-forms-discovery-call?uuid=b6de8e54-720e-4dec-8f7a-f3d75927d80d" class="cta-button-secondary" target="_blank" rel="noopener">Book 30 Minutes With Sam</a>
      </div>
    </div>
  </section>
</ArchwayLayout>

<style>
  /* ── HERO ── */
  :global(.hero .hero-kicker::before) {
    display: none;
  }

  .hero-body {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 14px;
    max-width: 58ch;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: var(--white);
    text-decoration: none;
    font-size: 17px;
    font-weight: 700;
    padding: 18px 32px;
    border-radius: 8px;
    margin-top: 12px;
    min-height: 44px;
    transition: background 0.2s ease;
  }

  .hero-cta-primary:hover {
    background: var(--orange-dark);
  }

  .hero-trust {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
    max-width: 52ch;
  }

  #hs-policy-comp-form {
    width: 100%;
  }

  /* ── CENTERED SECTION UTILITIES ── */
  .centered { text-align: center; }
  .centered-label {
    display: inline-flex;
    margin-left: auto;
    margin-right: auto;
  }
  .centered-h {
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: var(--charcoal);
    margin-bottom: 48px;
    text-wrap: balance;
  }

  /* ── WHAT THE TOOL DOES — input → output flow ── */
  .io-grid {
    display: grid;
    grid-template-columns: 1fr 56px 1fr;
    gap: 24px;
    align-items: center;
    text-align: left;
  }

  .io-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 36px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .io-card--in { background: var(--light-bg); }
  .io-card--out { background: var(--white); }

  .io-eyebrow {
    font-size: 12px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .io-card h3 {
    font-size: 22px;
    font-weight: 800;
    color: var(--charcoal);
    letter-spacing: -0.3px;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .io-card p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .io-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
  }

  /* ── AI PRODUCER ASSISTANT — two facets, no arrow ── */
  .producer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    text-align: left;
  }

  .producer-card {
    border-radius: 16px;
    padding: 36px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .producer-card--flag {
