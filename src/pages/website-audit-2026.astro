---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroGrader from '../components/grader/HeroGrader.astro';
import ProblemFraming from '../components/grader/ProblemFraming.astro';
import WhatWeGrade from '../components/grader/WhatWeGrade.astro';
import GeoContentSection from '../components/grader/GeoContentSection.astro';
import TimingSection from '../components/grader/TimingSection.astro';
import CredibilityGrader from '../components/grader/CredibilityGrader.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Free Website Grader for Insurance Agencies | Archway"
  description="Get a free website grade across mobile experience, page speed, local SEO, conversion design, and trust signals. Built for independent insurance agencies."
  ctaText="Grade My Website"
  ctaHref="#hero-form"
>
  <HeroGrader formId="82075b71-f658-4ed0-806a-d89d1dec1f31" />
  <ProblemFraming />
  <WhatWeGrade />
  <GeoContentSection />
  <TimingSection />
  <CredibilityGrader />
  <BottomCTA
    heading="Your Score Is Just the Start"
    subtext="Schedule a quick call to walk through your results, or we'll email you the full report (whatever works best)."
    ctaText="Book a Free Review"
    ctaHref="https://meetings-na2.hubspot.com/hannah-ruben?uuid=15c419cf-bb54-42a5-99f2-6061da28dc99"
    ctaVariant="secondary"
  />
  <p class="micro-copy">30 minutes. No pitch. Just a clear picture of where you stand.</p>
</ArchwayLayout>

<style>
  .micro-copy {
    text-align: center;
    background: var(--navy);
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    padding: 0 24px 24px;
    margin-top: -56px;
  }
</style>
