---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import ServicesGrid from '../components/shared/ServicesGrid.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Does Your Agency Have a Compliance Gap? | Archway"
  description="Book a 30-minute call and find out exactly where you stand before a carrier, a renewal conversation, or an incident does it for you."
  ctaText="Request My Compliance Review"
  ctaHref="#hero-form"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-badge">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="rgba(255,255,255,0.8)" stroke="none"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
          Compliance Season 2026
        </div>
        <h1>Does Your Agency Have a <span class='hl'>Compliance Gap?</span></h1>
        <p class="hero-sub">Book a 30-minute call and find out exactly where you stand before a carrier, a renewal conversation, or an incident does it for you.</p>
      </div>

      <div class="hero-form-card" id="hero-form">
        <div class="form-header">
          <h2>Request Your Compliance Review</h2>
          <p>We will follow up within one business day.</p>
        </div>
        <div id="hs-compliance-review-form"></div>
      </div>
    </div>
  </section>

  <script is:inline src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline>
    function _createComplianceReviewForm() {
      if (!window.hbspt || !window.hbspt.forms) {
        setTimeout(_createComplianceReviewForm, 80);
        return;
      }
      window.hbspt.forms.create({
        portalId: "6869933",
        formId: "1b1111a8-5676-4e36-abaa-526149652cfa",
        region: "na2",
        target: "#hs-compliance-review-form",
        css: "\
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\
          .hs-form { font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .hs-form fieldset { max-width: 100% !important; }\
          .hs-form fieldset.form-columns-2 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-2 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form fieldset.form-columns-3 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-3 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form-field { margin-bottom: 16px; }\
          .hs-form-field > label { display: block; font-size: 14px; font-weight: 600; color: #333333; margin-bottom: 8px; }\
          .hs-form-required { color: #ef4444; margin-left: 2px; }\
          .hs-input { width: 100% !important; padding: 14px 16px !important; background: #ffffff !important; border: 1px solid #d1d5db !important; border-radius: 8px !important; color: #333333 !important; font-size: 16px !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s, box-shadow 0.2s; }\
          .hs-input:focus { border-color: #f48021 !important; box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.25) !important; }\
          .hs-input::placeholder { color: #9ca3af; }\
          .hs-submit { margin-top: 8px; }\
          .hs-button { width: 100% !important; padding: 16px !important; background: #f48021 !important; color: #ffffff !important; font-size: 16px !important; font-weight: 700 !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; border: none !important; border-radius: 8px !important; cursor: pointer; transition: all 0.2s; min-height: 44px; }\
          .hs-button:hover { background: #d96d10 !important; }\
          .hs-error-msgs { list-style: none; padding: 0; margin: 4px 0 0; }\
          .hs-error-msgs li label { font-size: 13px !important; color: #ef4444 !important; font-weight: 500 !important; }\
          .hs-input.error { border-color: #ef4444 !important; }\
          .submitted-message { text-align: center; padding: 30px 10px; font-size: 16px; line-height: 1.55; color: #333333; font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .legal-consent-container { font-size: 13px; color: #5a5f66; line-height: 1.5; margin-top: 8px; }\
          .legal-consent-container a { color: #f48021; }\
          @media (max-width: 480px) { .hs-form fieldset.form-columns-2, .hs-form fieldset.form-columns-3 { flex-direction: column; gap: 0; } }\
        "
      });
    }
    _createComplianceReviewForm();
  </script>

  <!-- Problem Cards -->
  <section class="section">
    <div class="section-inner">
      <div class="problem-header fade-up">
        <p class="section-label">What Agencies Get Wrong</p>
        <h2>Most Agencies Have at Least One Gap They Do Not Know&nbsp;About</h2>
      </div>
      <div class="problem-grid fade-up">
        <div class="problem-card">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>No Written Plan</h3>
          <p>Most agencies do not have a documented incident response plan. When something goes wrong, they find out how expensive that is.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
          </div>
          <h3>Untested Backups</h3>
          <p>Having backups is not the same as having validated backups. Most agencies have never confirmed a successful restore.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Unenforced MFA</h3>
          <p>MFA enabled on most accounts is not MFA enforced. One uncovered admin account is all it takes.</p>
        </div>
      </div>
    </div>
  </section>

  <StatsBar />
  <ServicesGrid />
  <AboutArchway />
  <WhyChooseUs />

  <!-- What We Cover -->
  <section class="section section-light">
    <div class="section-inner">
      <div class="cover-header fade-up">
        <p class="section-label">What We Cover in the Call</p>
        <h2>30 Minutes. A Clear Picture of Where You&nbsp;Stand.</h2>
      </div>
      <div class="cover-grid fade-up">
        <div class="cover-card">
          <h3>Security Controls and MFA</h3>
          <p>We review your MFA enforcement status across every user, admin account, and connected system.</p>
        </div>
        <div class="cover-card">
          <h3>Backup and Recovery Posture</h3>
          <p>We check whether your backups run automatically, are stored correctly, and have been successfully restored.</p>
        </div>
        <div class="cover-card">
          <h3>Incident Response Documentation</h3>
          <p>We review or help create your written incident response plan so you have something to show a carrier when they ask.</p>
        </div>
        <div class="cover-card">
          <h3>NYDFS and Carrier Alignment</h3>
          <p>We check your current posture against NYDFS requirements and your specific carrier cyber requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <BottomCTA
    heading="Ready to Find Out Where You Stand?"
    subtext="Book 30 minutes. We will walk through your current posture and tell you exactly what needs attention."
    ctaText="Request My Compliance Review"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.hero h1 em) {
    font-style: normal;
    color: var(--orange);
  }

  .hs-form-frame {
    width: 100%;
    min-height: 380px;
  }

  .section-label {
    text-align: center;
    display: block;
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .section-label::before {
    display: none;
  }

  /* Problem Cards */
  .problem-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .problem-header h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.3;
    text-wrap: balance;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .problem-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 32px 24px;
  }

  .problem-icon {
    width: 48px;
    height: 48px;
    background: rgba(244, 128, 33, 0.08);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .problem-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .problem-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  /* Coverage Cards */
  .cover-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .cover-header h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.3;
    text-wrap: balance;
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .cover-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 32px;
  }

  .cover-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .cover-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0;
  }

  @media (max-width: 768px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }

    .cover-grid {
      grid-template-columns: 1fr;
    }

    .problem-header h2,
    .cover-header h2 {
      font-size: 26px;
    }
  }
</style>

