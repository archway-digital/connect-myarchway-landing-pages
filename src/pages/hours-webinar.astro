---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';

// The webinar's own HubSpot form, supplied 2026-08-31. This replaces the
// general lead-magnet form that stood in until now.
//
// Two fields on it have a job after registration:
//   - Management system (dropdown, required)
//   - Which side brought you here? (radio: Service capacity / Custom AI tools / Both, required)
// The radio field drives the E4 split send and both post-webinar follow-up
// sequences, so confirm both are present in HubSpot before the first send.
//
// STILL TO SET, in HubSpot rather than here: the post-submit redirect must
// point at /hours-webinar/thank-you.
const FORM_ID = '13a77c2d-5c65-4de1-a63b-cb6e9afd0119';

// BLOCKER: the date is not confirmed in writing. Angela named Sept 15 and 16 as
// her open slots on the planning call and accepted the 8th when pushed. Every
// date on this page comes from the constants below, so a change is one edit.
const WEBINAR_DATE_LONG = 'Tuesday, September 8';
const WEBINAR_TIME = '1:00 PM Eastern';

// The official webinar title, supplied 2026-08-26. The campaign doc's H1 was a
// near-miss of this ("The work is not the problem. The hours are."); the title
// is canonical, so the H1 and the E1 subject line both use it now.
const WEBINAR_TITLE = 'The Work Is Not the Problem. It’s the Hours.';

const payoffs = [
  {
    title: 'Hours back without hiring',
    body: 'The work still gets done. It stops getting done by your team. No ninety day search, no salary, no overhead, no wondering whether the person stays.',
  },
  {
    title: 'Round-out revenue you are not finding',
    body: 'The gap is already in your book. It stays invisible because nobody has an hour to read the renewal against expiring. Surface the comparison and the upsell surfaces with it, and somebody licensed is in the conversation to ask the question.',
  },
  {
    title: 'The client experience you meant to deliver',
    body: 'Producers in front of clients instead of inside the management system. Renewal conversations instead of renewal notices. And a safety net on the limits your agency does not actually want to write, for the times something slips through.',
  },
];

const problems = [
  {
    title: 'Certificates',
    body: 'Updating a cert holder is simple. Everything past that means reading a contract, and construction contracts each want something different. A waiver of subrogation requirement does not announce itself.',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>',
  },
  {
    title: 'Policy checking',
    body: 'Comparing the renewal against expiring is how coverage changes get caught. When there are no hours for it, that check quietly stops happening.',
    icon: '<rect x="3" y="4" width="7" height="16" rx="1"/><rect x="14" y="4" width="7" height="16" rx="1"/><line x1="10" y1="12" x2="14" y2="12"/>',
  },
  {
    title: 'Quoting and remarketing',
    body: 'A rater gets you quotes, but the quote changes once it bridges to the carrier. Somebody still has to compare bridged quotes line by line, at the exact moment nobody has an hour to spare.',
    icon: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>',
  },
];

const tools = [
  {
    title: 'Client intake',
    body: 'A customer-facing form that opens into an internal working file. One agency has it writing into Nexsure and generating ACORDs automatically. Another on Applied Epic did not want to pay for the API, so it produces an ACORD XML file to import instead. Intake stops being something a CSR retypes.',
    icon: '<path d="M4 4h16v5H4z"/><path d="M4 13h9"/><path d="M4 17h6"/><path d="M17 13.5V21"/><polyline points="14 18.5 17 21.5 20 18.5"/>',
  },
  {
    title: 'Policy comparison',
    body: 'Current against renewal, coverage differences surfaced. Ask questions directly against the loaded documents instead of reading two declarations pages side by side at eleven at night. The same comparison that catches a coverage gap is the one that shows you the upsell.',
    icon: '<rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="18" rx="1"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>',
  },
  {
    title: 'Quote to proposal',
    body: 'The comparison converted into a proposal a client can actually read, and sent. The round-out conversation happens the same day instead of next quarter.',
    icon: '<path d="M4 4h13l3 3v13H4z"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="13" y2="15"/><polyline points="17 7 20 7 20 10" fill="none"/>',
  },
];

const runsheet = [
  {
    range: 'First ten minutes.',
    body: 'Context from Angela and Sam on what each of them does.',
  },
  {
    range: 'Next thirty.',
    body: 'Live demonstration. Three tools. No slides.',
  },
  {
    range: 'Last twenty.',
    body: 'Open questions. Drop them in chat at any point and we will take as many as the hour allows.',
  },
];

const closingFacts = [WEBINAR_DATE_LONG, WEBINAR_TIME, '60 minutes'];

// Manual registration path for when the HubSpot embed never renders. Built from
// the date constant above so a date change stays a single edit.
const REGISTER_MAILTO = `mailto:sam@myarchway.com?subject=${encodeURIComponent(
  `Register me for the ${WEBINAR_DATE_LONG} webinar`
)}`;
---

<ArchwayLayout
  title={`${WEBINAR_TITLE} | Archway + Angela Adams Consulting`}
  description="Get service hours back without hiring, catch the coverage changes that slip through, and find the round-out revenue already in your book. Live September 8, 1:00 PM Eastern."
  ctaText="Save My Seat"
  ctaHref="#hero-form"
  cobrand
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="cobrand">
          <img src="/images/archway-logo.png" alt="Archway" class="cobrand-archway" width="65" height="28" loading="eager" decoding="async" />
          <span class="cobrand-rule" aria-hidden="true"></span>
          <img src="/images/aac-logo.png" alt="Angela Adams Consulting" class="cobrand-aac" width="118" height="28" loading="eager" decoding="async" />
        </div>

        <div class="hero-badge">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Live webinar, {WEBINAR_DATE_LONG}, {WEBINAR_TIME}
        </div>

        <h1>The Work Is Not the Problem. <span class="hl">It&rsquo;s the Hours.</span></h1>

        <p class="hero-sub">Certificates arrive faster than anyone clears them. Policy checking waits for renewal week. Remarketing happens when somebody finds a gap in the day, which is to say it mostly does not.</p>
        <p class="hero-sub hero-sub-second">Angela Bunch and Sam Ruben spend sixty minutes on what changes when those hours come back. Most of it is a live screen, not a slide.</p>

        <div class="hero-facts">
          <span class="hero-fact">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#f48021" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
            60 minutes
          </span>
          <span class="hero-fact">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#f48021" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            30 minutes of live demo
          </span>
          <span class="hero-fact">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#f48021" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            20 minutes of questions
          </span>
        </div>
      </div>

      <div class="hero-form-card" id="hero-form">
        <div class="form-header">
          <h2>Save your seat</h2>
          <p>{WEBINAR_DATE_LONG}. {WEBINAR_TIME}. 60 minutes.</p>
        </div>
        <div id="hs-aac-webinar-form"></div>

        <!-- Two-layer fallback for the HubSpot embed, per PRODUCT.md "no JS-only
             content". The <noscript> copy covers JS-off visitors. The hidden copy
             below is revealed by a timeout in the embed script when JS runs but
             js-na2.hsforms.net is blocked, which ad blockers and privacy
             extensions do routinely. Both give the same manual way to register. -->
        <noscript>
          <div class="form-offline">
            <p class="form-offline-title">The registration form needs JavaScript.</p>
            <p>Email <a href={REGISTER_MAILTO}>sam@myarchway.com</a> and we will put you on the list for the {WEBINAR_DATE_LONG} session.</p>
          </div>
        </noscript>

        <div class="form-offline" id="form-offline" hidden>
          <p class="form-offline-title">The registration form did not load.</p>
          <p>An ad blocker or privacy extension is the usual reason. Email <a href={REGISTER_MAILTO}>sam@myarchway.com</a> and we will put you on the list for the {WEBINAR_DATE_LONG} session.</p>
        </div>

        <p class="form-fallback">Cannot attend live? Register anyway. The recording goes to everyone on the list.</p>
      </div>
    </div>
  </section>

  <script is:inline src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline define:vars={{ FORM_ID }}>
    function _createAacWebinarForm() {
      if (!window.hbspt || !window.hbspt.forms) {
        setTimeout(_createAacWebinarForm, 80);
        return;
      }
      window.hbspt.forms.create({
        portalId: "6869933",
        formId: FORM_ID,
        region: "na2",
        target: "#hs-aac-webinar-form",
        css: "\
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\
          .hs-form { font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .hs-form fieldset { max-width: 100% !important; }\
          .hs-form fieldset.form-columns-2 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-2 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form fieldset.form-columns-3 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-3 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form-field { margin-bottom: 16px; }\
          .hs-form-field > label { display: block; font-size: 15px; font-weight: 600; color: #333333; margin-bottom: 8px; }\
          .hs-form-required { color: #b91c1c; margin-left: 2px; }\
          .hs-input { width: 100% !important; padding: 14px 16px !important; background: #ffffff !important; border: 1px solid #d1d5db !important; border-radius: 8px !important; color: #333333 !important; font-size: 16px !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s, box-shadow 0.2s; }\
          .hs-input:focus { border-color: #f48021 !important; box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.25) !important; }\
          .hs-input::placeholder { color: #9ca3af; }\
          .hs-form-field textarea.hs-input { min-height: 88px; resize: vertical; }\
          .hs-form-booleancheckbox-display, .hs-form-radio-display { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 8px; }\
          .hs-form-radio-display input[type='radio'], .hs-form-booleancheckbox-display input[type='checkbox'] { width: auto !important; margin: 3px 0 0 !important; accent-color: #f48021; }\
          .hs-form-radio-display span, .hs-form-booleancheckbox-display span { font-size: 15px; color: #333333; font-weight: 500; }\
          .inputs-list { list-style: none; padding: 0; margin: 0; }\
          .hs-submit { margin-top: 8px; }\
          .hs-button { width: 100% !important; padding: 16px !important; background: #f48021 !important; color: #32373c !important; font-size: 16px !important; font-weight: 700 !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; border: none !important; border-radius: 8px !important; cursor: pointer; transition: all 0.2s; min-height: 44px; }\
          .hs-button:hover { background: #ff9440 !important; }\
          .hs-error-msgs { list-style: none; padding: 0; margin: 4px 0 0; }\
          .hs-error-msgs li label { font-size: 13px !important; color: #ef4444 !important; font-weight: 500 !important; }\
          .hs-input.error { border-color: #ef4444 !important; }\
          .submitted-message { text-align: center; padding: 30px 10px; font-size: 16px; line-height: 1.55; color: #333333; font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .legal-consent-container { font-size: 13px; color: #5a5f66; line-height: 1.5; margin-top: 8px; }\
          .legal-consent-container a { color: #f48021; }\
          @media (max-width: 480px) { .hs-form fieldset.form-columns-2, .hs-form fieldset.form-columns-3 { flex-direction: column; gap: 0; } }\
        "
      });
    }
    _createAacWebinarForm();

    // If the embed target is still empty after 5s, HubSpot is blocked or down.
    // Reveal the manual registration path rather than leaving an empty card.
    setTimeout(function () {
      var target = document.getElementById("hs-aac-webinar-form");
      var offline = document.getElementById("form-offline");
      if (target && offline && target.children.length === 0) {
        offline.hidden = false;
      }
    }, 5000);
  </script>

  <!-- Section 2: the payoff -->
  <section class="section">
    <div class="section-inner">
      <div class="block-header fade-up">
        <p class="section-label">The Payoff</p>
        <h2>What You Walk Away&nbsp;With</h2>
      </div>

      <div class="card-grid fade-up">
        {payoffs.map((item) => (
          <div class="info-card payoff-card">
            <svg class="payoff-check" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#f48021" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.25"/><polyline points="8 12.3 11 15.2 16.2 9.2"/></svg>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: the capacity problem -->
  <section class="section section-light">
    <div class="section-inner">
      <div class="block-header fade-up">
        <p class="section-label">The Capacity Problem</p>
        <h2>What Is Actually Clogging the&nbsp;Agency</h2>
      </div>

      <div class="card-grid fade-up">
        {problems.map((item) => (
          <div class="info-card">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#f48021" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>

      <p class="closing-line fade-up">None of this is a skills problem. It is a capacity problem, and there are two credible answers to it.</p>
    </div>
  </section>

  <!-- Section 4: navy statement band. No cards by design: this sits between two
       light sections so the argument reads as a hard break, not another grid.
       Editorial split rather than a centered column: the headline and the
       conclusion stay pinned on the left rail while the argument runs down the
       right, so the two ends of it are on screen together. -->
  <section class="section band-navy">
    <div class="section-inner band-grid fade-up">
      <div class="band-rail">
        <p class="section-label section-label-on-dark">Why Both</p>
        <h2>Your Own Tools Are Half the&nbsp;Answer</h2>
      </div>

      <div class="band-body">
        <p class="band-lead">Build AI tools around the way your agency actually works and your team gets faster. That is real, and for some agencies it is enough.</p>
        <p class="band-para">But the team is still in the file. Somebody still has to run the comparison, read the output, decide what it means, and pick up the phone. The work moved, it did not leave.</p>
        <p class="band-para">Put licensed professionals on top of those tools and something different happens. Your team is not doing the work at all. They are waiting on results.</p>
      </div>

      <p class="band-kicker">That is why Angela Bunch and Sam Ruben are on one call instead of two.</p>
    </div>
  </section>

  <!-- Section 5: what you will see -->
  <section class="section">
    <div class="section-inner">
      <div class="block-header fade-up">
        <p class="section-label">What You Will See</p>
        <h2>Three Tools, Live on&nbsp;Screen</h2>
        <p class="block-sub">Roughly thirty minutes of the hour is Sam Ruben demonstrating working software. Not screenshots, not a roadmap. After each tool, Angela Bunch covers how a licensed service team runs it in production.</p>
      </div>

      <div class="card-grid fade-up">
        {tools.map((item) => (
          <div class="info-card tool-card">
            <div class="info-icon">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#f48021" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>

      <p class="closing-line fade-up">Sam will also address the question every agency asks first, which is how any of this interacts with your management system.</p>
    </div>
  </section>

  <!-- Section 6: speakers -->
  <section class="section section-light">
    <div class="section-inner">
      <div class="block-header fade-up">
        <p class="section-label">Speakers</p>
        <h2>Who Is&nbsp;Presenting</h2>
      </div>

      <div class="speaker-grid fade-up">
        <div class="speaker-card">
          <div class="speaker-head">
            <img src="/images/angela-adams.jpg" alt="Angela Bunch" class="speaker-photo" width="88" height="88" loading="lazy" decoding="async" />
            <div class="speaker-id">
              <h3>Angela Bunch</h3>
              <p class="speaker-role">Angela Adams Consulting</p>
            </div>
          </div>
          <p class="speaker-bio">Angela works inside agency service operations every day, and she is the person agencies call when they want a straight answer about where modern technology actually helps. Her firm places licensed insurance professionals directly into agency workflow: certificates, policy checking, quoting, remarketing, and account management. Service billed by the hour and scaled to what the agency needs, rather than a full-time hire the agency has to carry.</p>
          <div class="speaker-mark">
            <img src="/images/aac-logo.png" alt="Angela Adams Consulting" width="126" height="30" loading="lazy" decoding="async" />
          </div>
        </div>

        <div class="speaker-card">
          <div class="speaker-head">
            <img src="/images/sam-ruben.jpg" alt="Sam Ruben" class="speaker-photo" width="88" height="88" loading="lazy" decoding="async" />
            <div class="speaker-id">
              <h3>Sam Ruben</h3>
              <p class="speaker-role">AI and Automation Lead, Archway</p>
            </div>
          </div>
          <p class="speaker-bio">Sam builds custom AI tools for individual agencies. Built once, for one agency, around its carriers, its management system, and its exceptions. His current work runs across Applied Epic, AMS360, Nexsure, and Vertafore. His argument for why custom is short: every agency has its own nuances, and that is not a rounding error, it is the job. What you get is yours, not a version of what the agency down the street is running.</p>
          <div class="speaker-mark">
            <img src="/images/archway-logo.png" alt="Archway" width="69" height="30" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>

      <p class="closing-line fade-up host-line">Hosted by Kevin Young, Archway.</p>
    </div>
  </section>

  <!-- Section 7: how the hour runs -->
  <section class="section">
    <div class="section-inner">
      <div class="block-header fade-up">
        <p class="section-label">How the Hour Runs</p>
        <h2>Sixty&nbsp;Minutes</h2>
      </div>

      <ol class="runsheet fade-up">
        {runsheet.map((item) => (
          <li class="runsheet-item">
            <span class="runsheet-range">{item.range}</span>
            <span class="runsheet-body">{item.body}</span>
          </li>
        ))}
      </ol>

      <p class="runsheet-note fade-up">If you have sat through a webinar where somebody said "next slide please" eleven times, this is not that.</p>
    </div>
  </section>

  <!-- Section 8: closing CTA. Deliberately NOT a second HubSpot embed: the form
       lives in the hero only, and two embeds of the same form ID on one page
       conflict. This button scrolls back up to #hero-form. -->
  <section class="section section-light">
    <div class="section-inner closing-cta fade-up">
      <h2>Save Your&nbsp;Seat</h2>

      <ul class="closing-facts">
        {closingFacts.map((fact) => (
          <li>{fact}</li>
        ))}
      </ul>

      <a href="#hero-form" class="closing-button">Save My Seat</a>

      <p class="closing-note">Cannot attend live? Register anyway and we will send you the recording.</p>
    </div>
  </section>
</ArchwayLayout>

<style>
  /* Co-brand lockup (hero) */
  .cobrand {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    background: var(--white);
    border-radius: 10px;
    padding: 12px 20px;
    margin-bottom: 24px;
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.5);
  }

  .cobrand-archway {
    display: block;
    height: 34px;
    width: auto;
  }

  .cobrand-aac {
    display: block;
    height: 34px;
    width: auto;
  }

  .cobrand-rule {
    width: 1px;
    height: 30px;
    background: var(--border);
    display: block;
  }

  .hero-sub-second {
    margin-bottom: 26px;
  }

  /* Hero fact strip */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-fact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50px;
    padding: 7px 15px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.86);
  }

  /* Hero form card: fallback shown when the HubSpot embed never renders.
     Styled as a quiet panel inside the card, not an error banner. */
  .form-offline {
    padding: 20px;
    background: var(--light-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .form-offline[hidden] {
    display: none;
  }

  .form-offline p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  .form-offline .form-offline-title {
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .form-offline a {
    color: var(--orange-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Section headers */
  .block-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .block-header h2 {
    font-size: 34px;
    line-height: 1.25;
    text-wrap: balance;
    margin-bottom: 16px;
  }

  .block-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0;
    text-wrap: pretty;
  }

  .section-label {
    display: inline-flex;
  }

  /* Card grids */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .info-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 30px 26px;
  }

  .info-icon {
