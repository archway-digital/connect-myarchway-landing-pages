---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroLeadMagnet from '../components/shared/HeroLeadMagnet.astro';
import ProblemCardsThree from '../components/shared/ProblemCardsThree.astro';
import NumberedCardsList from '../components/shared/NumberedCardsList.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Free Marketing Performance Mid-Year Guide for Independent Insurance Agencies | Archway"
  description="Download the free marketing performance mid-year guide. Website traffic, local search, email performance, and three Q3 priorities. Written for agency owners."
  ctaText="Get the Free Guide"
  ctaHref="#hero-form"
>
  <HeroLeadMagnet
    badge="Marketing Performance  ·  June 2026"
    headline="Is Your Agency&rsquo;s Marketing on Track for 2026? <span class='hl'>Find Out at the Halfway&nbsp;Point.</span>"
    subhead="Download the free guide and find out what your website, local search presence, and email outreach are actually doing, and what to fix before renewal season peaks."
    body1="Most independent agency owners set marketing goals at the start of the year and do not look at them again until Q4 when they are trying to explain why they were not hit. The halfway point is when checking actually matters. There is still time to fix what is not working before Q3."
    body2="This guide covers four areas in plain language. What to look at, what the numbers mean, and the three highest-impact changes to make before renewal season. Written for agency owners, not marketers."
    formHeading="Get Your Free Marketing Guide"
    formSubhead="We will send it to your inbox right away."
    formId="37e242b1-e97b-45d8-878d-f6a0b3a0a0a0"
    trustLine="No spam. No sales call unless you want one. Just the guide."
  />

  <ProblemCardsThree
    sectionLabel="Where Most Agencies Find Gaps"
    heading="Three Marketing Problems <br /><span class='hl'>Most Agencies Have Not&nbsp;Diagnosed.</span>"
    subhead="The agencies showing up in local search in August did the marketing work in May and June. The ones that struggle in Q3 did not."
    cards={[
      {
        title: "Not Showing Up When Someone Searches Nearby",
        body: "Local SEO determines whether your agency appears when a prospect searches for insurance in your area. AI-powered search is now pulling in your Google Business Profile activity, your social posts, and your review responses to decide who to surface. Most agencies have not set this up correctly and have no idea what they are missing."
      },
      {
        title: "A Website That Loses Visitors Before They Act",
        body: "Three-second load times lose half the visitors who arrive on mobile. No tap-to-call link. Contact form buried three pages deep. These are fixable problems that most agency owners do not know exist because nobody has ever tested the site on a phone."
      },
      {
        title: "Email That Burns Through the List",
        body: "Open rates declining. Click rates near zero. A list of contacts who have tuned out because every email says the same thing. This is fixable before the list is fully disengaged, but it requires looking at the numbers first."
      }
    ]}
  />

  <NumberedCardsList
    sectionLabel="What the Guide Covers"
    heading="Four Sections. What to Measure, What It Means, <br />and <span class='hl'>What to&nbsp;Fix.</span>"
    cards={[
      {
        title: "Website Traffic and Leads",
        body: "The three numbers that actually matter in Google Analytics, what each one means for an insurance agency, and what to do if any of them are off. Includes benchmarks for each metric."
      },
      {
        title: "Local Search Visibility",
        body: "What local SEO means for an independent insurance agency, how to check whether you are showing up when someone searches nearby, and the highest-impact changes to make in under an hour."
      },
      {
        title: "Email and Outreach Performance",
        body: "What open rates, click rates, and unsubscribe rates are telling you, what counts as a good result for an insurance agency audience, and how to know if your list is burning out before it is too late to fix."
      },
      {
        title: "Three Q3 Priorities",
        body: "The three highest-impact marketing changes an agency can make in the next 30 days. Each one includes a time estimate and expected outcome. Most agencies can address all three before July."
      }
    ]}
  />

  <StatsBar />
  <AboutArchway />
  <WhyChooseUs />
  <Testimonials />

  <BottomCTA
    heading="Ready to Find Out What Your Agency's Marketing Is Actually Doing?"
    subtext="Download the free guide and get a clear picture of where your digital presence stands and what to fix before renewal season."
    ctaText="Get the Free Guide"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.problem-header h2 .hl) {
    color: var(--orange);
  }
</style>
