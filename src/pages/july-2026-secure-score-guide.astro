---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroGatedReveal from '../components/shared/HeroGatedReveal.astro';
import ProblemCardsThree from '../components/shared/ProblemCardsThree.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';

const FORM_ID = 'a25f33ac-dd5d-4af5-a861-25805cbfdb9d'; // TODO: swap for this page's own HubSpot form ID before launch
---

<ArchwayLayout
  title="Free Microsoft Secure Score Guide for Independent Insurance Agencies | Archway"
  description="Download the free Microsoft Secure Score guide. What the score is, what a low score means at renewal, and what typical agency gaps look like. Written for agency owners."
  ctaText="Get the Free Guide"
  ctaHref="#hero-form"
>
  <HeroGatedReveal
    badge="For Agencies on Microsoft 365"
    headline="Microsoft already scored your security. <span class='hl'>Can you read the&nbsp;number?</span>"
    subhead="Your Microsoft 365 tenant has a Secure Score whether you have looked at it or not. Here is what it means."
    formHeading="Get the Free Guide"
    formSubhead="Fill this out and the guide opens right here on the page."
    formId={FORM_ID}
    trustLine="Written for independent insurance agencies on Microsoft 365."
    revealHeading="Your guide is unlocked"
  >
    <h2 class="g-title">Your Microsoft 365 Secure Score, Explained</h2>
    <p class="g-lead">Reference content, not a download. Here is what the number means and what to do about it.</p>

    <h3 class="g-sub">What Secure Score is</h3>
    <p>Microsoft scores every Microsoft 365 tenant based on your settings, your user policies, and your security posture, then gives you a number and a prioritized list of what is dragging it down. Most agencies have never seen theirs, and a lot of IT providers never raise it.</p>

    <h3 class="g-sub">What a low score means at renewal</h3>
    <p>The score maps almost directly to the questions cyber liability carriers now ask: MFA enforcement, admin account protection, legacy protocol settings. A documented, measurable score is exactly the kind of proof those questionnaires want. A low score is a starting point. Not knowing the number is the harder position to defend.</p>

    <h3 class="g-sub">Typical agency gaps</h3>
    <p>The same handful of settings quietly drag agency scores down. MFA enabled but not enforced. Standing admin access that should be limited. Legacy sign-in protocols left on. None of it is cause for embarrassment, and most of it is straightforward to address.</p>

    <h3 class="g-sub">What is worth fixing first</h3>
    <p>A few high-impact, low-disruption changes move the number most without touching how your team works day to day. We will tell you which ones apply to your tenant.</p>

    <div class="g-cta">
      <h3>Want to know your number before your next renewal?</h3>
      <p>We will run your Secure Score with you in about 30 minutes and walk through the results in plain terms.</p>
      <a class="g-cta-btn" href="/book-compliance-review">Book a Secure Score review</a>
    </div>
  </HeroGatedReveal>

  <section class="context-section">
    <div class="context-inner fade-up">
      <div class="context-aside">
        <span class="context-eyebrow">Why this matters</span>
        <h2 class="context-lead">Most agencies have never seen their own Secure&nbsp;Score.</h2>
      </div>
      <div class="context-body">
        <p>Secure Score evaluates your tenant settings, user policies, and security posture, then gives you <strong>a number and a prioritized list of what is dragging it down.</strong> Most agencies have never seen theirs, and a lot of IT providers never bring it up.</p>
        <p>This guide explains what the score is, what a low one signals when a cyber liability carrier reviews your renewal, and what typical agency gaps look like. A low score is a starting point. Not knowing the number is the harder position to defend.</p>
      </div>
    </div>
  </section>

  <ProblemCardsThree
    sectionLabel="What the Guide Covers"
    heading="Four Things to Understand <br /><span class='hl'>About Your Secure&nbsp;Score.</span>"
    subhead="A plain-terms read on the number Microsoft already calculated for your tenant."
    cards={[
      {
        title: "What the score is",
        body: "A plain-terms explanation of Secure Score, where Microsoft gets it, and why the number moves over time."
      },
      {
        title: "What a low score means at renewal",
        body: "How the score maps to the questions cyber liability carriers now ask, and why a documented number is the kind of proof those questionnaires want."
      },
      {
        title: "Typical agency gaps",
        body: "The common settings that quietly drag agency scores down. MFA enforcement, admin account protection, and legacy protocols."
      },
      {
        title: "What is worth fixing first",
        body: "Which improvements move the number most without major changes to your environment, and which can wait."
      }
    ]}
  />

  <StatsBar />
  <AboutArchway />
  <WhyChooseUs />
  <Testimonials />

  <BottomCTA
    heading="Want to Know Your Score Before Your Next Renewal?"
    subtext="Download the guide, or book a free 30-minute Secure Score review and we will run it with you."
    ctaText="Get the Free Guide"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.problem-header h2 .hl) { color: var(--orange); }
  .context-section { background: var(--light-bg); padding: 72px 24px; }
  .context-inner { max-width: 1040px; margin: 0 auto; display: grid; grid-template-columns: 0.82fr 1.18fr; gap: 56px; align-items: start; }
  .context-aside { border-left: 3px solid var(--orange); padding-left: 24px; }
  .context-eyebrow { display: block; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--orange); margin-bottom: 16px; }
  .context-lead { font-size: 27px; font-weight: 800; color: var(--charcoal); line-height: 1.25; letter-spacing: -0.5px; margin: 0; }
  .context-body p { font-size: 17px; line-height: 1.8; color: var(--text-light); margin: 0 0 18px; }
  .context-body p strong { color: var(--charcoal); font-weight: 700; }
  .context-body p:last-child { margin-bottom: 0; }
  @media (max-width: 860px) {
    .context-inner { grid-template-columns: 1fr; gap: 24px; }
    .context-aside { border-left: none; padding-left: 0; border-top: 3px solid var(--orange); padding-top: 20px; }
    .context-lead { font-size: 23px; }
  }
  .g-title { font-size: 30px; font-weight: 800; color: var(--charcoal); line-height: 1.25; margin-bottom: 16px; letter-spacing: -0.5px; }
  .g-lead { font-size: 18px; line-height: 1.6; color: var(--text-light); margin-bottom: 24px; }
  .g-sub { font-size: 20px; font-weight: 800; color: var(--charcoal); margin: 28px 0 8px; line-height: 1.3; }
  .gated-inner p:not(.g-lead) { font-size: 16px; line-height: 1.7; color: var(--text-light); margin-bottom: 14px; }
  .g-cta { background: var(--navy); border-radius: 14px; padding: 32px 36px; margin-top: 36px; }
  .g-cta h3 { font-size: 24px; font-weight: 800; color: #ffffff; margin-bottom: 10px; line-height: 1.3; }
  .g-cta p { font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.8) !important; margin-bottom: 20px; }
  .g-cta-btn { display: inline-block; background: var(--orange); color: #ffffff; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: 700; transition: background 0.2s; }
  .g-cta-btn:hover { background: var(--orange-dark); }
  @media (max-width: 768px) { .g-title { font-size: 25px; } }
</style>
