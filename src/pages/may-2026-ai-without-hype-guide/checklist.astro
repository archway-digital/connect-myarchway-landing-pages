---
import ArchwayLayout from '../../layouts/ArchwayLayout.astro';

const HUBSPOT_PORTAL_ID = '6869933';
const HUBSPOT_FORM_ID = 'a33bc075-29f1-4831-b624-06bb317d9bac';

const section1 = {
  number: '01',
  title: 'AI Awareness',
  subtitle: 'Establish your baseline.',
  intro: 'What do you actually know about AI in your agency right now? This section establishes your baseline before any tool evaluation or implementation planning begins.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's1q1',
      title: 'Current AI usage',
      body: 'I can name at least one specific AI tool or workflow my agency is currently using, not just general tools used occasionally.'
    },
    {
      key: 's1q2',
      title: 'Insurance vs. general AI',
      body: 'I understand the difference between tools built for insurance agencies and general-purpose AI. Insurance-specific tools integrate with your AMS. General-purpose tools do not.'
    },
    {
      key: 's1q3',
      title: 'AMS platform knowledge',
      body: 'I know which AMS my agency runs and whether it supports AI or workflow automation. Applied, HawkSoft, EZLynx, and Vertafore all support some level of automation.'
    },
    {
      key: 's1q4',
      title: 'Shadow AI awareness',
      body: 'My staff is not using AI tools I am unaware of to handle client data. Shadow AI adoption is a compliance and security risk. If you are unsure, leave this unchecked.'
    },
    {
      key: 's1q5',
      title: 'Staff input gathered',
      body: 'I have asked my staff what repetitive tasks they wish were automated. This is the most important conversation most agency owners have not had yet.'
    },
    {
      key: 's1q6',
      title: 'Success defined',
      body: 'I can describe what a successful AI implementation looks like for my agency in specific terms: hours saved, documents produced, tasks eliminated.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'Strong awareness', body: 'Move on to Section 2.' },
    { range: '2–3 unchecked', title: 'Foundational gaps', body: 'Review the AI guide before evaluating tools.' },
    { range: '4+ unchecked', title: 'Start with education', body: 'Get grounded, then return to this checklist.' }
  ]
};

const section2 = {
  number: '02',
  title: 'Implementation Readiness',
  subtitle: 'Are you set up to actually implement?',
  intro: 'Readiness is the prerequisite. Buying a tool before your agency is ready to implement it creates more problems than it solves.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's2q1',
      title: 'Clean AMS data',
      body: 'My agency’s data in the AMS is reasonably clean and consistently structured. AI tools are only as good as the data they connect to.'
    },
    {
      key: 's2q2',
      title: 'Internal owner identified',
      body: 'I have at least one staff member who could own an AI implementation project. Does not need to be technical, just someone who will follow through.'
    },
    {
      key: 's2q3',
      title: 'Budget range established',
      body: 'I have a budget range in mind, even if approximate. Most implementations cost between $200 and $2,000 per month depending on scope.'
    },
    {
      key: 's2q4',
      title: 'Bandwidth available',
      body: 'My agency has bandwidth to spend 4 to 8 hours on implementation in the next 30 days. This is the realistic minimum for a first implementation.'
    },
    {
      key: 's2q5',
      title: 'Testing period understood',
      body: 'I understand that AI implementation requires a testing period before full deployment. Tools that go live without testing create more problems than they solve.'
    },
    {
      key: 's2q6',
      title: 'Error reporting process',
      body: 'I have a process for staff to report when an AI tool produces incorrect output. Human review is required for any AI output that affects a client or a policy.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'Ready to implement', body: 'Move on to Section 3.' },
    { range: '2–3 unchecked', title: 'Address gaps first', body: 'Focus on data quality and ownership before tool evaluation.' },
    { range: '4+ unchecked', title: 'Do not buy a tool yet', body: 'Readiness is the prerequisite. Get this section mostly checked first.' }
  ]
};

const section3 = {
  number: '03',
  title: 'High-Value Starting Points',
  subtitle: 'Where automation will move the needle.',
  intro: 'Which of these workflows is costing your agency the most staff hours right now? Check every item that applies, your checked items are where automation would have the highest immediate impact.',
  countLabel: 'checked',
  items: [
    {
      key: 's3q1',
      title: 'Manual document production',
      body: 'My staff produces certificates of insurance, renewal letters, or policy summaries manually. Document generation automation is the highest-priority starting point for most agencies.'
    },
    {
      key: 's3q2',
      title: 'Manual call logging',
      body: 'My agency manually logs call notes or activities into the AMS after phone calls. Call recording to AMS activity creation eliminates this entirely.'
    },
    {
      key: 's3q3',
      title: 'Manual commission entry',
      body: 'My agency processes carrier commission statements manually each month. Automatic commission statement entry is one of the fastest ROI implementations available.'
    },
    {
      key: 's3q4',
      title: 'Manual renewal follow-up',
      body: 'My staff spends time on renewal follow-up that could be automated. Renewal sequences configured in your AMS run without staff intervention once set up.'
    },
    {
      key: 's3q5',
      title: 'Manual reporting',
      body: 'My agency generates regular reports that require pulling data from more than one system. AI reporting automation eliminates the aggregation step.'
    },
    {
      key: 's3q6',
      title: 'Repetitive inbound',
      body: 'My agency has inbound calls or emails that follow predictable, repetitive patterns. Triage and routing automation handles this without replacing complex conversations.'
    },
    {
      key: 's3q7',
      title: 'Missing SOPs',
      body: 'My agency does not have written SOPs for at least three of its most common workflows. SOP generators produce first drafts from recordings or transcripts in minutes.'
    }
  ],
  bands: [
    { range: '1–2 checked', title: 'Start with the costliest', body: 'Pick the one that costs the most staff hours per week.' },
    { range: '3–4 checked', title: 'Multiple starting points', body: 'Prioritize by staff hours saved and AMS connection.' },
    { range: '5+ checked', title: 'Significant opportunity', body: 'Book a call to build a sequenced plan.' }
  ]
};
---

<ArchwayLayout
  title="AI Without the Hype Checklist | Archway"
  description="Interactive AI readiness checklist for independent insurance agencies. Evaluate where you stand and find your best starting point."
  ctaText="Save My Results"
  ctaHref="#save-form"
>
  <!-- Hero -->
  <section class="checklist-hero">
    <div class="checklist-hero-inner">
      <div class="hero-badge">AI Without the Hype  ·  May 2026</div>
      <p class="kicker">A Practical Checklist  ·  For Independent Agencies</p>
      <h1>AI Without the <em>Hype.</em><br />A practical checklist for independent insurance&nbsp;agencies.</h1>
      <p class="hero-sub">Evaluate your AI readiness and find your best starting point.</p>
      <p class="hero-intro">This checklist covers the areas where most agencies leave time and opportunity on the table. Work through each section, check the boxes that apply, and use the scoring guide at the end to identify your next step.</p>
    </div>
  </section>

  <!-- How to use -->
  <section class="how-to-use">
    <div class="how-to-inner">
      <p class="how-label">How to Use This Checklist</p>
      <div class="how-steps">
        <div class="how-step">
          <div class="how-num">1</div>
          <div class="how-text">
            <strong>Work through each section.</strong>
            <p>Three in total: Awareness, Readiness, and Starting Points.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">2</div>
          <div class="how-text">
            <strong>Check the box if your agency has it in place.</strong>
            <p>Leave it unchecked if it isn’t done, or you’re unsure.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">3</div>
          <div class="how-text">
            <strong>Use the scoring guide at the end.</strong>
            <p>Your unchecked items show where to focus next.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {[section1, section2, section3].map((section) => (
    <section id={`section-${section.number}`} class={`checklist-section section-${section.number}`} data-section={section.number} data-count-label={section.countLabel}>
      <div class="checklist-inner">
        <div class="section-header">
          <span class="section-pill">Section {section.number}</span>
          <h2>{section.title}</h2>
          <p class="section-sub">{section.subtitle}</p>
          <p class="section-intro">{section.intro}</p>
        </div>

        <div class="checklist-items">
          {section.items.map((item, i) => (
            <label class="check-item" for={item.key}>
              <input type="checkbox" id={item.key} data-section={section.number} data-title={item.title} />
              <span class="check-box" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 8 7 12 13 4"/></svg>
              </span>
              <div class="check-content">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="check-num">{String(i + 1).padStart(2, '0')}</div>
            </label>
          ))}
        </div>

        <div class="scoring-block" data-section-score={section.number}>
          <p class="scoring-label">Section {parseInt(section.number)} Scoring Guide  ·  Count {section.countLabel} items</p>
          <div class="scoring-bands">
            {section.bands.map((band, i) => (
              <div class="scoring-band" data-band-index={i}>
                <div class="band-num">{i + 1}</div>
                <div class="band-content">
                  <p class="band-range">{band.range}  ·  <strong>{band.title}</strong></p>
                  <p class="band-body">{band.body}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="live-tally">
            <span class="live-tally-label">Your section score:</span>
            <span class="live-tally-num" data-tally={section.number}>0</span>
            <span class="live-tally-suffix">{section.countLabel}</span>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Final Result -->
  <section class="result-section">
    <div class="result-inner">
      <p class="result-label">Your Result  ·  Scoring Guide</p>
      <h2>Count your unchecked items across <em>Sections 1 &amp; 2.</em></h2>
      <p class="result-sub">That is your readiness score. Find your band below, it tells you the single highest-leverage move to make next.</p>

      <div class="result-card">
        <div class="result-tally">
          <p class="result-tally-label">Total Unchecked</p>
          <div class="result-tally-num"><span data-final-tally>0</span><span class="tally-divider">/12</span></div>
          <p class="result-tally-sub">Sections 1 (Awareness) + 2 (Readiness)</p>
        </div>
        <div class="result-formula">
          <p class="result-formula-label">Tally Your Score</p>
          <div class="formula-row">
            <span class="formula-num" data-section-tally="01">0</span>
            <span class="formula-op">+</span>
            <span class="formula-num" data-section-tally="02">0</span>
            <span class="formula-op">=</span>
            <span class="formula-num" data-final-tally>0</span>
          </div>
          <p class="result-formula-sub">Section 1 unchecked + Section 2 unchecked = Total. The active band below is the one you fall into.</p>
        </div>
      </div>

      <div class="result-bands">
        <div class="result-band" data-band="0-3">
          <p class="result-band-range">0–3 Unchecked</p>
          <h3>Strong Foundation</h3>
          <p>You have the basics in place. Your next step is identifying the single highest-value workflow to automate and evaluating two to three tools specifically for that problem.</p>
          <p class="result-band-action">Now look at what you checked in <strong>Section 3</strong>, those are your starting points.</p>
        </div>
        <div class="result-band" data-band="4-9">
          <p class="result-band-range">4–9 Unchecked</p>
          <h3>Ready to Start</h3>
          <p>You have some gaps but you are not starting from zero. Focus on Section 3, your unchecked items there are your highest-priority starting points. Pick one and begin.</p>
          <p class="result-band-action">Focus on <strong>Section 3</strong>. Your checked items are where to begin.</p>
        </div>
        <div class="result-band" data-band="10+">
          <p class="result-band-range">10+ Unchecked</p>
          <h3>Build the Foundation</h3>
          <p>Start with Section 2. Implementation readiness is the prerequisite for everything else. Get data clean, identify an internal owner, and confirm AMS capabilities first.</p>
          <p class="result-band-action">Work through <strong>Section 2</strong> first, then come back to <strong>Section 3</strong>.</p>
        </div>
      </div>

      <div class="section3-callout">
        <p class="section3-callout-label">Your Section 3 Results</p>
        <h3>What you checked in <em>Section 3</em> is where we start.</h3>
        <p>Every item you checked in Section 3 is a workflow Archway has automated for an independent insurance agency. We have built the call recording to AMS activity creation. We have built the commission statement automation. We have built the document generation workflows, the renewal sequences, and the SOP generators.</p>
        <p>Sam Ruben leads AI implementation at Archway. He works exclusively with independent insurance agencies and has built these automations for agencies your size.</p>
        <p><strong>If you checked two or more items in Section 3, a 30-minute call with Sam is worth your time.</strong> He will look at what you checked, tell you which one delivers the fastest ROI for an agency like yours, and walk you through what implementation actually looks like.</p>
      </div>
    </div>
  </section>

  <!-- Save Form -->
  <section class="save-section" id="save-form">
    <div class="save-inner">
      <div class="save-header">
        <p class="save-label">Save Your Results</p>
        <h2>Send your checklist to your inbox and to&nbsp;Sam.</h2>
        <p class="save-sub">Get a copy of your results plus a personalized recommendation based on what you checked. No pitch, just an honest look at where to start.</p>
      </div>

      <div class="save-form-card">
        <div id="hs-checklist-form"></div>
        <p class="save-trust">Archway works exclusively with independent insurance agencies.</p>
      </div>
    </div>
  </section>

  <!-- Pass form config to client script -->
  <script is:inline define:vars={{ HUBSPOT_PORTAL_ID, HUBSPOT_FORM_ID }}>
    window.__HS_CHECKLIST_CONFIG__ = { portalId: HUBSPOT_PORTAL_ID, formId: HUBSPOT_FORM_ID };
  </script>
</ArchwayLayout>

<style>
  /* HERO */
  .checklist-hero {
    background-color: #1e3350;
    background-image: url('/images/dark-bg.png');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
    padding: 80px 24px 60px;
    position: relative;
  }

  .checklist-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(29, 50, 70, 0.88);
    z-index: 0;
  }

  .checklist-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 50px;
    margin-bottom: 28px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .kicker {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .checklist-hero h1 {
    font-size: 52px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .checklist-hero h1 em {
    font-style: normal;
    color: var(--orange);
  }

  .hero-sub {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 24px;
    line-height: 1.4;
  }

  .hero-intro {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 780px;
  }

  /* HOW TO USE */
  .how-to-use {
    background: #ffffff;
    padding: 56px 24px;
  }

  .how-to-inner {
    max-width: 1000px;
    margin: 0 auto;
    border: 1px solid var(--orange);
    border-left-width: 4px;
    border-radius: 12px;
    padding: 28px 32px;
    background: rgba(244, 128, 33, 0.02);
  }

  .how-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .how-step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .how-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: var(--orange);
    color: #ffffff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
  }

  .how-text strong {
    display: block;
    font-size: 15px;
    color: var(--charcoal);
    font-weight: 700;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .how-text p {
    font-size: 14px;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0;
  }

  /* CHECKLIST SECTION */
  .checklist-section {
    background: #ffffff;
    padding: 48px 24px;
  }

  .checklist-section.section-02 {
    background: var(--light-bg);
  }

  .checklist-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .section-pill {
    display: inline-block;
    background: var(--orange);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 6px;
    margin-bottom: 16px;
  }

  .section-header h2 {
    font-size: 40px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.2;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .section-sub {
    font-size: 16px;
    font-weight: 700;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .section-intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-light);
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 24px;
    margin: 0;
  }

  /* CHECK ITEMS */
  .checklist-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }

  .check-item {
    display: grid;
    grid-template-columns: 24px 1fr 36px;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 24px;
    background: #ffffff;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    position: relative;
  }

  .checklist-section.section-02 .check-item {
    background: #ffffff;
  }

  .check-item:hover {
    border-color: rgba(244, 128, 33, 0.5);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .check-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .check-box {
    width: 24px;
    height: 24px;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    transition: all 0.15s;
    flex-shrink: 0;
  }

  .check-item:has(input:checked) {
    border-color: var(--orange);
    background: rgba(244, 128, 33, 0.04);
  }

  .check-item:has(input:checked) .check-box {
    background: var(--orange);
    border-color: var(--orange);
    color: #ffffff;
  }

  .check-content h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .check-content p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  .check-num {
    font-size: 13px;
    font-weight: 700;
    color: #cbd5e1;
    text-align: right;
    line-height: 1.4;
    align-self: flex-start;
  }

  /* SCORING BLOCK */
  .scoring-block {
    border: 1px solid var(--orange);
    border-left-width: 4px;
    border-radius: 12px;
    padding: 24px 28px;
    background: rgba(244, 128, 33, 0.02);
  }

  .scoring-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
  }

  .scoring-bands {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  .scoring-band {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--card-border);
    transition: all 0.2s;
  }

  .scoring-band[data-band-index="0"] .band-num {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
  }

  .scoring-band[data-band-index="1"] .band-num {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
  }

  .scoring-band[data-band-index="2"] .band-num {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
  }

  .scoring-band.active {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.15);
  }

  .band-num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
  }

  .band-range {
    font-size: 13px;
    color: var(--text-light);
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .band-range strong {
    color: var(--charcoal);
  }

  .band-body {
    font-size: 13px;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0;
  }

  .live-tally {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    background: var(--charcoal);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 14px;
  }

  .live-tally-label {
    color: rgba(255, 255, 255, 0.7);
  }

  .live-tally-num {
    font-size: 22px;
    font-weight: 800;
    color: var(--orange);
  }

  .live-tally-suffix {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* RESULT SECTION */
  .result-section {
    background: #ffffff;
    padding: 80px 24px;
  }

  .result-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .result-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
    text-align: center;
  }

  .result-section h2 {
