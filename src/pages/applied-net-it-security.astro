---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';

// HubSpot form: Meeting - Event - Applied Net 2026 (portal 6869933, region na2).
// Same form as the /applied-net-2026 hero and /applied-net-meeting.
const FORM_ID = '07c32a63-99be-47bf-8b57-10a373403196';
const FALLBACK_MAILTO = 'mailto:info@myarchway.com?subject=Applied%20Net%202026%20meeting';
---

<ArchwayLayout
  title="IT and Cybersecurity at Applied Net 2026 | Archway Computer"
  description="Twenty minutes with Archway on agency security, carrier documentation, managed IT, and hosted Applied Epic and AMS360 migrations. Booth 131. A $100 Visa gift card for the time, first 20 meetings booked."
  ctaText="Book My Meeting"
  ctaHref="#hero-form"
>

  <section class="hero dossier-hero">
    <div class="redaction-stack" aria-hidden="true">
      <span class="bar"></span>
      <span class="bar accent"></span>
      <span class="bar"></span>
    </div>

    <div class="hero-inner">
      <div class="hero-text">
        <div class="file-tag mono">ARCHWAY // FILE DIVISION &middot; FILE NO. AWX-2026-016</div>
        <div class="halftone-strip" aria-hidden="true"></div>
        <div class="hero-badge">APPLIED NET 2026 &middot; BOOTH 131</div>
        <h1>Your agency has the security. The open question is what you can <span class="hl">prove</span>.</h1>
        <p class="hero-sub">Twenty minutes with the two people handling IT and cybersecurity at booth 131. A $100 Visa gift card for the time. First 20 meetings booked.</p>
        <p class="hero-intro">Carriers, regulators, and larger commercial clients have stopped accepting a description of your security and started asking for evidence of it. That is a different problem, and a more expensive one to answer under deadline.</p>
        <p class="hero-trust">Archway works exclusively with independent insurance agencies.</p>

        <div class="hero-strip">
          <div class="ink-stamp" aria-hidden="true">
            <span class="mono">FILE<br />OPEN</span>
          </div>
          <p class="case-tag mono">SEPTEMBER 28 TO OCTOBER 1, 2026<br />GAYLORD NATIONAL RESORT &middot; NATIONAL HARBOR, MARYLAND</p>
        </div>
      </div>

      <div class="hero-form-card" id="hero-form">
        <div class="form-tab mono">CASE FILE: INTAKE</div>
        <div class="form-header">
          <h2>Request your twenty minutes</h2>
          <p>Send this and we will call you to set the time. Booth 131 during the show, or by video after it. Both qualify for the gift card.</p>
        </div>

        <div id="hs-applied-net-form"></div>

        <noscript>
          <div class="form-offline">
            <p class="form-offline-title">The booking form needs JavaScript.</p>
            <p>Email <a href={FALLBACK_MAILTO}>info@myarchway.com</a> with your agency name and the topic you want to cover, and we will set the time by reply.</p>
          </div>
        </noscript>

        <div class="form-offline" id="form-offline" hidden>
          <p class="form-offline-title">The booking form did not load.</p>
          <p>An ad blocker or privacy extension is the usual reason. Email <a href={FALLBACK_MAILTO}>info@myarchway.com</a> with your agency name and the topic you want to cover, and we will set the time by reply.</p>
        </div>

        <p class="form-fallback">Show week already full? Request the time anyway. We will schedule it by video after the conference.</p>
      </div>
    </div>
  </section>

  <script is:inline src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline define:vars={{ FORM_ID }}>
    function _createAppliedNetForm() {
      if (!window.hbspt || !window.hbspt.forms) {
        setTimeout(_createAppliedNetForm, 80);
        return;
      }
      window.hbspt.forms.create({
        portalId: "6869933",
        formId: FORM_ID,
        region: "na2",
        target: "#hs-applied-net-form",
        css: "\
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\
          .hs-form { font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .hs-form fieldset { max-width: 100% !important; }\
          .hs-form fieldset.form-columns-2 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-2 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form fieldset.form-columns-3 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-3 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form-field { margin-bottom: 16px; }\
          .hs-form-field > label { display: block; font-size: 15px; font-weight: 600; color: #333333; margin-bottom: 8px; }\
          .hs-form-required { color: #b91c1c; margin-left: 2px; }\
          .hs-input { width: 100% !important; padding: 14px 16px !important; background: #ffffff !important; border: 1px solid #d1d5db !important; border-radius: 8px !important; color: #333333 !important; font-size: 16px !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s, box-shadow 0.2s; }\
          .hs-input:focus { border-color: #f48021 !important; box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.25) !important; }\
          .hs-input::placeholder { color: #9ca3af; }\
          .hs-form-field textarea.hs-input { min-height: 88px; resize: vertical; }\
          .hs-form-field select.hs-input { appearance: auto; }\
          .hs-form-booleancheckbox-display, .hs-form-radio-display { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 8px; }\
          .hs-form-radio-display input[type='radio'], .hs-form-booleancheckbox-display input[type='checkbox'] { width: auto !important; margin: 3px 0 0 !important; accent-color: #f48021; }\
          .hs-form-radio-display span, .hs-form-booleancheckbox-display span { font-size: 15px; color: #333333; font-weight: 500; }\
          .inputs-list { list-style: none; padding: 0; margin: 0; }\
          .hs-submit { margin-top: 8px; }\
          .hs-button { width: 100% !important; padding: 16px !important; background: #f48021 !important; color: #32373c !important; font-size: 16px !important; font-weight: 700 !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; border: none !important; border-radius: 8px !important; cursor: pointer; transition: all 0.2s; min-height: 44px; }\
          .hs-button:hover { background: #ff9440 !important; }\
          .hs-error-msgs { list-style: none; padding: 0; margin: 4px 0 0; }\
          .hs-error-msgs li label { font-size: 13px !important; color: #ef4444 !important; font-weight: 500 !important; }\
          .hs-input.error { border-color: #ef4444 !important; }\
          .submitted-message { text-align: center; padding: 30px 10px; font-size: 16px; line-height: 1.55; color: #333333; font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .legal-consent-container { font-size: 13px; color: #5a5f66; line-height: 1.5; margin-top: 8px; }\
          .legal-consent-container a { color: #a84e08; }\
          @media (max-width: 480px) { .hs-form fieldset.form-columns-2, .hs-form fieldset.form-columns-3 { flex-direction: column; gap: 0; } }\
        "
      });
    }
    _createAppliedNetForm();

    // If the embed target is still empty after 5s, HubSpot is blocked or down.
    // Reveal the manual booking path rather than leaving an empty card.
    setTimeout(function () {
      var target = document.getElementById("hs-applied-net-form");
      var offline = document.getElementById("form-offline");
      if (target && offline && target.children.length === 0) {
        offline.hidden = false;
      }
    }, 5000);
  </script>

  <!-- The proof problem -->
  <section class="section">
    <div class="section-inner narrow-inner">
      <p class="section-label">The Proof Problem</p>
      <h2>Description used to be enough. It is not enough now.</h2>

      <p class="lede">This is the conversation Brad is having most often right now, and it rarely starts as a security conversation. It starts as a form.</p>

      <p class="body-copy">A carrier sends a cyber questionnaire. A state regulator asks for the documentation behind a certification the agency already filed. A larger commercial prospect routes the agency through a vendor security review before it will move the account. Every one of those asks for the same thing, and it is not a description of what the agency does. It is evidence of what the agency has in place.</p>

      <p class="body-copy">Most agencies have the security. Multifactor authentication is on. Backups are running. Somebody handled the endpoint work two years ago. Far fewer agencies can produce the artifacts when someone asks for them, which is a different problem and a more expensive one. It arrives on a deadline set by the person asking, and the answer that gets assembled in a hurry is usually the answer that costs the most.</p>

      <div class="proof-split">
        <div class="proof-col">
          <span class="proof-kicker mono">WHAT MOST AGENCIES HAVE</span>
          <ul class="proof-list">
            <li>Controls that were configured correctly at some point</li>
            <li>A provider who says the backups are running</li>
            <li>An honest belief that the agency is in reasonable shape</li>
          </ul>
        </div>
        <div class="proof-col accent">
          <span class="proof-kicker mono">WHAT IS BEING ASKED FOR</span>
          <ul class="proof-list">
            <li>A questionnaire answered accurately, line by line, with the configuration to back it</li>
            <li>A restore that somebody actually tested and dated</li>
            <li>Documentation that holds up when a third party reads it closely</li>
          </ul>
        </div>
      </div>

      <p class="body-copy">Twenty minutes is enough to work out which side of that line an agency is on. If the answer is that the setup is fine, that is a useful thing to hear from someone with no reason to say it.</p>
    </div>
  </section>

  <!-- Who you would be talking to -->
  <section class="section section-light">
    <div class="section-inner">
      <p class="section-label">Personnel On File</p>
      <h2>Who you would be talking to</h2>
      <p class="lede">Two people are handling the security and IT conversations at the booth this year. Tell us the topic on the form and we put you with the right one.</p>

      <div class="people-grid">

        <div class="people-card">
          <div class="folder-tab mono">OPERATIVE 01</div>
          <div class="folder-body">
            <div class="people-head">
              <div class="people-photo">
                <img src="/images/brad-ruben.jpg" alt="Brad Ruben, President of Archway Computer" width="440" height="440" loading="lazy" />
              </div>
              <div>
                <h3>Brad Ruben</h3>
                <span class="people-title mono">PRESIDENT &middot; CYBERSECURITY</span>
              </div>
            </div>
            <p>Thirty years running Archway, all of them working with independent insurance agencies. Brad handles carrier and regulator documentation, security posture, and where an agency would stand if someone asked for evidence rather than a description.</p>
            <p class="people-cover mono">COVERS: carrier cyber questionnaires &middot; NYDFS documentation &middot; security posture reviews &middot; penetration testing</p>
          </div>
        </div>

        <div class="people-card">
          <div class="folder-tab mono">OPERATIVE 02</div>
          <div class="folder-body">
            <div class="people-head">
              <div class="people-photo">
                <img src="/images/walter-harry.jpg" alt="Walter Harry, managed IT and migrations at Archway Computer" width="500" height="500" loading="lazy" />
              </div>
              <div>
                <h3>Walter Harry</h3>
                <span class="people-title mono">MANAGED IT &middot; MIGRATIONS</span>
              </div>
            </div>
            <p>Aging hardware and closet servers, moving Applied Epic or AMS360 to hosted, and the reasonable question of what a current provider is actually delivering for the monthly invoice. Walter gives a straight answer even when the straight answer is that the setup is fine and Archway is not needed.</p>
            <p class="people-cover mono">COVERS: managed IT &middot; hosted Applied Epic and AMS360 &middot; Microsoft 365 migrations &middot; network cleanups</p>
          </div>
        </div>

      </div>

      <p class="footnote">That last part happens more often than you would expect. Archway has told agencies their current provider is doing a good job. It is a strange sales tactic and it works.</p>
    </div>
  </section>

  <!-- What we actually handle -->
  <section class="section">
    <div class="section-inner">
      <p class="section-label">Scope Of Work</p>
      <h2>What we actually handle</h2>
      <p class="lede">Four areas, and every one of them is a fair use of the twenty minutes. Bring the one that is costing you time, money, or sleep.</p>

      <div class="service-grid">

        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5.6 3.8 9.7 8 11 4.2-1.3 8-5.4 8-11V6z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <span class="service-kicker mono">FILE A</span>
          <h3>Security posture and compliance review</h3>
          <p>A read on what is actually configured against what the agency believes is configured, written down in a form a carrier or a regulator can read. Penetration testing where the answer needs to be tested rather than asserted.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v5H4z"/><path d="M4 15h16v5H4z"/><path d="M7 6.5h.01M7 17.5h.01"/><path d="M12 9v6"/></svg>
          </div>
          <span class="service-kicker mono">FILE B</span>
          <h3>Carrier and regulator documentation</h3>
          <p>Cyber questionnaires answered accurately the first time, and NYDFS documentation assembled before the filing date rather than during it. The work is the evidence behind each answer, not the answer itself.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><path d="M12 15v2"/></svg>
          </div>
          <span class="service-kicker mono">FILE C</span>
          <h3>Controls that hold up under testing</h3>
          <p>Multifactor authentication enforced rather than available, endpoint hardening, and backup validation testing. A backup nobody has restored from is a plan, not a control, and the difference shows up on the worst possible day.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><path d="M6 7.5h.01M6 17.5h.01"/><path d="M17 7.5h2M17 17.5h2"/></svg>
          </div>
          <span class="service-kicker mono">FILE D</span>
          <h3>Managed IT, migrations, and infrastructure</h3>
          <p>Day to day managed IT, Microsoft 365 and email migrations, hosted Applied Epic and AMS360 migrations, Azure AD and Intune device management, and the network and infrastructure cleanups that make the rest of it hold.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- The twenty minutes -->
  <section class="section section-light">
    <div class="section-inner terms-inner">
      <p class="section-label">Terms</p>
      <h2>What the twenty minutes is</h2>

      <div class="exhibit-wrap">
        <div class="exhibit-tab mono">EXHIBIT: TERMS</div>
        <div class="exhibit-panel">
          <div class="ink-stamp navy corner" aria-hidden="true">
            <span class="mono">TERMS<br />ON FILE</span>
          </div>
          <ul class="terms-list">
            <li><span class="redaction-mark"></span><span>Twenty minutes. You pick the topic and you direct the conversation.</span></li>
            <li><span class="redaction-mark"></span><span>No presentation, no proposal, no obligation. Nothing is being sold in the room.</span></li>
            <li><span class="redaction-mark accent"></span><span>A $100 Visa gift card for the time, sent by email within one business day of the meeting.</span></li>
            <li><span class="redaction-mark"></span><span>First 20 meetings booked. Archway reserves the right to close the offer once 20 meetings are booked.</span></li>
            <li><span class="redaction-mark"></span><span>One Visa gift card per agency, not per person.</span></li>
            <li><span class="redaction-mark"></span><span>Current Archway clients are welcome to book time. The gift card offer applies to non-clients only.</span></li>
            <li><span class="redaction-mark"></span><span>The meeting can happen at booth 131 or by video after the show. Both qualify.</span></li>
            <li><span class="redaction-mark"></span><span>The meeting has to actually happen. Booking and not showing does not qualify.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="cta-section">
    <p class="case-tag mono centered">STATUS: OPEN &middot; FIRST 20 MEETINGS &middot; BOOTH 131</p>
    <h2>Twenty minutes on what you can prove.</h2>
    <p>Tell us the topic and we will call you to set the time. A $100 Visa gift card for the time, first 20 meetings booked.</p>
    <a href="#hero-form" class="cta-button">Book My Meeting</a>
  </section>

</ArchwayLayout>

<style>
  .mono {
    font-family: 'Courier Prime', 'Courier New', monospace;
  }

  /* ── Hero ── */
  .dossier-hero {
    position: relative;
    overflow: hidden;
  }

  .redaction-stack {
    position: absolute;
    top: 56px;
    right: 64px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0.9;
  }

  .redaction-stack .bar {
    height: 14px;
    background: #1a1a1a;
    border-radius: 2px;
  }

  .redaction-stack .bar:nth-child(1) { width: 220px; }
  .redaction-stack .bar:nth-child(2) { width: 150px; }
  .redaction-stack .bar:nth-child(3) { width: 190px; }
  .redaction-stack .bar.accent { border-bottom: 2px solid var(--orange); }

  .file-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 10px;
  }

  .halftone-strip {
    height: 26px;
    max-width: 320px;
    margin-bottom: 20px;
    border-radius: 3px;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .hero-intro {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 20px;
    max-width: 58ch;
  }

  .hero-trust {
    font-size: 13px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 28px;
  }

  .hero-strip {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .case-tag {
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .case-tag.centered {
    text-align: center;
    margin-bottom: 18px;
    color: rgba(255, 255, 255, 0.45);
  }

  .ink-stamp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    border: 3px solid var(--orange);
    border-radius: 50%;
    transform: rotate(-7deg);
    text-align: center;
  }

  .ink-stamp .mono {
    font-weight: 700;
    font-size: 11px;
    color: var(--orange);
    letter-spacing: 1px;
    line-height: 1.4;
  }

  .ink-stamp.navy {
    border-color: var(--navy);
  }

  .ink-stamp.navy .mono {
    color: var(--navy);
  }

  /* ── Hero form card ── */
  .hero-form-card {
    position: relative;
    min-height: 0;
    justify-content: flex-start;
  }

  .form-tab {
    position: absolute;
    top: -14px;
    left: 24px;
    background: #b89f70;
    color: var(--charcoal);
    font-size: 10px;
    letter-spacing: 1px;
    padding: 5px 12px 3px;
    border-radius: 3px 3px 0 0;
  }

  .form-offline {
    padding: 20px;
    background: var(--light-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .form-offline[hidden] { display: none; }
  .form-offline p { font-size: 15px; line-height: 1.6; color: var(--text-light); margin: 0; }
  .form-offline-title { font-weight: 700; color: var(--charcoal) !important; margin-bottom: 6px !important; }
  .form-offline a { color: var(--orange-text); text-decoration: underline; }

  /* ── Shared section copy ── */
  .narrow-inner {
    max-width: 780px;
  }

  .lede {
    font-size: 18px;
    line-height: 1.7;
    color: var(--charcoal);
    font-weight: 600;
    margin: 0 0 24px;
    max-width: 70ch;
  }

  .body-copy {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-light);
    margin: 0 0 20px;
  }

  .footnote {
    max-width: 760px;
    margin: 28px auto 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-light);
    font-style: italic;
    text-align: center;
  }

  /* ── Proof split ── */
  .proof-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 32px 0;
  }

  .proof-col {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-left: 4px solid var(--border);
    border-radius: 0 10px 10px 0;
    padding: 24px 26px;
  }

  .proof-col.accent {
    background: #d9c7a0;
    border-color: #b89f70;
    border-left-color: var(--orange);
  }

  .proof-kicker {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--orange-text);
    margin-bottom: 14px;
  }

  .proof-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .proof-list li {
    position: relative;
    padding-left: 24px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
  }

  .proof-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 14px;
    height: 5px;
    background: #1a1a1a;
    border-radius: 1px;
  }

  .proof-col.accent .proof-list li { color: #3d3628; }

  /* ── Personnel cards ── */
  .people-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    align-items: stretch;
  }

  .people-card {
    position: relative;
    padding-top: 18px;
    display: flex;
    flex-direction: column;
  }

  .folder-tab {
    position: absolute;
    top: 0;
    left: 22px;
    height: 20px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    background: #c7b285;
    border: 1px solid #b89f70;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #4a3a1f;
  }

  .folder-body {
    position: relative;
    background: #d9c7a0;
    border: 1px solid #b89f70;
    border-radius: 0 12px 12px 12px;
    padding: 26px 26px 28px;
    flex: 1;
    box-shadow: 0 2px 0 #b89f70, 0 8px 22px rgba(41, 63, 80, 0.10);
  }

  .people-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .people-photo {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
