---
import ArchwayLayout from '../../../layouts/ArchwayLayout.astro';

// Lands after the recording form on /hours-webinar/recording submits. The
// video is embedded here, and the two speaker meeting links are the only CTAs.
// Point the HubSpot form's redirect at this URL.

const WEBINAR_TITLE = 'The Work Is Not the Problem. It’s the Hours.';

// Supplied 2026-09-09. The ?si= share token is stripped; nocookie host so the
// embed does not set YouTube cookies before playback.
const YOUTUBE_ID = '7182zxch7x0';
const EMBED_URL = `https://www.youtube-nocookie.com/embed/${YOUTUBE_ID}?rel=0&modestbranding=1`;
const WATCH_URL = `https://youtu.be/${YOUTUBE_ID}`;

// Decoded from the QR codes used on the closing slide of the webinar deck.
const SAM_MEETING = 'https://meetings-na2.hubspot.com/sam-ruben/website-forms-discovery-call';
// This bit.ly resolves to angelaadamsconsulting.com/licensed-insurance-account-managers/,
// a service page rather than a scheduler. Swap for a calendar link if AAC has one.
const ANGELA_MEETING = 'https://bit.ly/4x98VBX';

// The "see the tools Sam demoed" form, supplied by Kevin 2026-09-09.
const DEMO_FORM_ID = 'e2ba021a-ddd8-4f88-8add-3b9123022215';

const DEMO_MAILTO = `mailto:sam@myarchway.com?subject=${encodeURIComponent(
  'Show me the tools from the September 8 webinar'
)}`;

const demoTools = ['Client intake', 'Policy comparison', 'Quote to proposal'];

const conversations = [
  {
    accent: 'red',
    logo: '/images/aac-logo.png',
    logoAlt: 'Angela Adams Consulting',
    logoW: 138,
    logoH: 33,
    title: 'Licensed service professionals inside your workflow',
    body: 'Certificates, policy checking, quoting and remarketing, account management. Service billed by the hour and scaled to what the agency actually needs.',
    cta: 'Book time with Angela',
    href: ANGELA_MEETING,
  },
  {
    accent: 'orange',
    logo: '/images/archway-logo.png',
    logoAlt: 'Archway',
    logoW: 76,
    logoH: 33,
    title: 'Custom AI built around your agency',
    body: 'Your carriers, your management system, your exceptions. Built once, for one agency. What you get is yours, not a version of what the agency down the street is running.',
    cta: 'Book time with Sam',
    href: SAM_MEETING,
  },
];
---

<ArchwayLayout
  title={`Watch: ${WEBINAR_TITLE} | Archway + Angela Adams Consulting`}
  description="The full sixty-minute recording with Angela Bunch and Sam Ruben, and two ways to keep going."
  ctaText="Book Time with Sam"
  ctaHref={SAM_MEETING}
  cobrand
>
  <section class="hero video-hero">
    <div class="video-inner">
      <p class="section-label section-label-on-dark">Webinar recording</p>
      <h1>The Work Is Not the Problem. <span class="hl">It&rsquo;s the Hours.</span></h1>
      <p class="hero-sub">Sixty minutes. Context from Angela and Sam first, thirty minutes of live demonstration, then questions from the room.</p>

      <div class="video-frame">
        <iframe
          src={EMBED_URL}
          title={`Webinar recording: ${WEBINAR_TITLE}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <p class="video-alt">Player not loading? <a href={WATCH_URL} target="_blank" rel="noopener">Open the recording on YouTube</a>.</p>
    </div>
  </section>

  <!-- See the tools: form on the right, the three tools on the left -->
  <section class="section demo-section" id="demo-form">
    <div class="section-inner demo-grid fade-up">
      <div class="demo-text">
        <p class="section-label">See the tools</p>
        <h2>See What Sam Demoed, on Your Own&nbsp;Workflow</h2>
        <p class="demo-sub">Thirty minutes on a screen share. Sam walks through the three tools from the webinar against your carriers and your management system, and answers the question every agency asks first.</p>
        <ul class="demo-tools">
          {demoTools.map((t) => (
            <li>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#f48021" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.25"/><polyline points="8 12.3 11 15.2 16.2 9.2"/></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-form-card demo-card">
        <div class="form-header">
          <h2>See the tools</h2>
          <p>Tell us your management system and Sam will set up the walkthrough.</p>
        </div>
        <div id="hs-aac-demo-form"></div>

        <noscript>
          <div class="form-offline">
            <p class="form-offline-title">The form needs JavaScript.</p>
            <p>Email <a href={DEMO_MAILTO}>sam@myarchway.com</a> and we will set up the walkthrough.</p>
          </div>
        </noscript>

        <div class="form-offline" id="demo-form-offline" hidden>
          <p class="form-offline-title">The form did not load.</p>
          <p>An ad blocker or privacy extension is the usual reason. Email <a href={DEMO_MAILTO}>sam@myarchway.com</a> and we will set up the walkthrough.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="//js-na2.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline define:vars={{ DEMO_FORM_ID }}>
    function _createAacDemoForm() {
      if (!window.hbspt || !window.hbspt.forms) {
        setTimeout(_createAacDemoForm, 80);
        return;
      }
      window.hbspt.forms.create({
        portalId: "6869933",
        formId: DEMO_FORM_ID,
        region: "na2",
        target: "#hs-aac-demo-form",
        css: "\
          @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\
          .hs-form { font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .hs-form fieldset { max-width: 100% !important; }\
          .hs-form fieldset.form-columns-2 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-2 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form fieldset.form-columns-3 { display: flex; gap: 16px; }\
          .hs-form fieldset.form-columns-3 > .hs-form-field { flex: 1; width: auto !important; }\
          .hs-form-field { margin-bottom: 16px; }\
          .hs-form-field > label { display: block; font-size: 15px; font-weight: 600; color: #333333; margin-bottom: 8px; }\
          .hs-form-required { color: #b91c1c; margin-left: 2px; }\
          .hs-input { width: 100% !important; padding: 14px 16px !important; background: #ffffff !important; border: 1px solid #d1d5db !important; border-radius: 8px !important; color: #333333 !important; font-size: 16px !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; outline: none !important; box-sizing: border-box !important; transition: border-color 0.2s, box-shadow 0.2s; }\
          .hs-input:focus { border-color: #f48021 !important; box-shadow: 0 0 0 3px rgba(244, 128, 33, 0.25) !important; }\
          .hs-input::placeholder { color: #9ca3af; }\
          .hs-form-field textarea.hs-input { min-height: 88px; resize: vertical; }\
          .hs-form-booleancheckbox-display, .hs-form-radio-display { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 8px; }\
          .hs-form-radio-display input[type='radio'], .hs-form-booleancheckbox-display input[type='checkbox'] { width: auto !important; margin: 3px 0 0 !important; accent-color: #f48021; }\
          .hs-form-radio-display span, .hs-form-booleancheckbox-display span { font-size: 15px; color: #333333; font-weight: 500; }\
          .inputs-list { list-style: none; padding: 0; margin: 0; }\
          .hs-submit { margin-top: 8px; }\
          .hs-button { width: 100% !important; padding: 16px !important; background: #f48021 !important; color: #32373c !important; font-size: 16px !important; font-weight: 700 !important; font-family: 'Inter', Arial, Helvetica, sans-serif !important; border: none !important; border-radius: 8px !important; cursor: pointer; transition: all 0.2s; min-height: 44px; }\
          .hs-button:hover { background: #ff9440 !important; }\
          .hs-error-msgs { list-style: none; padding: 0; margin: 4px 0 0; }\
          .hs-error-msgs li label { font-size: 13px !important; color: #ef4444 !important; font-weight: 500 !important; }\
          .hs-input.error { border-color: #ef4444 !important; }\
          .submitted-message { text-align: center; padding: 30px 10px; font-size: 16px; line-height: 1.55; color: #333333; font-family: 'Inter', Arial, Helvetica, sans-serif; }\
          .legal-consent-container { font-size: 13px; color: #5a5f66; line-height: 1.5; margin-top: 8px; }\
          .legal-consent-container a { color: #f48021; }\
          @media (max-width: 480px) { .hs-form fieldset.form-columns-2, .hs-form fieldset.form-columns-3 { flex-direction: column; gap: 0; } }\
        "
      });
    }
    _createAacDemoForm();

    setTimeout(function () {
      var target = document.getElementById("hs-aac-demo-form");
      var offline = document.getElementById("demo-form-offline");
      if (target && offline && target.children.length === 0) {
        offline.hidden = false;
      }
    }, 5000);
  </script>

  <section class="section section-light">
    <div class="section-inner">
      <div class="block-header fade-up">
        <p class="section-label">Next Steps</p>
        <h2>Two Conversations, Whichever Side&nbsp;Fits</h2>
        <p class="block-sub">Both are thirty minutes. Bring your management system and one process that eats the most hours.</p>
      </div>

      <div class="meeting-grid fade-up">
        {conversations.map((c) => (
          <div class={`meeting-card meeting-card-${c.accent}`}>
            <img src={c.logo} alt={c.logoAlt} width={c.logoW} height={c.logoH} loading="lazy" decoding="async" class="meeting-logo" />
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            <a href={c.href} class="meeting-cta" target="_blank" rel="noopener">
              {c.cta}
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</ArchwayLayout>

<style>
  .video-hero {
    min-height: 0;
    padding: 72px 24px 0;
    border-bottom: 0;
  }

  .video-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .video-hero h1 {
    font-size: 44px;
    letter-spacing: -1px;
    margin-bottom: 14px;
    text-wrap: balance;
  }

  .video-hero .hero-sub {
    max-width: 60ch;
    margin: 0 auto 40px;
    text-align: center;
  }

  /* 16:9 frame that bleeds into the white section below, so the player sits
     across the navy/white seam the way the poster does on the design. */
  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-alt {
    align-self: flex-start;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    margin: 12px 0 18px;
  }

  .video-alt a {
    color: var(--orange-on-dark);
    font-weight: 600;
  }

  /* ── See the tools: copy left, form card right, same split as the hero form
        on the registration page. ── */
  .demo-grid {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: 64px;
    align-items: center;
  }

  .demo-text .section-label {
    display: inline-flex;
  }

  .demo-text h2 {
    font-size: 34px;
    line-height: 1.25;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .demo-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0 0 24px;
    text-wrap: pretty;
  }

  .demo-tools {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .demo-tools li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    font-weight: 600;
    color: var(--charcoal);
  }

  /* The shared hero-form-card is styled for the navy hero; on white it needs
     a border instead of a drop shadow to hold its edge. */
  .demo-card {
    border: 1px solid var(--card-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .form-offline {
    padding: 20px;
    background: var(--light-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .form-offline[hidden] {
    display: none;
  }

  .form-offline p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  .form-offline .form-offline-title {
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .form-offline a {
    color: var(--orange-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .block-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .block-header h2 {
    font-size: 34px;
    line-height: 1.25;
    text-wrap: balance;
    margin-bottom: 16px;
  }

  .block-sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0;
    text-wrap: pretty;
  }

  .section-label {
    display: inline-flex;
  }

  .meeting-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .meeting-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 32px 30px;
  }

  /* AAC red is the partner's brand colour; the same split runs through the
     deck's closing slide and the follow-up emails. */
  .meeting-card-red {
    border-color: #8c0c04;
  }

  .meeting-card-orange {
    border-color: var(--orange);
  }

  /* align-self stops the flex column stretching the image to the card width,
     which distorts a logo whose height is fixed. */
  .meeting-logo {
    display: block;
    align-self: flex-start;
    width: auto;
    height: 33px;
    margin-bottom: 18px;
  }

  .meeting-card h3 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: var(--charcoal);
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .meeting-card p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-light);
    margin: 0 0 22px;
    flex-grow: 1;
  }

  .meeting-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    background: var(--orange);
    color: var(--charcoal);
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    padding: 16px 30px;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .meeting-cta:hover {
    background: var(--orange-on-dark);
  }

  .meeting-cta svg {
    transition: transform 0.2s;
  }

  .meeting-cta:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .meeting-grid,
    .demo-grid {
      grid-template-columns: 1fr;
    }
    .demo-grid {
      gap: 36px;
    }
    .video-hero h1 {
      font-size: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meeting-cta svg {
      transition: none;
    }
    .meeting-cta:hover svg {
      transform: none;
    }
  }
</style>
