---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';

// Not finished language — see the legal-callout below. Every bracketed
// placeholder here is a real open item from ARCHWAY_SEPTEMBER_2026_LANDING_PAGES.docx
// and must stay bracketed until legal review, not filled in casually.

// Kept out of NavArchway's link set intentionally (it only renders a logo +
// CTA, no nav menu to exclude this from) — allowed to index, just not
// promoted as a primary nav destination.
---

<ArchwayLayout
  title="Applied Net 2026 Giveaway Official Rules | Archway Computer"
  description="Official sweepstakes rules for the Archway Computer Applied Net 2026 booth giveaway."
  ctaText="Book Your Meeting"
  ctaHref="/applied-net-meeting"
>
  <section class="rules-page">
    <div class="title-block">
      <div class="folder-tab">LEGAL FILE &middot; OFFICIAL RECORD</div>
      <div class="manila-panel">
        <div class="case-tag">
          <span class="redaction-chip"></span>
          FILE NO. AWX-2026-RULES
        </div>
        <div class="halftone-band"></div>
        <div class="draft-stamp">DRAFT<br />RECORD</div>
      </div>
    </div>

    <div class="content">
      <h1>Applied Net 2026 Giveaway Official Rules</h1>

      <div class="legal-callout">
        <strong>Not finished language.</strong> This structure is a starting point and has not been reviewed by counsel. A sweepstakes needs published rules before the first promotional send, and Applied Net&rsquo;s own exhibitor giveaway rules need checking before the prize is purchased. Have someone qualified review this page before it goes live.
      </div>

      <div class="rule-item">
        <h3>No purchase necessary</h3>
        <p>No purchase or payment of any kind is necessary to enter or win.</p>
      </div>
      <div class="rule-item">
        <h3>Sponsor</h3>
        <p>Archway Computer, <span class="placeholder">[FULL LEGAL ENTITY NAME AND ADDRESS]</span>.</p>
      </div>
      <div class="rule-item">
        <h3>Eligibility</h3>
        <p>Age minimum, residency, and whether Archway employees, family members, and current clients are excluded. <span class="placeholder">[DECIDE]</span></p>
      </div>
      <div class="rule-item">
        <h3>Entry period</h3>
        <p>Opens <span class="placeholder">[DATE AND TIME]</span>, closes <span class="placeholder">[DATE AND TIME]</span>.</p>
      </div>
      <div class="rule-item">
        <h3>How to enter</h3>
        <p>Complete the entry form at booth 131. One entry per person. Alternate method of entry if required in any relevant jurisdiction. <span class="placeholder">[CONFIRM]</span></p>
      </div>
      <div class="rule-item">
        <h3>Prize</h3>
        <p>One <span class="placeholder">[LAPTOP MODEL]</span>. Approximate retail value <span class="placeholder">[ARV]</span>. Not transferable, no cash substitution.</p>
      </div>
      <div class="rule-item">
        <h3>Drawing</h3>
        <p>Random drawing from all eligible entries after the event concludes, within <span class="placeholder">[TIMEFRAME]</span> of the close date. Winner need not be present.</p>
      </div>
      <div class="rule-item">
        <h3>Winner notification</h3>
        <p>By email and phone within <span class="placeholder">[TIMEFRAME]</span>. If the winner does not respond within <span class="placeholder">[TIMEFRAME]</span>, an alternate is drawn.</p>
      </div>
      <div class="rule-item">
        <h3>Taxes</h3>
        <p>The winner is responsible for all applicable taxes. Reporting requirements above <span class="placeholder">[THRESHOLD]</span> may apply.</p>
      </div>
      <div class="rule-item">
        <h3>Privacy</h3>
        <p>Entrant information is used as described in the Archway privacy policy. Entrants may be contacted by Archway.</p>
      </div>
      <div class="rule-item">
        <h3>Conditions</h3>
        <p>Sponsor may modify or cancel the giveaway if it cannot run as planned. Void where prohibited.</p>
      </div>
    </div>
  </section>
</ArchwayLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap');

  .rules-page {
    padding-bottom: 40px;
  }

  .title-block {
    max-width: 760px;
    margin: 40px auto 0;
    padding: 0 24px;
    position: relative;
  }

  .folder-tab {
    position: absolute;
    top: -16px;
    left: 24px;
    background: #b89f70;
    color: var(--charcoal);
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    padding: 6px 14px 4px;
    border-radius: 3px 3px 0 0;
  }

  .manila-panel {
    background: #d9c7a0;
    border-radius: 0 8px 8px 8px;
    padding: 24px 28px;
    position: relative;
    overflow: hidden;
  }

  .case-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Courier Prime', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: var(--text-light);
    position: relative;
    z-index: 2;
  }

  .redaction-chip {
    width: 28px;
    height: 7px;
    background: #1a1a1a;
    border-bottom: 2px solid var(--orange);
    display: inline-block;
  }

  .halftone-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20px;
    background-image: radial-gradient(circle, rgba(50, 55, 60, 0.12) 1px, transparent 1px);
    background-size: 8px 8px;
  }

  .draft-stamp {
    position: absolute;
    top: 16px;
    right: 20px;
    width: 72px;
    height: 72px;
    border: 2.5px solid var(--navy);
    border-radius: 50%;
    transform: rotate(-6deg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: 9px;
    color: var(--navy);
    letter-spacing: 0.5px;
    text-align: center;
    line-height: 1.3;
    z-index: 2;
    background: #d9c7a0;
  }

  .content {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 24px 100px;
  }

  .content h1 {
    font-size: 38px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.2;
    letter-spacing: -0.5px;
    margin: 0 0 28px;
  }

  .legal-callout {
    background: #fff5ea;
    border: 1px solid var(--orange);
    border-radius: 10px;
    padding: 18px 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-light);
    margin-bottom: 40px;
  }

  .legal-callout strong {
    color: var(--charcoal);
  }

  .rule-item {
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }

  .rule-item:last-child {
    border-bottom: none;
  }

  .rule-item h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 6px;
  }

  .rule-item p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0;
  }

  .placeholder {
    background: rgba(244, 128, 33, 0.12);
    color: var(--orange-text);
    font-family: 'Courier Prime', monospace;
    font-size: 13px;
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .content h1 {
      font-size: 28px;
    }

    .draft-stamp {
      width: 56px;
      height: 56px;
      font-size: 8px;
    }
  }
</style>
