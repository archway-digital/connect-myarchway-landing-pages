---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroLeadMagnet from '../components/shared/HeroLeadMagnet.astro';
import ProblemCardsThree from '../components/shared/ProblemCardsThree.astro';
import NumberedCardsList from '../components/shared/NumberedCardsList.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="AI Adoption Progress Scorecard for Insurance Agencies | Archway"
  description="Download the free scorecard and get an honest picture of where your agency’s AI adoption actually stands at the halfway point of 2026, and what to do next."
  ctaText="Get the Free Scorecard"
  ctaHref="#hero-form"
>
  <HeroLeadMagnet
    badge="AI Adoption Progress  ·  June 2026"
    headline="Halfway Through 2026. <span class='hl'>Where Does Your Agency’s AI Adoption Actually&nbsp;Stand?</span>"
    subhead="Download the free scorecard and get an honest picture of your AI progress, where you have stalled, and what the most realistic next step looks like."
    body1="Most agencies that planned to do something with AI this year are somewhere between started and stalled. Not because the goal was wrong. Because the starting point was too broad or the first tool did not connect to a real workflow problem."
    body2="This scorecard covers the four areas where independent insurance agencies get the most traction with AI. Ten minutes. An honest output. A clear recommendation for what to do next based on where you actually are."
    formHeading="Get the Free Scorecard"
    formSubhead="We will send it to your inbox right away."
    formId="PLACEHOLDER_FORM_ID_AI_SCORECARD"
    trustLine="No spam. No sales call unless you want one. Just the scorecard."
  />

  <ProblemCardsThree
    sectionLabel="Where Most Agencies Stall on AI"
    heading="It Is Not a Technology Problem. <br /><span class='hl'>It Is a Starting Point&nbsp;Problem.</span>"
    subhead="The agencies getting real results from AI did not start with a bigger vision. They started with a smaller, more specific problem."
    cards={[
      {
        title: "Goals that were too broad",
        body: "We are going to use AI this year is not a plan. It does not tell you which workflow, which tool, which problem, or what success looks like in 90 days. Broad goals stall at the planning stage."
      },
      {
        title: "Tools that did not connect to the AMS",
        body: "The demo was convincing. The implementation required IT resources nobody had. The tool never connected to how the agency actually works. The project got shelved."
      },
      {
        title: "No benchmark for what good looks like",
        body: "Without a clear picture of where other agencies are, it is impossible to know if you are behind, on track, or further along than you think. Most agencies underestimate their own progress."
      }
    ]}
  />

  <NumberedCardsList
    sectionLabel="What the Scorecard Covers"
    heading="Four Areas. Twenty Questions. <br />One Score That Tells You Where You&nbsp;Are."
    cards={[
      {
        title: "Document generation",
        body: "Are you producing documents manually that could be automated? Certificates, renewal letters, policy summaries, client communication templates. How many document types? At what volume? What is still manual?"
      },
      {
        title: "Workflow automation",
        body: "Where is staff time still going that should be automated? What was supposed to be automated by now that is still done by hand? What workarounds have become normal operations?"
      },
      {
        title: "Client communication",
        body: "How much inbound is still handled manually? Is any of it handled by a tool or workflow? What repetitive questions are still landing in staff inboxes every day?"
      },
      {
        title: "AMS efficiency",
        body: "Is the AMS connected to how you actually work or are staff working around it? What data entry is still manual? Are the automations your AMS supports actually configured and running?"
      }
    ]}
  />

  <StatsBar />
  <AboutArchway />
  <WhyChooseUs />
  <Testimonials />

  <BottomCTA
    heading="Ready to Find Out Where You Actually Stand?"
    subtext="Download the scorecard and get an honest mid-year picture of your AI adoption, and a specific recommended next step based on your score."
    ctaText="Get the Free Scorecard"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.problem-header h2 .hl) {
    color: var(--orange);
  }
</style>

