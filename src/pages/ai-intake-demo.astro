---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import Testimonials from '../components/shared/Testimonials.astro';

const DEMO_URL = 'https://archway-quote-form.vercel.app';
---

<ArchwayLayout
  title="See AI-Powered Insurance Intake in Action | Archway Computer"
  description="Watch AI read a dec page, detect coverage, and pre-fill a quote form automatically. Built by Archway for independent insurance agencies."
  ctaText="See the Demo"
  ctaHref="#hero-cta"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-badge">AI Without the Hype  ·  May 2026</div>
        <h1>Your Client Uploads a Dec Page.<br /><span class="hl">Watch What Happens Next.</span></h1>
        <p class="hero-sub">AI reads it, detects the coverage type, and pre-fills the entire quote form. No manual entry. No staff time. No delay.</p>
        <p class="hero-body">This is not a concept. It is a working implementation Archway built for independent insurance agencies. The demo runs on real documents: upload a homeowners ACORD, a rental property dec page, or a commercial BOP and watch AI extract every field automatically.</p>
        <p class="hero-body">The same tool lets clients describe what they need in plain language and routes them to the right coverage automatically. Two entry points, one result: a clean, structured intake your agency receives without anyone on staff touching it manually.</p>
        <a id="hero-cta" href={DEMO_URL} target="_blank" rel="noopener noreferrer" class="hero-cta-primary">
          Try the Demo Now
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
      </div>

      <div class="hero-visual">
        <figure class="browser-frame" aria-label="Screenshot of the Archway AI intake demo">
          <div class="browser-chrome">
            <div class="browser-dots" aria-hidden="true">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
            </div>
            <div class="browser-url">archway-quote-form.vercel.app</div>
          </div>
          <img
            src="/images/ai-intake-demo.png"
            alt="Archway AI intake demo home screen with four entry points: upload a dec page, tell us what you need, start a personal quote, and start a commercial quote."
            class="browser-img"
            width="1200"
            height="900"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- What the Demo Shows -->
  <section class="section">
    <div class="section-inner centered">
      <p class="section-label centered-label">What the Demo Shows</p>
      <h2 class="section-h2 centered-h">Two Ways AI Handles Intake.<br /><span class="hl">Both Work Without Your Staff.</span></h2>
      <div class="paths-grid">
        <article class="path-card path-card--gray">
          <p class="path-eyebrow">Path One</p>
          <h3>Upload a Dec Page</h3>
          <p>A client uploads their current declarations page. AI reads the PDF, detects the coverage type, pulls the applicant name, address, property details, vehicles, and all coverages, and pre-fills the entire quote form automatically. Works on homeowners, rental property dec pages, and commercial BOP documents. The live version connects directly to your AMS.</p>
        </article>
        <article class="path-card path-card--white">
          <p class="path-eyebrow">Path Two</p>
          <h3>Tell Us What You Need</h3>
          <p>A client describes their situation in plain language. AI interprets the request, recommends the right coverage type, and routes them into the appropriate quote form automatically. No multiple-choice questions. No forms to navigate blind. The client gets an immediate, guided response. The agency gets a structured, categorized intake.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section section-light">
    <div class="section-inner centered">
      <p class="section-label centered-label">How It Works</p>
      <h2 class="section-h2 centered-h">From Document to Quote in <span class="hl">Under a Minute.</span></h2>
      <ol class="steps">
        <li class="step">
          <div class="step-num step-num--navy" aria-hidden="true">1</div>
          <div class="step-body">
            <h3>Client submits a document or describes what they need</h3>
            <p>A dec page PDF, a drivers license scan, a purchase agreement, or a plain-language description of their situation. The system accepts any of these as a starting point.</p>
          </div>
        </li>
        <li class="step">
          <div class="step-num step-num--navy" aria-hidden="true">2</div>
          <div class="step-body">
            <h3>AI reads, extracts, and categorizes</h3>
            <p>The AI identifies the document type, extracts every relevant field, cross-references across multiple uploaded documents where applicable, and routes the intake to the correct coverage category. No rules engine. No manual tagging.</p>
          </div>
        </li>
        <li class="step">
          <div class="step-num step-num--navy" aria-hidden="true">3</div>
          <div class="step-body">
            <h3>Your agency receives a clean, structured intake</h3>
            <p>Applicant details, coverage types, property or vehicle data, and all extracted fields arrive in a structured format your agency can act on immediately. Connected to your AMS in the live version.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Proof Callout Band -->
  <section class="proof-band">
    <div class="proof-inner">
      <h2>This Is a Real Implementation. <span class="hl">Not a Prototype.</span></h2>
      <p>Archway built this for independent insurance agencies. The dec page extraction, the conversational intake, and the AMS connection are all live. The demo at archway-quote-form.vercel.app runs on pre-loaded sample documents so you can see exactly how it works before committing any time or budget.</p>
    </div>
  </section>

  <StatsBar />
  <Testimonials />

  <!-- Bottom CTA Band (two buttons) -->
  <section class="cta-section bottom-cta-two">
    <div class="bottom-cta-inner">
      <h2>Ready to See It Working on <span class="hl">Your Agency&rsquo;s Documents?</span></h2>
      <p>Try the demo in two minutes. Or book 30 minutes with Sam and see what a live implementation looks like connected to your AMS.</p>
      <div class="cta-buttons">
        <a href={DEMO_URL} target="_blank" rel="noopener noreferrer" class="cta-button">
          Try the Demo Now
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
        <a href="/book-sharepoint-consult" class="cta-button-secondary">Book 30 Minutes With Sam</a>
      </div>
    </div>
  </section>
</ArchwayLayout>

<style>
  /* ── HERO BODY PARAGRAPHS ── */
  .hero-body {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 14px;
    max-width: 56ch;
  }

  .hero-body + .hero-body {
    margin-top: -2px;
  }

  /* ── HERO PRIMARY CTA (on dark hero) ── */
  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: var(--white);
    text-decoration: none;
    font-size: 17px;
    font-weight: 700;
    padding: 18px 32px;
    border-radius: 8px;
    margin-top: 12px;
    min-height: 44px;
    transition: background 0.2s ease;
  }

  .hero-cta-primary:hover {
    background: var(--orange-dark);
  }

  /* ── BROWSER FRAME (hero right column) ── */
  .hero-visual {
    width: 100%;
  }

  .browser-frame {
    background: var(--white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.55),
                0 8px 20px rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin: 0;
  }

  .browser-chrome {
    background: #f0f1f3;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid #e2e5ea;
  }

  .browser-dots {
    display: inline-flex;
    gap: 7px;
    flex-shrink: 0;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c940; }

  .browser-url {
    flex: 1;
    font-size: 11px;
    color: var(--text-light);
    background: var(--white);
    border: 1px solid #e2e5ea;
    border-radius: 5px;
    padding: 4px 12px;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.2px;
  }

  .browser-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--light-bg);
  }

  /* ── CENTERED SECTION UTILITIES (override the inline-flex section-label) ── */
  .centered {
    text-align: center;
  }

  .centered-label {
    display: inline-flex;
    margin-left: auto;
    margin-right: auto;
  }

  .centered-h {
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: var(--charcoal);
    margin-bottom: 48px;
    text-wrap: balance;
  }

  /* ── PATHS GRID ── */
  .paths-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    text-align: left;
  }

  .path-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 36px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .path-card--gray {
    background: var(--light-bg);
  }

  .path-card--white {
    background: var(--white);
  }

  .path-eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .path-card h3 {
    font-size: 22px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.25;
    letter-spacing: -0.3px;
    margin-bottom: 12px;
  }

  .path-card p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  /* ── STEPS (How It Works) ── */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
  }

  .step {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 28px;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    align-items: start;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .step-num {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.5px;
  }

  .step-num--navy {
    background: var(--navy);
  }

  .step-num--orange {
    background: var(--orange);
  }

  .step-num--green {
    background: var(--success);
  }

  .step-body h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .step-body p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }

  /* ── PROOF CALLOUT BAND ── */
  .proof-band {
    background: var(--navy);
    padding: 80px 24px;
  }

  .proof-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .proof-band h2 {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.5px;
    color: var(--white);
    margin-bottom: 18px;
    text-wrap: balance;
  }

  .proof-band p {
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
  }

  /* ── BOTTOM CTA (two-button variant) ── */
  .bottom-cta-two {
    padding: 80px 24px;
  }

  .bottom-cta-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .bottom-cta-two h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.5px;
    line-height: 1.25;
    margin-bottom: 14px;
    text-wrap: balance;
  }

  .bottom-cta-two p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 17px;
    margin-bottom: 28px;
  }

  .cta-buttons {
    display: inline-flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .bottom-cta-two .cta-button {
    min-height: 44px;
  }

  .bottom-cta-two .cta-button-secondary {
    min-height: 44px;
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .centered-h {
      font-size: 28px;
    }

    .paths-grid {
      grid-template-columns: 1fr;
    }

    .step {
      grid-template-columns: 48px 1fr;
      gap: 16px;
      padding: 20px;
    }

    .step-num {
      width: 48px;
      height: 48px;
      font-size: 18px;
      border-radius: 10px;
    }

    .proof-band {
      padding: 64px 24px;
    }

    .proof-band h2 {
      font-size: 26px;
    }

    .bottom-cta-two {
      padding: 64px 24px;
    }

    .bottom-cta-two h2 {
      font-size: 26px;
    }

    .cta-buttons {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .bottom-cta-two .cta-button,
    .bottom-cta-two .cta-button-secondary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .browser-url {
      font-size: 10px;
      padding: 3px 8px;
    }

    .hero-cta-primary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
