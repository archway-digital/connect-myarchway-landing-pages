<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enter to Win at Applied Net 2026 | Archway Computer</title>
  <meta name="description" content="Stop by booth 131 at Applied Net 2026 and enter to win. Thirty seconds, no meeting required." />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>

  <div class="page">
    <div class="entry-stamp"><span>ENTRY<br/>OPEN</span></div>

    <div class="case-tag">
      <span class="redaction-chip"></span>
      FILE NO. AWX-2026-131 &middot; BOOTH 131
    </div>

    <h1>Enter to win a [LAPTOP MODEL].</h1>
    <p class="subhead">Booth 131, Applied Net 2026. We draw after the show and email the winner.</p>
    <p class="body-line">Fill this in and you are entered. That is the whole thing.</p>

    <div class="form-wrap">
      <div class="form-tab">ENTRY FORM</div>
      <div class="form-card">
        <!-- TODO: replace with real hbspt.forms.create() embed once "LeadGen - Event - Applied Net Giveaway" exists in HubSpot -->
        <div class="field">
          <label for="giveaway-name">First and last name</label>
          <input id="giveaway-name" type="text" placeholder="Jane Smith" disabled>
        </div>
        <div class="field">
          <label for="giveaway-agency">Agency name</label>
          <input id="giveaway-agency" type="text" placeholder="Smith Insurance Group" disabled>
        </div>
        <div class="field">
          <label for="giveaway-email">Business email</label>
          <input id="giveaway-email" type="text" placeholder="jane@agency.com" disabled>
        </div>
        <div class="field">
          <label for="giveaway-phone">Phone</label>
          <input id="giveaway-phone" type="text" placeholder="(555) 555-5555" disabled>
        </div>
        <div class="checkbox-row">
          <span class="box"></span>
          <p>I have read and accept the <a href="/applied-net-giveaway-rules">official rules</a>.</p>
        </div>
        <div class="enter-btn">Enter to Win</div>
      </div>
    </div>

    <p class="footer-tag">Archway // File Division</p>
  </div>

  <!-- HubSpot Tracking Code -->
  <script is:inline type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/6869933.js"></script>

</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  body {
    margin: 0;
    background: var(--navy);
    font-family: 'Inter', Arial, sans-serif;
  }

  a {
    color: var(--orange);
  }

  a:hover {
    color: var(--orange-on-dark);
  }

  .page {
    width: 100%;
    max-width: 430px;
    min-height: 100vh;
    margin: 0 auto;
    background: var(--navy);
    display: flex;
    flex-direction: column;
    padding: 28px 22px 22px;
    position: relative;
    box-sizing: border-box;
  }

  .entry-stamp {
    position: absolute;
    top: 22px;
    right: 16px;
    width: 56px;
    height: 56px;
    border: 2.5px solid var(--orange);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-10deg);
    text-align: center;
  }

  .entry-stamp span {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: 8px;
    color: var(--orange);
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  .case-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Courier Prime', monospace;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: rgba(245, 245, 245, 0.65);
    margin-bottom: 18px;
  }

  .redaction-chip {
    width: 34px;
    height: 8px;
    background: #1a1a1a;
    border-bottom: 2px solid var(--orange);
    display: inline-block;
  }

  h1 {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.15;
    color: var(--white);
    margin: 0 0 12px;
    letter-spacing: -0.5px;
  }

  .subhead {
    font-size: 15px;
    line-height: 1.5;
    color: rgba(245, 245, 245, 0.8);
    margin: 0 0 6px;
  }

  .body-line {
    font-size: 13px;
    color: rgba(245, 245, 245, 0.55);
    margin: 0 0 18px;
  }

  .form-wrap {
    position: relative;
    margin-top: 4px;
  }

  .form-tab {
    position: absolute;
    top: -14px;
    left: 18px;
    background: #b8a172;
    color: var(--charcoal);
    font-family: 'Courier Prime', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 5px 12px 3px;
    border-radius: 3px 3px 0 0;
  }

  .form-card {
    background: var(--light-bg);
    border-radius: 14px;
    padding: 22px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.35);
  }

  .field label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--charcoal);
    margin-bottom: 6px;
  }

  .field input {
    width: 100%;
    padding: 13px 14px;
    background: var(--white);
    border: 1px solid var(--input-border);
    border-radius: 8px;
    color: var(--input-text);
    font-size: 15px;
    font-family: 'Inter', Arial, sans-serif;
    box-sizing: border-box;
  }

  .checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .checkbox-row .box {
    width: 18px;
    height: 18px;
    border: 1px solid #b8a172;
    border-radius: 4px;
    background: var(--white);
    flex: 0 0 auto;
    margin-top: 1px;
  }

  .checkbox-row p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-light);
  }

  .checkbox-row a {
    text-decoration: underline;
  }

  .enter-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--orange);
    color: var(--charcoal);
    font-size: 17px;
    font-weight: 700;
    padding: 16px;
    border-radius: 8px;
    margin-top: 4px;
  }

  .footer-tag {
    text-align: center;
    font-family: 'Courier Prime', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(245, 245, 245, 0.4);
    margin-top: 20px;
    text-transform: uppercase;
  }
</style>
