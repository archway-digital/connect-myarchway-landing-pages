---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroLeadMagnet from '../components/shared/HeroLeadMagnet.astro';
import ProblemCardsThree from '../components/shared/ProblemCardsThree.astro';
import NumberedCardsList from '../components/shared/NumberedCardsList.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Mid-Year Technology Audit Checklist for Insurance Agencies | Archway"
  description="Download the free checklist and find out where your agency’s IT, marketing, and AI setup actually stands at the halfway point of 2026."
  ctaText="Get the Free Checklist"
  ctaHref="#hero-form"
>
  <HeroLeadMagnet
    badge="Mid-Year Technology Checkpoint  ·  June 2026"
    headline="Is Your Agency’s Technology Set Up <span class='hl'>for a Strong Second&nbsp;Half?</span>"
    subhead="Download the free mid-year technology audit checklist and find out where your IT, marketing, and AI setup actually stands at the halfway point of 2026."
    body1="We are halfway through 2026 and most agencies have not stopped to ask whether their technology is working the way it should. Not whether it is working. Whether it is working the way it should."
    body2="This checklist covers all three areas in 15 minutes. Most agencies come out with at least two or three things worth addressing before Q3. The scoring guide at the end tells you where to focus first."
    formHeading="Get the Free Checklist"
    formSubhead="We will send it to your inbox right away."
    formId="PLACEHOLDER_FORM_ID_TECH_AUDIT"
    trustLine="No spam. No sales call unless you want one. Just the checklist."
  />

  <ProblemCardsThree
    sectionLabel="What Most Agencies Find at Midyear"
    heading="The Gaps Do Not Feel Urgent <br /><span class='hl'>Until Something Forces the&nbsp;Issue.</span>"
    subhead="Carrier audits. Renewal conversations. A staff member leaving with the passwords. That is when the gaps that sat on a list all year become problems."
    cards={[
      {
        title: "IT and security gaps nobody documented",
        body: "MFA that was partially implemented. Backups that run but have never been tested. An incident response plan that does not exist or reflects a setup from three years ago."
      },
      {
        title: "Marketing that is not working for renewal season",
        body: "A website that does not show up in local search. A Google Business Profile that has not been updated since it was created. A contact form nobody checks."
      },
      {
        title: "AI projects that never got started",
        body: "January goals. Q1 priorities. Back-burner items that are still sitting where they were left in February. The second half of the year will move faster."
      }
    ]}
  />

  <NumberedCardsList
    sectionLabel="What the Checklist Covers"
    heading="Three Sections. Fifteen Minutes. <br />A Clear Picture of Where to&nbsp;Focus."
    cards={[
      {
        title: "IT and security",
        body: "MFA enforcement, backup validation and restore testing, incident response documentation, security assessment currency, NYDFS and carrier requirement alignment, and documentation storage. 6 to 8 items with a why-it-matters note for each."
      },
      {
        title: "Marketing and digital presence",
        body: "Website performance and lead capture, local SEO and Google Business Profile, contact form routing, privacy policy currency, SSL configuration, and review presence. 6 to 8 items with one-action takeaways."
      },
      {
        title: "AI and workflow efficiency",
        body: "Document generation automation, AMS workflow efficiency, manual process identification, AI tool evaluation and governance, and staff time allocation. 6 to 8 items with an honest self-assessment for each."
      },
      {
        title: "Scoring guide",
        body: "Routes you to the right next step based on which section had the most unchecked items. IT-heavy result leads to a compliance review. Marketing-heavy leads to a marketing review. AI-heavy leads to a SharePoint and AI consult."
      }
    ]}
  />

  <StatsBar />
  <AboutArchway />
  <WhyChooseUs />
  <Testimonials />

  <BottomCTA
    heading="Ready to Find Out Where You Stand?"
    subtext="Download the checklist and get a clear picture of what your agency’s technology looks like at the halfway point of 2026."
    ctaText="Get the Free Checklist"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  :global(.problem-header h2 .hl) {
    color: var(--orange);
  }
</style>

