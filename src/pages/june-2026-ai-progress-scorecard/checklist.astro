---
import ArchwayLayout from '../../layouts/ArchwayLayout.astro';

const HUBSPOT_PORTAL_ID = '6869933';
const HUBSPOT_FORM_ID = '37e242b1-e97b-45d8-878d-f6a0b3a0a0a0';

const section1 = {
  number: '01',
  title: 'Document Generation and Workflow Automation',
  subtitle: 'Where most agencies have the fastest ROI.',
  intro: 'Document generation and workflow automation are where independent agencies capture efficiency fastest. Check every item that is fully in place at your agency right now. Leave unchecked anything that is manual, partial, or you are unsure about.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's1q1',
      title: 'Certificates of insurance are generated automatically',
      body: 'COI generation from AMS data on request, not produced manually for every request.'
    },
    {
      key: 's1q2',
      title: 'Renewal letters and notices are generated automatically',
      body: 'Templates populated from AMS renewal data, not written from scratch each renewal.'
    },
    {
      key: 's1q3',
      title: 'Policy summaries for clients are AI-generated',
      body: 'AI generates summaries from policy data on request rather than staff writing them by hand.'
    },
    {
      key: 's1q4',
      title: 'Call logging to AMS is automated',
      body: 'Call recording creates AMS activity notes automatically. Staff does not manually log calls after every conversation.'
    },
    {
      key: 's1q5',
      title: 'Commission statement processing is automated',
      body: 'AI extracts and posts commission data from carrier statements automatically.'
    },
    {
      key: 's1q6',
      title: 'Renewal follow-up sequences run automatically',
      body: 'Sequences trigger from AMS policy dates without staff intervention.'
    },
    {
      key: 's1q7',
      title: 'New business intake is automated',
      body: 'Declarations page uploads or AI intake pre-fill the application. Staff is not re-keying client data.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'Strong automation in place', body: 'Most of the high-ROI automation is captured. Move on to Section 2.' },
    { range: '2–3 unchecked', title: 'Specific automations to capture', body: 'Pick the one with the most staff hours behind it and start there.' },
    { range: '4+ unchecked', title: 'Significant automation opportunity', body: 'Document generation and workflow automation are the fastest ROI implementations. Worth a conversation.' }
  ]
};

const section2 = {
  number: '02',
  title: 'Client Communication',
  subtitle: 'Where staff time disappears into the inbox.',
  intro: 'Client communication efficiency determines how much of your team’s time goes to answering questions that a well-built system could handle. Check every item your agency has fully in place.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's2q1',
      title: 'Inbound inquiry routing is automated',
      body: 'AI-assisted routing sends inquiries to the right person automatically rather than a general inbox manually sorted.'
    },
    {
      key: 's2q2',
      title: 'FAQ handling is AI-assisted',
      body: 'AI handles common questions with staff review before sending, rather than staff answering every FAQ individually.'
    },
    {
      key: 's2q3',
      title: 'Renewal communication runs automatically',
      body: 'Renewal communication sequences run from policy dates rather than being triggered manually.'
    },
    {
      key: 's2q4',
      title: 'Certificate requests are automated end to end',
      body: 'Cert generation runs from AMS data on request, not handled manually from start to finish.'
    },
    {
      key: 's2q5',
      title: 'COI compliance review is automated',
      body: 'AI reads incoming certificates against contract requirements and flags gaps automatically.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'Communication is efficient', body: 'Move on to Section 3.' },
    { range: '2–3 unchecked', title: 'Specific items to automate', body: 'Each one reclaims real staff time per week.' },
    { range: '4+ unchecked', title: 'Significant inbox time being lost', body: 'COI compliance and renewal sequences are good starting points.' }
  ]
};

const section3 = {
  number: '03',
  title: 'AMS Efficiency',
  subtitle: 'How much of your AMS are you actually using?',
  intro: 'Most independent agencies use about 40 percent of what their AMS is capable of. This section measures whether your agency has captured the efficiency the system already supports. Check every item that is fully in place.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's3q1',
      title: 'Core workflows are automated in the AMS',
      body: 'Renewals, follow-ups, and task generation are configured rather than the AMS being used primarily as a database.'
    },
    {
      key: 's3q2',
      title: 'Data quality is consistent and enforced',
      body: 'Data entry standards exist and regular audits run. Duplicates are rare and historical data is reliable.'
    },
    {
      key: 's3q3',
      title: 'Scheduled AMS reports run automatically',
      body: 'Reports for key metrics run on a schedule rather than being built manually from exported data.'
    },
    {
      key: 's3q4',
      title: 'AMS is connected to email and phone',
      body: 'Integrations are active so activity logs and communication track to the right client records automatically.'
    },
    {
      key: 's3q5',
      title: 'AMS is connected to carrier systems',
      body: 'Key carrier portals are integrated so download workflows run without manual lookups.'
    },
    {
      key: 's3q6',
      title: 'Staff training and adoption is current',
      body: 'Regular training happens and the team uses most of the AMS features available rather than just the basics.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'AMS is working hard', body: 'You are getting most of what the system supports.' },
    { range: '2–3 unchecked', title: 'Underutilized capabilities', body: 'Specific configuration or training will close the gaps.' },
    { range: '4+ unchecked', title: 'AMS is being underused', body: 'The system already supports more than you are getting. Worth an audit.' }
  ]
};
---

<ArchwayLayout
  title="AI Adoption Progress Scorecard | Archway"
  description="Interactive AI adoption scorecard for independent insurance agencies. Score yourself across document generation, workflow, communication, and AMS efficiency."
  ctaText="Start the Scorecard"
  ctaHref="#section-01"
>
  <!-- Hero -->
  <section class="checklist-hero">
    <div class="checklist-hero-inner">
      <div class="hero-badge">AI Adoption Progress  ·  June 2026</div>
      <p class="kicker">A Practical Scorecard  ·  For Independent Agencies</p>
      <h1>AI Adoption Progress <span class='hl'>Scorecard.</span><br />For independent insurance&nbsp;agencies.</h1>
      <p class="hero-sub">Ten minutes. An honest picture of where your agency&rsquo;s AI adoption actually stands, and what to do next.</p>
      <p class="hero-intro">Most agencies that planned to do something with AI this year are somewhere between started and stalled. This scorecard covers the three areas where independent agencies get the most traction. Check every item that is fully in place. The unchecked items are your next opportunities, scored against where most agencies actually are.</p>

      <div class="hero-ctas">
        <a href="#section-01" class="hero-cta-primary">
          Start the Scorecard
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <p class="hero-meta">10 minutes  ·  3 sections  ·  A scored band and a recommended next step</p>
    </div>
  </section>

  <!-- How to use -->
  <section class="how-to-use">
    <div class="how-to-inner">
      <p class="how-label">How to Use This Scorecard</p>
      <div class="how-steps">
        <div class="how-step">
          <div class="how-num">1</div>
          <div class="how-text">
            <strong>Work through all three sections.</strong>
            <p>Document Generation and Workflow, Client Communication, and AMS Efficiency.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">2</div>
          <div class="how-text">
            <strong>Check the box only if it is fully in place.</strong>
            <p>Partial or in-progress counts as unchecked. The score is honest by design.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">3</div>
          <div class="how-text">
            <strong>Find your band at the end.</strong>
            <p>Behind, On Track, or Ahead. Each band has a recommended next step.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {[section1, section2, section3].map((section) => (
    <section id={`section-${section.number}`} class={`checklist-section section-${section.number}`} data-section={section.number} data-count-label={section.countLabel}>
      <div class="checklist-inner">
        <div class="section-header">
          <span class="section-pill">Section {section.number}</span>
          <h2>{section.title}</h2>
          <p class="section-sub">{section.subtitle}</p>
          <p class="section-intro">{section.intro}</p>
        </div>

        <div class="checklist-items">
          {section.items.map((item, i) => (
            <label class="check-item" for={item.key}>
              <input type="checkbox" id={item.key} data-section={section.number} data-title={item.title} />
              <span class="check-box" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 8 7 12 13 4"/></svg>
              </span>
              <div class="check-content">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="check-num">{String(i + 1).padStart(2, '0')}</div>
            </label>
          ))}
        </div>

        <div class="scoring-block" data-section-score={section.number}>
          <p class="scoring-label">Section {parseInt(section.number)} Scoring Guide  ·  Count {section.countLabel} items</p>
          <div class="scoring-bands">
            {section.bands.map((band, i) => (
              <div class="scoring-band" data-band-index={i}>
                <div class="band-num">{i + 1}</div>
                <div class="band-content">
                  <p class="band-range">{band.range}  ·  <strong>{band.title}</strong></p>
                  <p class="band-body">{band.body}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="live-tally">
            <span class="live-tally-label">Your section score:</span>
            <span class="live-tally-num" data-tally={section.number}>0</span>
            <span class="live-tally-suffix">{section.countLabel}</span>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Final Result -->
  <section class="result-section">
    <div class="result-inner">
      <p class="result-label">Your Result  ·  Scoring Guide</p>
      <h2>Count your unchecked items across <span class='hl'>all three sections.</span></h2>
      <p class="result-sub">That is your AI adoption gap. The fewer unchecked items, the further along you are. Find your band below.</p>

      <div class="result-card">
        <div class="result-tally">
          <p class="result-tally-label">Total Unchecked</p>
          <div class="result-tally-num"><span data-final-tally>0</span><span class="tally-divider">/18</span></div>
          <p class="result-tally-sub">Sections 1 + 2 + 3 combined</p>
        </div>
        <div class="result-formula">
          <p class="result-formula-label">Tally Your Score</p>
          <div class="formula-row">
            <span class="formula-num" data-section-tally="01">0</span>
            <span class="formula-op">+</span>
            <span class="formula-num" data-section-tally="02">0</span>
            <span class="formula-op">+</span>
            <span class="formula-num" data-section-tally="03">0</span>
            <span class="formula-op">=</span>
            <span class="formula-num" data-final-tally>0</span>
          </div>
          <p class="result-formula-sub">Document + Communication + AMS Efficiency = Total. The active band below is the one you fall into.</p>
        </div>
      </div>

      <div class="result-bands">
        <div class="result-band" data-band="0-4">
          <p class="result-band-range">0–4 Unchecked</p>
          <h3>Ahead</h3>
          <p>Your agency is ahead of most independent agencies on AI and automation adoption. The opportunity now is expansion. Round out the items that are still partial and connect the automations you already have.</p>
          <p class="result-band-action">Book a strategy call to identify <strong>the next layer</strong> of efficiency in your current setup.</p>
        </div>
        <div class="result-band" data-band="5-11">
          <p class="result-band-range">5–11 Unchecked</p>
          <h3>On Track</h3>
          <p>You have meaningful progress with gaps remaining in at least two sections. The next step is identifying which gaps carry the most cost and building from there. Most agencies in this band are one or two implementations away from a meaningfully more efficient operation.</p>
          <p class="result-band-action">Pick the unchecked item with the most staff hours behind it and <strong>start there</strong>.</p>
        </div>
        <div class="result-band" data-band="12+">
          <p class="result-band-range">12 or More Unchecked</p>
          <h3>Behind</h3>
          <p>Your agency has significant manual workflows ready for automation. The good news: the highest-impact implementations are well-established and your AMS likely already supports several of them. Pick one problem, build one solution, measure the result, then add more.</p>
          <p class="result-band-action">Book a 30-minute call with Sam to identify <strong>where to start</strong>.</p>
        </div>
      </div>

      <div class="section3-callout">
        <p class="section3-callout-label">Your AMS Efficiency Results</p>
        <h3>Most agencies are using <span class='hl'>about 40 percent</span> of what their AMS supports.</h3>
        <p>The Section 3 items that came back unchecked are the ones where your AMS likely supports more than your agency is using today. That is the cheapest form of automation: configuration of capabilities you already paid for.</p>
        <p>Sam Ruben leads AI and automation at Archway and works exclusively with independent insurance agencies on Applied Epic, AMS360, HawkSoft, EZLynx, and Vertafore. He knows what each system supports and where most agencies leave efficiency on the table.</p>
        <p><strong>If you had two or more unchecked items in Section 3, a 30-minute call with Sam is worth your time.</strong> He will walk through what your AMS already supports, what to configure first, and what a realistic 90-day plan looks like.</p>
      </div>
    </div>
  </section>

  <!-- Save Form -->
  <section class="save-section" id="save-form">
    <div class="save-inner">
      <div class="save-header">
        <p class="save-label">Save Your Results</p>
        <h2>Send your checklist to your inbox and to&nbsp;Sam.</h2>
        <p class="save-sub">Get a copy of your results plus a personalized recommendation based on what you checked. No pitch, just an honest look at where to start.</p>
      </div>

      <div class="save-form-card">
        <div id="hs-checklist-form"></div>
        <p class="save-trust">Archway works exclusively with independent insurance agencies.</p>
      </div>
    </div>
  </section>

  <!-- Pass form config to client script -->
  <script is:inline define:vars={{ HUBSPOT_PORTAL_ID, HUBSPOT_FORM_ID }}>
    window.__HS_CHECKLIST_CONFIG__ = { portalId: HUBSPOT_PORTAL_ID, formId: HUBSPOT_FORM_ID };
  </script>
</ArchwayLayout>

<style>
  /* HERO */
  .checklist-hero {
    background-color: #1e3350;
    background-image: url('/images/dark-bg.png');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
    padding: 80px 24px 60px;
    position: relative;
  }

  .checklist-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(29, 50, 70, 0.88);
    z-index: 0;
  }

  .checklist-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 50px;
    margin-bottom: 28px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .kicker {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .checklist-hero h1 {
    font-size: 52px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .checklist-hero h1 em {
    font-style: normal;
    color: var(--orange);
  }

  .hero-sub {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 24px;
    line-height: 1.4;
  }

  .hero-intro {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 780px;
    margin-bottom: 36px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: #ffffff;
    padding: 18px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 17px;
    transition: all 0.2s;
  }

  .hero-cta-primary:hover {
    background: var(--orange-dark);
    transform: translateY(-1px);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    color: #ffffff;
    padding: 18px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    transition: all 0.2s;
  }

  .hero-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.05);
  }

  .hero-meta {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    font-style: italic;
  }

  /* HOW TO USE */
  .how-to-use {
    background: #ffffff;
    padding: 56px 24px;
  }

  .how-to-inner {
    max-width: 1000px;
    margin: 0 auto;
    border: 1px solid rgba(244, 128, 33, 0.25);
    border-radius: 12px;
    padding: 28px 32px;
    background: rgba(244, 128, 33, 0.04);
  }

  .how-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .how-step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .how-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: var(--orange);
    color: #ffffff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
  }

  .how-text strong {
    display: block;
    font-size: 15px;
    color: var(--charcoal);
    font-weight: 700;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .how-text p {
    font-size: 14px;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0;
  }

  /* CHECKLIST SECTION */
  .checklist-section {
    background: #ffffff;
    padding: 48px 24px;
  }

  .checklist-section.section-02 {
    background: var(--light-bg);
  }

  .checklist-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .section-pill {
    display: inline-block;
    background: var(--orange);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 6px;
    margin-bottom: 16px;
  }

  .section-header h2 {
    font-size: 40px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.2;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .section-sub {
    font-size: 16px;
    font-weight: 700;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .section-intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-light);
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 24px;
    margin: 0;
  }

  /* CHECK ITEMS */
  .checklist-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }

  .check-item {
    display: grid;
    grid-template-columns: 24px 1fr 36px;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 24px;
    background: #ffffff;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    position: relative;
  }

  .checklist-section.section-02 .check-item {
    background: #ffffff;
  }

  .check-item:hover {
    border-color: rgba(244, 128, 33, 0.5);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .check-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .check-box {
    width: 24px;
    height: 24px;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    transition: all 0.15s;
    flex-shrink: 0;
  }

  .check-item:has(input:checked) {
    border-color: var(--orange);
    background: rgba(244, 128, 33, 0.04);
  }

  .check-item:has(input:checked) .check-box {
    background: var(--orange);
    border-color: var(--orange);
    color: #ffffff;
  }

  .check-content h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .check-content p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  .check-num {
    font-size: 13px;
    font-weight: 700;
    color: #cbd5e1;
    text-align: right;
    line-height: 1.4;
    align-self: flex-start;
  }

  /* SCORING BLOCK */
  .scoring-block {
    border: 1px solid rgba(244, 128, 33, 0.25);
    border-radius: 12px;
    padding: 24px 28px;
    background: rgba(244, 128, 33, 0.04);
  }

  .scoring-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
  }

  .scoring-bands {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  .scoring-band {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--card-border);
    transition: all 0.2s;
  }

  .scoring-band[data-band-index="0"] .band-num {
    background: rgba(34, 197, 94, 0.12);
    color: #22c55e;
  }

  .scoring-band[data-band-index="1"] .band-num {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
  }

  .scoring-band[data-band-index="2"] .band-num {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
  }

  .scoring-band.active {
    border-color: var(--orange);
