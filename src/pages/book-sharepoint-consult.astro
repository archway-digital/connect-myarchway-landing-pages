---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroComplianceBooking from '../components/compliance/HeroComplianceBooking.astro';
import StatsBar from '../components/shared/StatsBar.astro';
import ServicesGrid from '../components/shared/ServicesGrid.astro';
import AboutArchway from '../components/shared/AboutArchway.astro';
import WhyChooseUs from '../components/shared/WhyChooseUs.astro';
import Testimonials from '../components/shared/Testimonials.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Your Compliance Documents Should Live in SharePoint | Archway"
  description="Book a 30-minute call and we will show you what a properly built compliance documentation system looks like for an agency your size."
  ctaText="Book My SharePoint Consult"
  ctaHref="#hero-form"
>
  <HeroComplianceBooking
    headline="Your Compliance Documents Should Live in SharePoint. <em>Let&rsquo;s Build That.</em>"
    subhead="Book a 30-minute call and we will show you what a properly built compliance documentation system looks like for an agency your size."
    formId="e1df9d70-184c-445b-81c0-8eafe4a62a63"
  />

  <!-- Problem Cards -->
  <section class="section">
    <div class="section-inner">
      <div class="problem-header fade-up">
        <p class="section-label">The Documentation Problem</p>
        <h2>Most Agencies Store Compliance Docs in the Wrong&nbsp;Place</h2>
      </div>
      <div class="problem-grid fade-up">
        <div class="problem-card">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3>In Someone&rsquo;s Inbox</h3>
          <p>Critical documents live in one person&rsquo;s email. When they leave or are unavailable, the documentation goes with them.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3>A PDF Nobody Updates</h3>
          <p>Static documents emailed around once do not reflect your current setup and do not hold up when a carrier asks for proof.</p>
        </div>
        <div class="problem-card">
          <div class="problem-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#f48021" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3>In Someone&rsquo;s Head</h3>
          <p>The person who set everything up knows where it all is. That is not a documentation system. That is a liability.</p>
        </div>
      </div>
    </div>
  </section>

  <StatsBar />
  <ServicesGrid />
  <AboutArchway />
  <WhyChooseUs />

  <!-- What We Build -->
  <section class="section section-light">
    <div class="section-inner">
      <div class="cover-header fade-up">
        <p class="section-label">What We Build with You</p>
        <h2>Living Documents That Work When Someone Actually Needs&nbsp;Them.</h2>
      </div>
      <div class="cover-grid fade-up">
        <div class="cover-card">
          <h3>Which Documents You Need</h3>
          <p>We start with a compliance review to identify exactly which SOPs and policies your agency needs on file.</p>
        </div>
        <div class="cover-card">
          <h3>SharePoint Structure and Access</h3>
          <p>We build a folder structure that gives the right people access and makes every document findable without asking someone.</p>
        </div>
        <div class="cover-card">
          <h3>Incident Response Plan</h3>
          <p>We write or update your incident response plan so it reflects your current setup and is ready when a carrier asks for it.</p>
        </div>
        <div class="cover-card">
          <h3>Keeping Docs Current</h3>
          <p>We set up versioning and a simple update process so documents stay accurate as your setup and carrier requirements change.</p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <BottomCTA
    heading="Ready to Build a Documentation System That Actually Works?"
    subtext="Book 30 minutes. We will walk through what your agency needs and show you what it looks like when it is done right."
    ctaText="Book My 30-Minute Call"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

<style>
  .section-label {
    text-align: center;
    display: block;
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .section-label::before {
    display: none;
  }

  /* Problem Cards */
  .problem-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .problem-header h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.3;
    text-wrap: balance;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .problem-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 32px 24px;
  }

  .problem-icon {
    width: 48px;
    height: 48px;
    background: rgba(244, 128, 33, 0.08);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .problem-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .problem-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  /* Coverage Cards */
  .cover-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .cover-header h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.3;
    text-wrap: balance;
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .cover-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 32px;
  }

  .cover-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--charcoal);
    margin-bottom: 8px;
  }

  .cover-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0;
  }

  @media (max-width: 768px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }

    .cover-grid {
      grid-template-columns: 1fr;
    }

    .problem-header h2,
    .cover-header h2 {
      font-size: 26px;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
