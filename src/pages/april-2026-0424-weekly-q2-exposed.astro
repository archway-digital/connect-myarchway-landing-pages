---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroComplianceBooking from '../components/compliance/HeroComplianceBooking.astro';
import ComplianceBody from '../components/compliance/ComplianceBody.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Q2 Starts Monday. Do Not Head In Exposed. | Archway"
  description="Book your compliance review now while we still have April capacity. Most reviews are completed within two weeks of booking."
  ctaText="Request My Compliance Review"
  ctaHref="#hero-form"
>
  <HeroComplianceBooking
    headline="Q2 Starts Monday. <span class='hl'>Do Not Head In Exposed.</span>"
    subhead="Book your compliance review now while we still have April capacity. Most reviews are completed within two weeks of booking."
    formId="PLACEHOLDER_FORM_ID_11"
  />
  <ComplianceBody
    bodyHtml="<p>The window to get a compliance review done before mid-Q2 is the next few weeks. After that, things get busy, it gets pushed, and you head into Cybersecurity Awareness Month with the same gaps you had in April.</p><p>A compliance review from Archway covers your security controls, MFA enforcement, backup validation, incident response documentation, and carrier requirement alignment. You walk away with a written report and a prioritized list of what to fix.</p><p>Price range is $689 to $4,080. Most reviews are completed within two weeks of booking. We have capacity now.</p>"
    bullets={[
      "Security controls and access management",
      "MFA enforcement across all users and systems",
      "Backup and disaster recovery validation",
      "Incident response plan review or creation",
      "NYDFS and carrier cyber requirement alignment",
      "Written findings report and remediation priority list"
    ]}
    authorityLine="Archway works exclusively with independent insurance agencies. We know what carriers are asking for because we help agencies answer those questions every day."
  />
  <BottomCTA
    heading="Ready to find out where you stand?"
    subtext="Book your compliance review now. Most reviews are completed within two weeks of booking."
    ctaText="Request My Compliance Review"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

