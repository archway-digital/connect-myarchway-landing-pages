---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroComplianceDownload from '../components/compliance/HeroComplianceDownload.astro';
import ComplianceBody from '../components/compliance/ComplianceBody.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Is Your Agency Ready for Compliance Season? | Archway"
  description="Download the free compliance checklist insurance agencies are using to close gaps before carrier conversations catch them off guard."
  ctaText="Get the Free Checklist"
  ctaHref="#hero-form"
>
  <HeroComplianceDownload
    headline="Is Your Agency Ready for <em>Compliance Season?</em>"
    subhead="Download the free checklist insurance agencies are using to close gaps before carrier conversations catch them off guard."
    formId="PLACEHOLDER_FORM_ID_01"
  />
  <ComplianceBody
    bodyHtml="<p>Every spring, carriers start asking questions agencies are not prepared to answer. This checklist walks through the areas most agencies have not looked at in more than a year: MFA enforcement, backup validation, incident response documentation, and more.</p><p>It takes less than 10 minutes to review. Most agencies find at least one gap they did not know they had.</p>"
    bullets={[
      "The 7 security areas carriers are actively reviewing in 2026",
      "A quick self-assessment for MFA, backup, and access controls",
      "What NYDFS compliance actually requires for your agency type",
      "Incident response basics and what you need on file",
      "A simple scoring guide so you know where to focus first"
    ]}
  />
  <BottomCTA
    heading="Already know there are gaps?"
    subtext="Some agencies review the checklist and immediately spot something that needs attention. If that is you, book a compliance review and we will walk through it together."
    ctaText="Request My Compliance Review"
    ctaHref="/april-2026-0409-weekly-compliance-cost"
  />
</ArchwayLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
