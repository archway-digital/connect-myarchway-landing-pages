---
import ArchwayLayout from '../../layouts/ArchwayLayout.astro';

const HUBSPOT_PORTAL_ID = '6869933';
const HUBSPOT_FORM_ID = '37e242b1-e97b-45d8-878d-f6a0b3a0a0a0';

const section1 = {
  number: '01',
  title: 'IT and Security',
  subtitle: 'How carrier-ready is your security posture?',
  intro: 'Your security posture determines how your agency responds to carrier audits, cyber incidents, and renewal conversations. Most agencies have pieces of this in place. Few have it fully documented.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's1q1',
      title: 'MFA fully enforced',
      body: 'Every account, including admin, service, and shared accounts, requires multi-factor authentication. Not just enabled. Enforced.'
    },
    {
      key: 's1q2',
      title: 'Backups restore-tested',
      body: 'Backups run on a schedule and a successful restore has been tested and documented in the last 90 days.'
    },
    {
      key: 's1q3',
      title: 'Incident response plan current',
      body: 'A written incident response plan exists, reflects the current system setup, and is accessible to the right people.'
    },
    {
      key: 's1q4',
      title: 'Offboarding process documented',
      body: 'A checklist exists for removing access to all systems when a staff member leaves. It ran the last time someone left.'
    },
    {
      key: 's1q5',
      title: 'Endpoint protection active',
      body: 'Every device used for agency work has endpoint detection and response software installed and monitored.'
    },
    {
      key: 's1q6',
      title: 'Carrier requirements reviewed',
      body: 'The agency has reviewed what its cyber carrier requires and confirmed the current setup meets those requirements.'
    },
    {
      key: 's1q7',
      title: 'Vulnerability scan completed',
      body: 'A vulnerability scan has been run in the last 12 months and any findings have been addressed or documented.'
    },
    {
      key: 's1q8',
      title: 'Security training current',
      body: 'Staff has completed security awareness training in the last 12 months covering phishing, password hygiene, and device safety.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'Strong IT posture', body: 'Move on to Section 2.' },
    { range: '2–3 unchecked', title: 'Gaps worth addressing', body: 'Address before your next carrier renewal conversation.' },
    { range: '4+ unchecked', title: 'Book a compliance review', body: 'These gaps represent real carrier and E&O risk.' }
  ]
};

const section2 = {
  number: '02',
  title: 'Marketing and Digital Presence',
  subtitle: 'Does your agency show up the way it should?',
  intro: 'Your digital presence determines whether prospects find your agency before they find someone else. Most independent agency websites and profiles have not been updated to reflect the agency as it actually operates today.',
  countLabel: 'unchecked',
  items: [
    {
      key: 's2q1',
      title: 'Website loads in under 3 seconds on mobile',
      body: 'A prospect who waits longer is gone before they read a word.'
    },
    {
      key: 's2q2',
      title: 'Google Business Profile updated in last 30 days',
      body: 'Hours, photos, description, and contact information are current and accurate.'
    },
    {
      key: 's2q3',
      title: 'Local SEO configured',
      body: 'The agency appears in local search results when someone searches for an insurance agency in your area.'
    },
    {
      key: 's2q4',
      title: 'Contact form routes to the right person',
      body: 'Form submissions go to someone who responds within one business day.'
    },
    {
      key: 's2q5',
      title: 'Reviews responded to',
      body: 'All Google reviews from the last 90 days have a response from the agency.'
    },
    {
      key: 's2q6',
      title: 'Social media active',
      body: 'At least one platform has been posted to in the last 30 days with agency-relevant content.'
    },
    {
      key: 's2q7',
      title: 'Email list engaged',
      body: 'The agency sends regular email communication and the open rate is above 15 percent.'
    },
    {
      key: 's2q8',
      title: 'Content published in last 60 days',
      body: 'A blog post, article, or resource has been added to the website in the last 60 days.'
    }
  ],
  bands: [
    { range: '0–1 unchecked', title: 'Strong digital presence', body: 'Move on to Section 3.' },
    { range: '2–3 unchecked', title: 'Gaps worth closing', body: 'Address before renewal season peaks in Q3.' },
    { range: '4+ unchecked', title: 'Book a marketing review', body: 'Your agency is losing leads before anyone calls.' }
  ]
};

const section3 = {
  number: '03',
  title: 'AI and Workflow Efficiency',
  subtitle: 'Where automation will move the needle.',
  intro: 'The agencies getting results from AI and workflow automation are not the ones who bought the most tools. They started with one specific workflow problem and solved it completely. Check every item that applies to your agency right now. Your checked items are your highest-value starting points.',
  countLabel: 'checked',
  items: [
    {
      key: 's3q1',
      title: 'Staff manually logs call notes into the AMS',
      body: 'Every call that ends with manual data entry is a candidate for automation.'
    },
    {
      key: 's3q2',
      title: 'Commission statements are entered manually',
      body: 'Carrier statements processed by hand each month have a fully automated alternative.'
    },
    {
      key: 's3q3',
      title: 'Certificates of insurance are produced manually',
      body: 'Document generation automation eliminates this entirely for most policy types.'
    },
    {
      key: 's3q4',
      title: 'Renewal follow-up depends on someone remembering',
      body: 'Renewal sequences configured in your AMS run without staff intervention once set up.'
    },
    {
      key: 's3q5',
      title: 'Reports require pulling data from more than one system',
      body: 'AI reporting automation eliminates the aggregation step for most standard reports.'
    },
    {
      key: 's3q6',
      title: 'New business intake requires manual data entry',
      body: 'A prospect’s declarations page upload should pre-fill the application automatically.'
    },
    {
      key: 's3q7',
      title: 'COI review is done manually line by line',
      body: 'Certificate Desk reads certs against contract requirements automatically and flags the gaps.'
    },
    {
      key: 's3q8',
      title: 'No written SOPs for at least three core workflows',
      body: 'SOP generators produce first drafts from recordings or transcripts in minutes.'
    }
  ],
  bands: [
    { range: '1–2 checked', title: 'Start with the costliest', body: 'Pick the one that costs the most staff hours per week.' },
    { range: '3–4 checked', title: 'Multiple starting points', body: 'Prioritize by staff hours saved and AMS connection.' },
    { range: '5+ checked', title: 'Significant opportunity', body: 'Book a call to build a sequenced plan.' }
  ]
};
---

<ArchwayLayout
  title="Mid-Year Technology Audit Checklist | Archway"
  description="Interactive mid-year technology audit checklist for independent insurance agencies. Score your IT, marketing, and AI setup at the halfway point of 2026."
  ctaText="Start the Checklist"
  ctaHref="#section-01"
>
  <!-- Hero -->
  <section class="checklist-hero">
    <div class="checklist-hero-inner">
      <div class="hero-badge">Mid-Year Technology Checkpoint  ·  June 2026</div>
      <p class="kicker">A Practical Checklist  ·  For Independent Agencies</p>
      <h1>Mid-Year Technology <span class='hl'>Audit Checklist.</span><br />For independent insurance&nbsp;agencies.</h1>
      <p class="hero-sub">Find out where your IT, marketing, and AI setup actually stands at the halfway point of 2026.</p>
      <p class="hero-intro">This checklist covers the areas where most agencies find gaps they did not know were there. Work through each section, check the boxes that apply, and use the scoring guide at the end to identify where to focus before Q3.</p>

      <div class="hero-ctas">
        <a href="#section-01" class="hero-cta-primary">
          Start the Checklist
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <p class="hero-meta">15 minutes  ·  3 sections  ·  An honest score and a recommended next step</p>
    </div>
  </section>

  <!-- How to use -->
  <section class="how-to-use">
    <div class="how-to-inner">
      <p class="how-label">How to Use This Checklist</p>
      <div class="how-steps">
        <div class="how-step">
          <div class="how-num">1</div>
          <div class="how-text">
            <strong>Work through all three sections.</strong>
            <p>IT and security, marketing and digital presence, and AI and workflow efficiency.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">2</div>
          <div class="how-text">
            <strong>Check the box if your agency has it in place.</strong>
            <p>Leave it unchecked if it is not done or you are unsure.</p>
          </div>
        </div>
        <div class="how-step">
          <div class="how-num">3</div>
          <div class="how-text">
            <strong>Count your unchecked items per section.</strong>
            <p>Use the scoring guide at the end to find your recommended next step.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {[section1, section2, section3].map((section) => (
    <section id={`section-${section.number}`} class={`checklist-section section-${section.number}`} data-section={section.number} data-count-label={section.countLabel}>
      <div class="checklist-inner">
        <div class="section-header">
          <span class="section-pill">Section {section.number}</span>
          <h2>{section.title}</h2>
          <p class="section-sub">{section.subtitle}</p>
          <p class="section-intro">{section.intro}</p>
        </div>

        <div class="checklist-items">
          {section.items.map((item, i) => (
            <label class="check-item" for={item.key}>
              <input type="checkbox" id={item.key} data-section={section.number} data-title={item.title} />
              <span class="check-box" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 8 7 12 13 4"/></svg>
              </span>
              <div class="check-content">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <div class="check-num">{String(i + 1).padStart(2, '0')}</div>
            </label>
          ))}
        </div>

        <div class="scoring-block" data-section-score={section.number}>
          <p class="scoring-label">Section {parseInt(section.number)} Scoring Guide  ·  Count {section.countLabel} items</p>
          <div class="scoring-bands">
            {section.bands.map((band, i) => (
              <div class="scoring-band" data-band-index={i}>
                <div class="band-num">{i + 1}</div>
                <div class="band-content">
                  <p class="band-range">{band.range}  ·  <strong>{band.title}</strong></p>
                  <p class="band-body">{band.body}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="live-tally">
            <span class="live-tally-label">Your section score:</span>
            <span class="live-tally-num" data-tally={section.number}>0</span>
            <span class="live-tally-suffix">{section.countLabel}</span>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Final Result -->
  <section class="result-section">
    <div class="result-inner">
      <p class="result-label">Your Result  ·  Scoring Guide</p>
      <h2>Count your unchecked items across <span class='hl'>Sections 1 &amp; 2.</span></h2>
      <p class="result-sub">That is your readiness score. Find your band below, it tells you the single highest-leverage move to make next before Q3.</p>

      <div class="result-card">
        <div class="result-tally">
          <p class="result-tally-label">Total Unchecked</p>
          <div class="result-tally-num"><span data-final-tally>0</span><span class="tally-divider">/16</span></div>
          <p class="result-tally-sub">Sections 1 (IT and Security) + 2 (Marketing)</p>
        </div>
        <div class="result-formula">
          <p class="result-formula-label">Tally Your Score</p>
          <div class="formula-row">
            <span class="formula-num" data-section-tally="01">0</span>
            <span class="formula-op">+</span>
            <span class="formula-num" data-section-tally="02">0</span>
            <span class="formula-op">=</span>
            <span class="formula-num" data-final-tally>0</span>
          </div>
          <p class="result-formula-sub">Section 1 unchecked + Section 2 unchecked = Total. The active band below is the one you fall into.</p>
        </div>
      </div>

      <div class="result-bands">
        <div class="result-band" data-band="0-5">
          <p class="result-band-range">0–5 Unchecked</p>
          <h3>Strong Foundation</h3>
          <p>Your agency has strong fundamentals across IT and marketing. Your next step is Section 3. The items you checked there are your highest-priority automation starting points. Pick one and build from there.</p>
          <p class="result-band-action">Focus on <strong>Section 3</strong>. Archway has built most of these workflows for live agency clients.</p>
        </div>
        <div class="result-band" data-band="6-14">
          <p class="result-band-range">6–14 Unchecked</p>
          <h3>Gaps to Address</h3>
          <p>Your agency has meaningful gaps in at least one area. The good news: most of these are fixable before Q3. Focus on the section with the most unchecked items first.</p>
          <p class="result-band-action">Book a <strong>mid-year review</strong> and we will walk through which items to address in what order.</p>
        </div>
        <div class="result-band" data-band="15+">
          <p class="result-band-range">15 or More Unchecked</p>
          <h3>Build the Foundation</h3>
          <p>Your agency has significant gaps across multiple areas. The right move is a structured mid-year review before Q3 starts.</p>
          <p class="result-band-action">Archway can tell you specifically what to address first, second, and third based on your actual situation.</p>
        </div>
      </div>

      <div class="section3-callout">
        <p class="section3-callout-label">Your Section 3 Results</p>
        <h3>What you checked in <span class='hl'>Section 3</span> is where automation starts.</h3>
        <p>Every item you checked in Section 3 is a workflow Archway has automated for an independent insurance agency. Call recording to AMS activity creation, commission statement automation, document generation workflows, renewal sequences, intake automation, COI review through Certificate Desk, and SOP generators.</p>
        <p>Sam Ruben leads AI and automation at Archway. He works exclusively with independent insurance agencies and has built these workflows for agencies your size.</p>
        <p><strong>If you checked two or more items in Section 3, a 30-minute call with Sam is worth your time.</strong> He will look at what you checked, tell you which one delivers the fastest ROI for an agency like yours, and walk you through what implementation actually looks like.</p>
      </div>
    </div>
  </section>

  <!-- Save Form -->
  <section class="save-section" id="save-form">
    <div class="save-inner">
      <div class="save-header">
        <p class="save-label">Save Your Results</p>
        <h2>Send your checklist to your inbox and to&nbsp;Sam.</h2>
        <p class="save-sub">Get a copy of your results plus a personalized recommendation based on what you checked. No pitch, just an honest look at where to start.</p>
      </div>

      <div class="save-form-card">
        <div id="hs-checklist-form"></div>
        <p class="save-trust">Archway works exclusively with independent insurance agencies.</p>
      </div>
    </div>
  </section>

  <!-- Pass form config to client script -->
  <script is:inline define:vars={{ HUBSPOT_PORTAL_ID, HUBSPOT_FORM_ID }}>
    window.__HS_CHECKLIST_CONFIG__ = { portalId: HUBSPOT_PORTAL_ID, formId: HUBSPOT_FORM_ID };
  </script>
</ArchwayLayout>

<style>
  /* HERO */
  .checklist-hero {
    background-color: #1e3350;
    background-image: url('/images/dark-bg.png');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
    padding: 80px 24px 60px;
    position: relative;
  }

  .checklist-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(29, 50, 70, 0.88);
    z-index: 0;
  }

  .checklist-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 50px;
    margin-bottom: 28px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .kicker {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .checklist-hero h1 {
    font-size: 52px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .checklist-hero h1 em {
    font-style: normal;
    color: var(--orange);
  }

  .hero-sub {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 24px;
    line-height: 1.4;
  }

  .hero-intro {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 780px;
    margin-bottom: 36px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: #ffffff;
    padding: 18px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 17px;
    transition: all 0.2s;
  }

  .hero-cta-primary:hover {
    background: var(--orange-dark);
    transform: translateY(-1px);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    color: #ffffff;
    padding: 18px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    transition: all 0.2s;
  }

  .hero-cta-secondary:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.05);
  }

  .hero-meta {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    font-style: italic;
  }

  /* HOW TO USE */
  .how-to-use {
    background: #ffffff;
    padding: 56px 24px;
  }

  .how-to-inner {
    max-width: 1000px;
    margin: 0 auto;
    border: 1px solid rgba(244, 128, 33, 0.25);
    border-radius: 12px;
    padding: 28px 32px;
    background: rgba(244, 128, 33, 0.04);
  }

  .how-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 20px;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .how-step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .how-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: var(--orange);
    color: #ffffff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
  }

  .how-text strong {
    display: block;
    font-size: 15px;
    color: var(--charcoal);
    font-weight: 700;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .how-text p {
    font-size: 14px;
    color: var(--text-light);
    line-height: 1.5;
    margin: 0;
  }

  /* CHECKLIST SECTION */
  .checklist-section {
    background: #ffffff;
    padding: 48px 24px;
  }

  .checklist-section.section-02 {
    background: var(--light-bg);
  }

  .checklist-inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .section-pill {
    display: inline-block;
    background: var(--orange);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 6px;
    margin-bottom: 16px;
  }

  .section-header h2 {
    font-size: 40px;
    font-weight: 800;
    color: var(--charcoal);
    line-height: 1.2;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .section-sub {
    font-size: 16px;
    font-weight: 700;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .section-intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-light);
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 24px;
    margin: 0;
  }

  /* CHECK ITEMS */
  .checklist-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }

  .check-item {
    display: grid;
    grid-template-columns: 24px 1fr 36px;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 24px;
    background: #ffffff;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    position: relative;
  }

  .checklist-section.section-02 .check-item {
    background: #ffffff;
  }

  .check-item:hover {
    border-color: rgba(244, 128, 33, 0.5);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .check-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .check-box {
    width: 24px;
    height: 24px;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    transition: all 0.15s;
    flex-shrink: 0;
  }

  .check-item:has(input:checked) {
    border-color: var(--orange);
    background: rgba(244, 128, 33, 0.04);
  }

  .check-item:has(input:checked) .check-box {
    background: var(--orange);
    border-color: var(--orange);
    color: #ffffff;
  }

  .check-content h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .check-content p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0;
  }

  .check-num {
    font-size: 13px;
    font-weight: 700;
    color: #cbd5e1;
    text-align: right;
    line-height: 1.4;
    align-self: flex-start;
  }

  /* SCORING BLOCK */
  .scoring-block {
    border: 1px solid rgba(244, 128, 33, 0.25);
    border-radius: 12px;
    padding: 24px 28px;
    background: rgba(244, 128, 33, 0.04);
  }

  .scoring-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
  }

  .scoring-bands {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  .scoring-band {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--card-border);
    transition: all 0.2s;
  }

