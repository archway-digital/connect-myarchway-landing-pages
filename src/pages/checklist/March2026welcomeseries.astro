---
import ArchwayLayout from '../../layouts/ArchwayLayout.astro';
import Hero from '../../components/Hero.astro';
import StatsBar from '../../components/shared/StatsBar.astro';
import Reality from '../../components/Reality.astro';
import WhatsInside from '../../components/WhatsInside.astro';
import WhyNow from '../../components/WhyNow.astro';
import Authority from '../../components/Authority.astro';
import PartnerLogos from '../../components/shared/PartnerLogos.astro';
import BottomCTA from '../../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="12-Point Insurance Agency Cyber Checklist | Archway"
  description="Download the 12-Point Security Checklist built specifically for independent insurance agencies. Know where you're solid, where you're exposed, and what's urgent."
  ctaText="Get the Checklist"
  ctaHref="#hero-form"
>
  <Hero />
  <StatsBar stats={[
    { number: '82%', label: 'of breaches involve the human element' },
    { number: '$4.5M', label: 'average cost of a data breach' },
    { number: '277', label: 'days to identify a breach' },
  ]} />
  <Reality />
  <WhatsInside />
  <WhyNow />
  <Authority />
  <PartnerLogos />
  <BottomCTA
    heading="Ready to see where your agency stands?"
    subtext="Download the 12-point checklist and find out in under 10 minutes."
    ctaText="Get the Checklist"
    ctaHref="#hero-form"
  />
</ArchwayLayout>

