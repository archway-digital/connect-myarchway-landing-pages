---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroComplianceDownload from '../components/compliance/HeroComplianceDownload.astro';
import ComplianceBody from '../components/compliance/ComplianceBody.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Is Your Website a Compliance Risk? | Archway"
  description="Download the free compliance checklist and find out what your website, forms, and data collection practices reveal about your agency's posture."
  ctaText="Get the Free Checklist"
  ctaHref="#hero-form"
>
  <HeroComplianceDownload
    headline="Is Your Website a <em>Compliance Risk?</em>"
    subhead="Download the free compliance checklist and find out what your website, forms, and data collection practices reveal about your agency&rsquo;s posture."
    formId="PLACEHOLDER_FORM_ID_05"
  />
  <ComplianceBody
    bodyHtml="<p>If your agency collects form submissions, stores contact data, or runs any kind of client portal, your website is part of your compliance posture. Carriers and regulators are paying attention to data posture, and most agencies have never looked at their website through that lens.</p><p>This checklist covers both the IT and marketing sides of compliance. Privacy policy currency, form security, SSL configuration, and data handling are all included alongside the core security requirements carriers are reviewing.</p>"
    bullets={[
      "Privacy policy accuracy and data disclosure requirements",
      "Contact form security and data routing",
      "SSL certificate validity and configuration",
      "Data collection practices and what carriers want disclosed",
      "Core IT security areas: MFA, backup, incident response"
    ]}
  />
  <BottomCTA
    heading="Already know there are gaps?"
    subtext="Some agencies review the checklist and immediately spot something that needs attention. If that is you, book a compliance review and we will walk through it together."
    ctaText="Request My Compliance Review"
    ctaHref="/april-2026-0409-weekly-compliance-cost"
  />
</ArchwayLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
