---
import ArchwayLayout from '../layouts/ArchwayLayout.astro';
import HeroComplianceDownload from '../components/compliance/HeroComplianceDownload.astro';
import ComplianceBody from '../components/compliance/ComplianceBody.astro';
import BottomCTA from '../components/shared/BottomCTA.astro';
---

<ArchwayLayout
  title="Your Compliance Docs Should Live in SharePoint | Archway"
  description="Download the free compliance checklist and find out what your agency should have documented, where it should live, and how your current setup compares."
  ctaText="Get the Free Checklist"
  ctaHref="#hero-form"
>
  <HeroComplianceDownload
    headline="Your Compliance Docs Should Live in SharePoint. <span class='hl'>Not in Someone&rsquo;s Inbox.</span>"
    subhead="Download the free compliance checklist and find out what your agency should have documented, where it should live, and how your current setup compares."
    formId="PLACEHOLDER_FORM_ID_03"
  />
  <ComplianceBody
    bodyHtml="<p>Most agencies store their compliance documentation in a folder nobody maintains, a PDF that got emailed around once, or in the memory of whoever set it up. None of those hold up when a carrier asks for it.</p><p>We build editable SOP and compliance documents that live in SharePoint. Versioned, accessible to the right people, and easy to update when carrier requirements change.</p><p>This checklist walks through what your agency should have documented and whether your current storage setup actually works when someone asks for proof.</p>"
    bullets={[
      "Which compliance documents every agency needs on file",
      "Where those documents should live and who should have access",
      "How SharePoint-based SOPs hold up against carrier and auditor requests",
      "MFA enforcement, backup validation, and incident response basics",
      "NYDFS and carrier cyber requirement alignment checklist"
    ]}
  />
  <BottomCTA
    heading="Already know there are gaps?"
    subtext="Some agencies review the checklist and immediately spot something that needs attention. If that is you, book a compliance review and we will walk through it together."
    ctaText="Request My Compliance Review"
    ctaHref="/april-2026-0409-weekly-compliance-cost"
  />
</ArchwayLayout>

